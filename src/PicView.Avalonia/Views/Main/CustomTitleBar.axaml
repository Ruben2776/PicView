<customControls:MainTitleBar
    x:Class="PicView.Avalonia.Views.Main.CustomTitleBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:keybindings="using:PicView.Core.Keybindings"
    xmlns:uc="clr-namespace:PicView.Avalonia.Views.UC"
    xmlns:vm="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    Height="{Binding TitlebarHeight.Value, Mode=OneWay}"
    x:DataType="vm:MainWindowViewModel"
    IsVisible="{Binding IsTopToolbarShown.Value, Mode=OneWay}">

    <Border
        x:Name="TopWindowBorder"
        Background="{DynamicResource TitleBarBackgroundColor}"
        BorderBrush="{DynamicResource TitleBarBorderColor}"
        BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">

            <Border
                x:Name="LogoBorder"
                Background="{DynamicResource WindowLogoColor}"
                BorderBrush="{DynamicResource WindowBorderColor}"
                BorderThickness="0,0,1,0">
                <Image
                    Width="20"
                    Height="25"
                    Margin="7,1,7,1"
                    Source="{StaticResource LogoImage}" />
            </Border>

            <customControls:StyledMenu
                x:Name="MainMenu"
                Height="{Binding TitlebarHeight.Value, Mode=OneWay}"
                HorizontalAlignment="Left"
                Foreground="{DynamicResource MainTextColor}"
                IsVisible="{Binding TopTitlebarViewModel.IsMainMenuVisible.Value}"
                ZIndex="9">

                <!--  File  -->
                <customControls:StyledMenuItem
                    x:Name="FileMenuItem"
                    Height="{Binding TitlebarHeight.Value, Mode=OneWay}"
                    MaxWidth="{Binding TopTitlebarViewModel.MaxItemWidth.Value}">
                    <MenuItem.Header>
                        <TextBlock Classes="txt" Text="{Binding Translation.File.Value, Mode=OneWay}" />
                    </MenuItem.Header>

                    <!--  Open  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Open}"
                        Header="{CompiledBinding Translation.Open.Value,
                                                 Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image Classes="OpenImage" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Save  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Save}"
                        Header="{CompiledBinding Translation.Save.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="SavePath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Save as  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.SaveAs}"
                        Header="{Binding Translation.SaveAs.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="SavePath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Export to PDF  -->
                    <customControls:StyledMenuItem
                        x:Name="PDFMenuItem"
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.SaveAsPDF}"
                        Header="{Binding Translation.SaveAsPdf.Value}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.Image.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="SavePath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Print  -->
                    <customControls:StyledMenuItem
                        x:Name="PrintMenuItem"
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Print}"
                        Header="{Binding Translation.Print.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.Image.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="PrintPath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Open with  -->
                    <customControls:StyledMenuItem
                        x:Name="OpenWithMenuItem"
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.OpenWith}"
                        Header="{Binding Translation.OpenWith.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource OpenExternalImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Locate on disk  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.OpenInExplorer}"
                        Header="{Binding Translation.ShowInFolder.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="ShowInFolderPath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Close  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.CloseWindow}"
                        Header="{CompiledBinding Translation.Close.Value,
                                                 Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="ClosePath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                </customControls:StyledMenuItem>

                <!--  Edit  -->
                <customControls:StyledMenuItem x:Name="EditMenuItem" MaxWidth="{Binding TopTitlebarViewModel.MaxItemWidth.Value}">
                    <MenuItem.Header>
                        <TextBlock Classes="txt" Text="{Binding Translation.Edit.Value, Mode=OneWay}" />
                    </MenuItem.Header>

                    <!--  Copy image  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.CopyImage}"
                        Header="{Binding Translation.CopyImage.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.Image.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="CopyPath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Copy file  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.CopyFile}"
                        Header="{Binding Translation.CopyFile.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="CopyPath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Copy file path  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.CopyFilePath}"
                        Header="{Binding Translation.FileCopyPath.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="CopyPath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Copy base64  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.CopyBase64}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.Image.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Header>
                            <TextBlock>
                                <Run Text="{Binding Translation.Copy.Value, Mode=OneWay}" />
                                <Run Text=" base64" />
                            </TextBlock>
                        </MenuItem.Header>
                        <MenuItem.Icon>
                            <Path Classes="CopyPath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Duplicate file  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.DuplicateFile}"
                        Header="{Binding Translation.DuplicateFile.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="DuplicatePath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Paste  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Paste}"
                        Header="{Binding Translation.Paste.Value, Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="PastePath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Delete file  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.DeleteFile}"
                        Header="{Binding Translation.DeleteFile.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="RecyclePath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                </customControls:StyledMenuItem>

                <!--  View  -->
                <customControls:StyledMenuItem x:Name="ViewMenuItem" MaxWidth="{Binding TopTitlebarViewModel.MaxItemWidth.Value}">
                    <MenuItem.Header>
                        <TextBlock Classes="txt" Text="{Binding Translation.View.Value, Mode=OneWay}" />
                    </MenuItem.Header>

                    <!--  Change background  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ChangeBackground}"
                        Header="{CompiledBinding Translation.ChangeBackground.Value,
                                                 Mode=OneWay}"
                        StaysOpenOnClick="True"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource PaletteImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Toggle UI  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ToggleInterface}"
                        Header="{Binding Translation.IsShowingUI.Value, Mode=OneWay}"
                        IsVisible="{Binding IsUIShown.Value, Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource EyeOffImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Toggle bottom bar  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ToggleBottomToolbar}"
                        Header="{Binding Translation.ShowBottomToolbar.Value, Mode=OneWay}"
                        IsVisible="{Binding !IsBottomToolbarShown.Value}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource Panel-Bottom}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Toggle side-by-side  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.SideBySide}"
                        Header="{Binding Translation.SideBySide.Value, Mode=OneWay}"
                        IsChecked="{Binding IsSideBySide.Value}"
                        Theme="{StaticResource MainBg}"
                        ToggleType="CheckBox" />

                    <!--  Toggle gallery  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ToggleGallery}"
                        Header="{Binding Translation.ShowImageGallery.Value, Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource GalleryImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Fullscreen  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ToggleFullscreen}"
                        Header="{Binding Translation.Fullscreen.Value, Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="FullscreenPath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Maximize  -->
                    <customControls:StyledMenuItem
                        x:Name="MaximizeMenuItem"
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Maximize}"
                        Header="{Binding Translation.Maximize.Value, Mode=OneWay}"
                        IsVisible="{Binding ShouldMaximizeBeShown.Value, Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image Classes="MaximizeImage" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Restore  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Restore}"
                        Header="{Binding Translation.RestoreDown.Value, Mode=OneWay}"
                        IsVisible="{Binding ShouldRestoreBeShown.Value, Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="RestorePath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                </customControls:StyledMenuItem>

                <!--  Image  -->
                <customControls:StyledMenuItem x:Name="ImageMenuItem" MaxWidth="{Binding TopTitlebarViewModel.MaxItemWidth.Value}">
                    <MenuItem.Header>
                        <TextBlock Classes="txt" Text="{Binding Translation.Image.Value, Mode=OneWay}" />
                    </MenuItem.Header>

                    <!--  Exif window  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ImageInfoWindow}"
                        Header="{CompiledBinding Translation.ImageInfo.Value,
                                                 Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource CameraImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  File properties  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ShowFileProperties}"
                        Header="{Binding Translation.FileProperties.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource FileUserImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Image effects  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.EffectsWindow}"
                        Header="{Binding Translation.Effects.Value, Mode=OneWay}"
                        Theme="{StaticResource MainBg}"
                        ToolTip.Tip="{Binding Translation.EffectsTooltip.Value, Mode=OneWay}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource SparklesImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Single image resize  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ResizeWindow}"
                        Header="{Binding Translation.ResizeImage.Value, Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource UpscaleImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Batch resize  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.BatchResizeWindow}"
                        Header="{Binding Translation.BatchResize.Value, Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource UpscaleImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Optimize image  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.OptimizeImage}"
                        Header="{Binding Translation.OptimizeImage.Value, Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource PortalImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Crop  -->
                    <customControls:StyledMenuItem
                        x:Name="CropMenuItem"
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Crop}"
                        Header="{Binding Translation.Crop.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.Image.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image Classes="CropImage" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Flip  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Flip}"
                        Header="{Binding WindowTabs.ActiveTab.Value.Orientation.FlipLabel.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.Image.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                        StaysOpenOnClick="True"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image Classes="FlipImage">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding WindowTabs.ActiveTab.Value.Orientation.ScaleX.Value}" />
                                </Image.RenderTransform>
                            </Image>
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Rotate left  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.RotateLeft}"
                        Header="{Binding Translation.RotateLeft.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.Image.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                        StaysOpenOnClick="True"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="RotateLeftPath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Rotate right  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.RotateRight}"
                        Header="{Binding Translation.RotateRight.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.Image.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                        StaysOpenOnClick="True"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="RotateRightPath" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>
                </customControls:StyledMenuItem>

                <!--  Navigate  -->
                <customControls:StyledMenuItem x:Name="NavigateMenuItem" MaxWidth="{Binding TopTitlebarViewModel.MaxItemWidth.Value}">
                    <MenuItem.Header>
                        <TextBlock Classes="txt" Text="{Binding Translation.Navigate.Value, Mode=OneWay}" />
                    </MenuItem.Header>

                    <!--  Next  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Next}"
                        Header="{Binding Translation.NextImage, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateForwards.Value}"
                        StaysOpenOnClick="True"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource NextImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Prev  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Prev}"
                        Header="{Binding Translation.PrevImage, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateForwards.Value}"
                        StaysOpenOnClick="True"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource PrevImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>


                    <!--  Next 10  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Next10}"
                        Header="{Binding Translation.AdvanceBy10Images, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateForwards.Value}"
                        StaysOpenOnClick="True"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource NextImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Next 100  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Next100}"
                        Header="{Binding Translation.AdvanceBy100Images, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateForwards.Value}"
                        StaysOpenOnClick="True"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource NextImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Prev 10  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Prev10}"
                        Header="{Binding Translation.GoBackBy10Images.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateBackwards.Value}"
                        StaysOpenOnClick="True"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource PrevImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Prev 100  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Prev100}"
                        Header="{Binding Translation.GoBackBy100Images.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateBackwards.Value}"
                        StaysOpenOnClick="True"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource PrevImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  First Image  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.First}"
                        Header="{Binding Translation.FirstImage.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateBackwards.Value}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource FirstImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Last Image  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Last}"
                        Header="{Binding Translation.LastImage.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateForwards.Value}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource LastImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Next folder  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.NextFolder}"
                        Header="{Binding Translation.NextFolder.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="14"
                                Height="14"
                                Source="{StaticResource NextFolderImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Prev folder  -->
                    <customControls:StyledMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.PrevFolder}"
                        Header="{Binding Translation.PrevFolder.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="14"
                                Height="14"
                                Source="{StaticResource PrevFolderImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Next archive  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.NextArchive}"
                        Header="{CompiledBinding Translation.NextArchive.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="14"
                                Height="14"
                                Source="{StaticResource ArchiveFile}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Prev archive  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.PrevArchive}"
                        Header="{CompiledBinding Translation.PrevArchive.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="14"
                                Height="14"
                                Source="{StaticResource ArchiveFile}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Sort files by  -->
                    <customControls:StyledMenuItem Header="{Binding Translation.SortFilesBy.Value, Mode=OneWay}" Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Path Classes="SortFilesPath" />
                        </MenuItem.Icon>

                        <!--  Sort files by name  -->
                        <customControls:StyledMenuItem
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SortFilesByName}"
                            GroupName="Sort"
                            Header="{Binding Translation.FileName.Value, Mode=OneWay}"
                            IsChecked="{Binding WindowTabs.IsSortedByName.Value}"
                            Theme="{StaticResource MainBg}"
                            ToggleType="Radio" />

                        <!--  Sort files by size  -->
                        <customControls:StyledMenuItem
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SortFilesBySize}"
                            GroupName="Sort"
                            Header="{Binding Translation.FileSize.Value, Mode=OneWay}"
                            IsChecked="{Binding WindowTabs.IsSortedByFileSize.Value}"
                            Theme="{StaticResource MainBg}"
                            ToggleType="Radio" />

                        <!--  Sort files by extension  -->
                        <customControls:StyledMenuItem
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SortFilesByExtension}"
                            GroupName="Sort"
                            Header="{Binding Translation.FileExtension.Value, Mode=OneWay}"
                            IsChecked="{Binding WindowTabs.IsSortedByExtension.Value}"
                            Theme="{StaticResource MainBg}"
                            ToggleType="Radio" />

                        <!--  Sort files by creation time  -->
                        <customControls:StyledMenuItem
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SortFilesByCreationTime}"
                            GroupName="Sort"
                            Header="{Binding Translation.Created.Value, Mode=OneWay}"
                            IsChecked="{Binding WindowTabs.IsSortedByCreationTime.Value}"
                            Theme="{StaticResource MainBg}"
                            ToggleType="Radio" />

                        <!--  Sort files by last access time  -->
                        <customControls:StyledMenuItem
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SortFilesByLastAccessTime}"
                            GroupName="Sort"
                            Header="{Binding Translation.LastAccessTime.Value, Mode=OneWay}"
                            IsChecked="{Binding WindowTabs.IsSortedByLastAccessTime.Value}"
                            Theme="{StaticResource MainBg}"
                            ToggleType="Radio" />

                        <!--  Sort files by last write time  -->
                        <customControls:StyledMenuItem
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SortFilesByLastAccessTime}"
                            GroupName="Sort"
                            Header="{Binding Translation.Modified.Value, Mode=OneWay}"
                            IsChecked="{Binding WindowTabs.IsSortedByLastWriteTime.Value}"
                            Theme="{StaticResource MainBg}"
                            ToggleType="Radio" />

                        <!--  Sort files randomly  -->
                        <customControls:StyledMenuItem
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SortFilesRandomly}"
                            GroupName="Sort"
                            Header="{Binding Translation.Random.Value, Mode=OneWay}"
                            IsChecked="{Binding WindowTabs.IsSortedByRandomization.Value}"
                            Theme="{StaticResource MainBg}"
                            ToggleType="Radio" />

                        <!--  Sort files ascending  -->
                        <MenuItem
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SortFilesAscending}"
                            GroupName="Order"
                            Header="{Binding Translation.Ascending.Value, Mode=OneWay}"
                            IsChecked="{Binding WindowTabs.IsAscending.Value}"
                            Theme="{StaticResource MainBg}"
                            ToggleType="Radio" />

                        <!--  Sort files descending  -->
                        <customControls:StyledMenuItem
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SortFilesDescending}"
                            GroupName="Order"
                            Header="{Binding Translation.Descending.Value, Mode=OneWay}"
                            IsChecked="{Binding !WindowTabs.IsAscending.Value}"
                            Theme="{StaticResource MainBg}"
                            ToggleType="Radio" />

                    </customControls:StyledMenuItem>
                </customControls:StyledMenuItem>

                <!--  Settings  -->
                <customControls:StyledMenuItem x:Name="SettingsMenuItem" MaxWidth="{Binding TopTitlebarViewModel.MaxItemWidth.Value}">
                    <MenuItem.Header>
                        <TextBlock Classes="txt" Text="{Binding Translation.Settings.Value, Mode=OneWay}" />
                    </MenuItem.Header>

                    <!--  Toggle Subdirectories  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ToggleSubdirectories}"
                        Header="{CompiledBinding Translation.SearchSubdirectory.Value,
                                                 Mode=OneWay}"
                        IsChecked="{Binding GlobalSettings.IsIncludingSubdirectories.Value}"
                        Theme="{StaticResource MainBg}"
                        ToggleType="CheckBox" />

                    <!--  Toggle looping  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ToggleLooping}"
                        Header="{CompiledBinding Translation.IsLooping.Value,
                                                 Mode=OneWay}"
                        IsChecked="{Binding GlobalSettings.IsLooping.Value}"
                        Theme="{StaticResource MainBg}"
                        ToggleType="CheckBox" />

                    <!--  Toggle scrolling  -->
                    <customControls:StyledMenuItem
                        Header="{CompiledBinding Translation.IsScrolling.Value,
                                                 Mode=OneWay}"
                        IsChecked="{CompiledBinding IsScrollingEnabled.Value}"
                        Theme="{StaticResource MainBg}"
                        ToggleType="CheckBox" />

                    <!--  Zoom to fit  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ZoomToFit}"
                        Header="{CompiledBinding Translation.ZoomToFit.Value,
                                                 Mode=OneWay}"
                        IsChecked="{CompiledBinding IsZoomedToFit.Value}"
                        Theme="{StaticResource MainBg}"
                        ToggleType="CheckBox" />

                    <!--  Toggle topmost  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.SetTopMost}"
                        Header="{CompiledBinding Translation.StayTopMost.Value,
                                                 Mode=OneWay}"
                        IsChecked="{CompiledBinding IsTopMost.Value}"
                        Theme="{StaticResource MainBg}"
                        ToggleType="CheckBox" />

                    <!--  Toggle auto fit  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.AutoFitWindow}"
                        Header="{CompiledBinding Translation.AutoFitWindow.Value,
                                                 Mode=OneWay}"
                        IsChecked="{CompiledBinding IsAutoFit.Value,
                                                    Mode=OneWay}"
                        Theme="{StaticResource MainBg}"
                        ToggleType="CheckBox" />

                    <!--  Show Settings window  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.SettingsWindow}"
                        Header="{CompiledBinding Translation.ShowAllSettingsWindow.Value,
                                                 Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image Classes="CogImage" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>
                </customControls:StyledMenuItem>

                <!--  Help  -->
                <customControls:StyledMenuItem x:Name="HelpMenuItem" MaxWidth="{Binding TopTitlebarViewModel.MaxItemWidth.Value}">
                    <MenuItem.Header>
                        <TextBlock Classes="txt" Text="{Binding Translation.Help.Value, Mode=OneWay}" />
                    </MenuItem.Header>

                    <!--  Show about window  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.AboutWindow}"
                        Header="{CompiledBinding Translation.About.Value,
                                                 Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource AboutImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>

                    <!--  Check for updates  -->
                    <customControls:StyledMenuItem
                        Command="{CompiledBinding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.CheckForUpdates}"
                        Header="{CompiledBinding Translation.CheckForUpdates.Value,
                                                 Mode=OneWay}"
                        Theme="{StaticResource MainBg}">
                        <MenuItem.Icon>
                            <Image
                                Width="12"
                                Height="12"
                                Source="{StaticResource DownloadImage}" />
                        </MenuItem.Icon>
                    </customControls:StyledMenuItem>
                </customControls:StyledMenuItem>
            </customControls:StyledMenu>

            <customControls:IconButton
                x:Name="MenuButton"
                Width="30"
                Margin="0"
                Background="{DynamicResource TitleBarButtonBackground}"
                BorderBrush="{DynamicResource TitleBarButtonBorder}"
                BorderThickness="0,0,1,0"
                Classes="AltHover"
                Command="{CompiledBinding TopTitlebarViewModel.OpenMenuCommand}"
                Foreground="{DynamicResource TitleBarForeground}"
                Icon="{StaticResource MenuImage}"
                IconHeight="16"
                IconWidth="16"
                IsRepeatEnabled="False"
                IsVisible="{Binding TopTitlebarViewModel.IsMenuButtonVisible.Value}" />

            <customControls:IconButton
                x:Name="SearchButton"
                Width="30"
                Margin="2,3,7,3"
                Background="Transparent"
                Classes="AltHover"
                Command="{Binding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.Search}"
                CornerRadius="6"
                DockPanel.Dock="Left"
                Foreground="{DynamicResource TitleBarForeground}"
                Icon="{StaticResource SearchImage}"
                IconHeight="15"
                IconWidth="15"
                IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                IsTabStop="False"
                IsVisible="{Binding TopTitlebarViewModel.IsMenuButtonVisible.Value}" />

            <StackPanel
                x:Name="WinBtnPanel"
                DockPanel.Dock="Right"
                IsVisible="{CompiledBinding TopTitlebarViewModel.IsBtnPanelVisible.Value}"
                Orientation="Horizontal">

                <customControls:IconButton
                    x:Name="MinimizeButton"
                    Width="30"
                    Margin="0,0"
                    Background="{DynamicResource TitleBarButtonBackground}"
                    BorderBrush="{DynamicResource TitleBarButtonBorder}"
                    BorderThickness="1,0,0,0"
                    Classes="hover "
                    ClickMode="Release"
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.Minimize}"
                    Data="{StaticResource MinimizeGeometry}"
                    Foreground="{DynamicResource TitleBarForeground}"
                    IconHeight="2"
                    IconWidth="12"
                    IsRepeatEnabled="False" />

                <customControls:IconButton
                    x:Name="FullscreenButton"
                    Width="30"
                    Background="{DynamicResource TitleBarButtonBackground}"
                    BorderBrush="{DynamicResource TitleBarButtonBorder}"
                    BorderThickness="1,0,1,0"
                    Classes="hover"
                    ClickMode="Release"
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ToggleFullscreen}"
                    Data="{StaticResource FullscreenGeometry}"
                    Foreground="{DynamicResource TitleBarForeground}"
                    IconHeight="12"
                    IconWidth="12"
                    IsRepeatEnabled="False"
                    IsVisible="{CompiledBinding ShouldMaximizeBeShown.Value,
                                                Mode=OneWay}" />

                <customControls:IconButton
                    x:Name="RestoreButton"
                    Width="30"
                    Background="{DynamicResource TitleBarButtonBackground}"
                    Classes="hover"
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.Restore}"
                    Data="{StaticResource RestoreGeometry}"
                    Foreground="{DynamicResource TitleBarForeground}"
                    IconHeight="12"
                    IconWidth="12"
                    IsRepeatEnabled="False"
                    IsVisible="{CompiledBinding !ShouldMaximizeBeShown.Value,
                                                Mode=OneWay}" />

                <customControls:IconButton
                    x:Name="CloseButton"
                    Width="30"
                    Background="{DynamicResource TitleBarButtonBackground}"
                    Classes="hover"
                    ClickMode="Release"
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.CloseWindow}"
                    Data="{StaticResource CloseGeometry}"
                    Foreground="{DynamicResource TitleBarForeground}"
                    IconHeight="10"
                    IconWidth="10"
                    IsRepeatEnabled="False"
                    WindowDecorationProperties.ElementRole="CloseButton" />

            </StackPanel>

            <customControls:IconButton
                x:Name="DropDownMenuButton"
                Width="30"
                Margin="2,3,7,3"
                Background="Transparent"
                BorderBrush="{DynamicResource TitleBarBorderColor}"
                Classes="AltHover"
                Command="{CompiledBinding TopTitlebarViewModel.ToggleDropDownMenuCommand}"
                CommandParameter="{CompiledBinding}"
                CornerRadius="6"
                DockPanel.Dock="Right"
                Foreground="{DynamicResource TitleBarForeground}"
                Icon="{StaticResource ChevronDownImage}"
                IconHeight="13"
                IconWidth="13"
                IsTabStop="False"
                IsVisible="{Binding TopTitlebarViewModel.IsMenuButtonVisible.Value}" />

            <customControls:IconButton
                x:Name="CreateTabButton"
                Width="30"
                Margin="0,3,2,3"
                Background="Transparent"
                BorderBrush="{DynamicResource TitleBarBorderColor}"
                Classes="AltHover"
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.NewTab}"
                CornerRadius="6"
                DockPanel.Dock="Right"
                Foreground="{DynamicResource TitleBarForeground}"
                Icon="{StaticResource PlusImage}"
                IconHeight="13"
                IconWidth="13"
                IsTabStop="False"
                IsVisible="{Binding !WindowTabs.ActiveTab.Value.Gallery.IsGalleryDocked.Value}" />

            <uc:EditableTitlebar
                x:Name="EditableTitlebar"
                Background="{DynamicResource EditableTitlebarBackground}"
                Foreground="{DynamicResource EditableTitlebarForeground}"
                IsVisible="{Binding TopTitlebarViewModel.IsEditableTitlebarVisible.Value}" />

        </DockPanel>
    </Border>
</customControls:MainTitleBar>
