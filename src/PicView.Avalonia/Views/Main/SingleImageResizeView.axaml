<UserControl
    x:Class="PicView.Avalonia.Views.Main.SingleImageResizeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:uc="clr-namespace:PicView.Avalonia.Views.UC"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    x:DataType="viewModels:MainWindowViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CancelBrush" Color="{DynamicResource MainTextColor}" />
        <SolidColorBrush x:Key="LinkBrush" Color="{StaticResource SecondaryTextColor}" />
    </UserControl.Resources>
    <Panel x:Name="BgPanel" Background="{DynamicResource TertiaryBackgroundColor}">
        <uc:SpinWaiter x:Name="SpinWaiter" IsVisible="False" />

        <StackPanel x:Name="ParentContainer">
            <Border x:Name="MainBorder">
                <StackPanel Margin="30">

                    <StackPanel Margin="0,5,0,30" Orientation="Horizontal">
                        <StackPanel>
                            <TextBlock
                                Margin="4,0,0,5"
                                Classes="txt bold"
                                Foreground="{StaticResource SecondaryTextColor}"
                                Text="{Binding Translation.Width.Value, Mode=OneWay}" />
                            <customControls:NumTextBox
                                x:Name="PixelWidthTextBox"
                                Width="195"
                                Height="35"
                                Margin="0"
                                Background="{DynamicResource SecondaryBackgroundColor}"
                                Classes="hover TStyle"
                                CornerRadius="4"
                                Foreground="{DynamicResource MainTextColor}"
                                Text="{Binding ResizeImageViewModel.DesiredPixelWidth.Value, Mode=TwoWay}"
                                ToolTip.Tip="{CompiledBinding Translation.SizeTooltip.Value,
                                                              Mode=OneWay}" />
                        </StackPanel>

                        <customControls:IconButton
                            x:Name="LinkChainButton"
                            Width="38"
                            Height="35"
                            Margin="5,20,5,0"
                            Background="Transparent"
                            Classes="altHover"
                            CornerRadius="6"
                            Foreground="{StaticResource LinkBrush}"
                            Icon="{StaticResource LinkChainImage}"
                            IconHeight="21"
                            IconWidth="21" />


                        <StackPanel>
                            <TextBlock
                                Margin="4,0,0,5"
                                Classes="txt bold"
                                Foreground="{StaticResource SecondaryTextColor}"
                                Text="{Binding Translation.Height.Value, Mode=OneWay}" />
                            <customControls:NumTextBox
                                x:Name="PixelHeightTextBox"
                                Width="195"
                                Height="35"
                                Margin="0"
                                Background="{DynamicResource SecondaryBackgroundColor}"
                                Classes="hover TStyle"
                                CornerRadius="4"
                                Foreground="{DynamicResource MainTextColor}"
                                Text="{Binding ResizeImageViewModel.DesiredPixelHeight.Value, Mode=TwoWay}"
                                ToolTip.Tip="{CompiledBinding Translation.SizeTooltip,
                                                              Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <TextBlock
                                Margin="5,0,0,2"
                                Classes="txt bold"
                                Foreground="{StaticResource SecondaryTextColor}"
                                Text="{Binding Translation.Quality.Value, Mode=OneWay}" />
                            <customControls:CustomSlider
                                x:Name="QualitySlider"
                                Width="190"
                                Margin="5,0,0,2"
                                IsEnabled="{Binding ResizeImageViewModel.IsQualityEnabled.Value}"
                                IsSnapToTickEnabled="True"
                                Maximum="100"
                                Minimum="1"
                                TickFrequency="1"
                                Value="{Binding ResizeImageViewModel.Quality.Value, Mode=TwoWay}" />
                            <TextBlock
                                Margin="8,0,0,3"
                                Classes="txt"
                                Foreground="{StaticResource SecondaryTextColor}"
                                Text="{Binding Path=Value, ElementName=QualitySlider}" />
                        </StackPanel>
                        <StackPanel Margin="48,0,0,0">
                            <TextBlock
                                Margin="5,0,0,5"
                                Classes="txt"
                                FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                                FontSize="14"
                                Foreground="{StaticResource SecondaryTextColor}"
                                Text="{Binding Translation.ConvertTo.Value, Mode=OneWay}" />
                            <ComboBox
                                x:Name="ConversionComboBox"
                                Width="195"
                                Height="30"
                                Margin="0"
                                Padding="5,7,0,7"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource SecondaryBackgroundColor}"
                                BorderBrush="{DynamicResource MainBorderColor}"
                                BorderThickness="1"
                                CornerRadius="4"
                                FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                                Foreground="{DynamicResource MainTextColor}"
                                SelectedIndex="{Binding ResizeImageViewModel.SelectedConversionIndex.Value, Mode=TwoWay}">
                                <ComboBoxItem x:Name="NoConversion" Content="{CompiledBinding Translation.NoConversion.Value, Mode=OneWay}" />
                                <ComboBoxItem x:Name="PngItem" Content=".png" />
                                <ComboBoxItem x:Name="JpgItem" Content=".jpg" />
                                <ComboBoxItem x:Name="WebpItem" Content=".webp" />
                                <ComboBoxItem x:Name="AvifItem" Content=".avif" />
                                <ComboBoxItem x:Name="HeicItem" Content=".heic" />
                                <ComboBoxItem x:Name="JxlItem" Content=".jxl" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="5,10,0,0" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Original size:" />
                            <TextBlock x:Name="CurrentSizeTxt" Classes="txt">
                                <Run Text="{Binding ResizeImageViewModel.OriginalPixelWidth.Value}" />
                                <Run Text=" x " />
                                <Run Text="{Binding ResizeImageViewModel.OriginalPixelHeight.Value}" />
                            </TextBlock>
                            <TextBlock Text="{Binding ResizeImageViewModel.OriginalFileSize.Value}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Output size:" />
                            <TextBlock x:Name="DesiredSizeTxt" Classes="txt">
                                <Run Text="{Binding ResizeImageViewModel.DesiredPixelWidth.Value}" />
                                <Run Text=" x " />
                                <Run Text="{Binding ResizeImageViewModel.DesiredPixelHeight.Value}" />
                            </TextBlock>
                            <TextBlock Text="{Binding ResizeImageViewModel.OutputFileSize.Value}" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Border>

            <StackPanel
                x:Name="BottomBorder"
                Height="80"
                Background="#46252525"
                Orientation="Horizontal">
                <Button
                    x:Name="ResetButton"
                    Width="195"
                    Margin="30,0,60,0"
                    Classes="BorderStyle altHover mainBtn"
                    CornerRadius="4"
                    IsVisible="{Binding ResizeImageViewModel.ShowReset.Value}">
                    <TextBlock
                        Classes="txt"
                        Text="{Binding Translation.Reset.Value, Mode=OneWay}"
                        TextAlignment="Center" />
                </Button>

                <Button
                    x:Name="CancelButton"
                    Width="195"
                    Margin="30,0,60,0"
                    Classes="BorderStyle altHover mainBtn"
                    CornerRadius="4"
                    IsVisible="{Binding !ResizeImageViewModel.ShowReset.Value}">
                    <TextBlock
                        Classes="txt"
                        Foreground="{StaticResource CancelBrush}"
                        Text="{Binding Translation.Cancel.Value, Mode=OneWay}"
                        TextAlignment="Center" />
                </Button>

                <SplitButton
                    x:Name="SaveButton"
                    Width="195"
                    Padding="8"
                    Background="{DynamicResource AccentColor}"
                    Classes="BorderStyle accentHover mainBtn"
                    CornerRadius="4">
                    <TextBlock
                        Classes="txt"
                        Foreground="{StaticResource SecondaryTextColor}"
                        Text="{Binding Translation.Save.Value, Mode=OneWay}"
                        TextAlignment="Center" />
                    <SplitButton.Flyout>
                        <MenuFlyout FlyoutPresenterClasses="noCornerRadius" Placement="Bottom">
                            <MenuItem
                                x:Name="SaveAsButton"
                                Width="195"
                                Padding="0,6,24,6"
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                Header="{CompiledBinding Translation.SaveAs.Value,
                                                         Mode=OneWay}" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>

            </StackPanel>
        </StackPanel>
    </Panel>
</UserControl>
