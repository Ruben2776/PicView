<UserControl
    Background="Transparent"
    Foreground="{StaticResource SecondaryTextColor}"
    x:Class="PicView.Avalonia.Views.Main.ImageInfoView"
    x:DataType="coreVm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:coreVm="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:keybindings="using:PicView.Core.Keybindings"
    xmlns:uc="clr-namespace:PicView.Avalonia.Views.UC"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Styles>
            <Style Selector="TextBox.x, ComboBox.x">
                <Setter Property="Foreground" Value="{DynamicResource MainTextColor}" />
                <Setter Property="MaxHeight" Value="34" />
            </Style>
            <Style Selector="TextBox.x">
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <!--  A dropdown's list is no wider than its box, so it stays inside the window: long words wrap  -->
            <Style Selector="ComboBox.x /template/ Popup#PART_Popup">
                <Setter Property="MaxWidth" Value="{CompiledBinding $parent[ComboBox].Bounds.Width}" />
            </Style>
            <Style Selector="ComboBox.x ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!--  A tag that describes the image, such as Compression, shows the file's value and cannot be picked  -->
            <Style Selector="ComboBox.ReadOnly ComboBoxItem">
                <Setter Property="Cursor" Value="No" />
            </Style>
        </Styles>
    </UserControl.Styles>
    <UserControl.ContextMenu>
        <ContextMenu x:Name="MainContextMenu">

            <!--  Save  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.Save}"
                Header="{CompiledBinding Translation.Save.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}">
                <MenuItem.Icon>
                    <Path Classes="SavePath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Save as  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.SaveAs}"
                Header="{CompiledBinding Translation.SaveAs.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}">
                <MenuItem.Icon>
                    <Path Classes="SavePath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>


            <!--  Print  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.Print}"
                Header="{CompiledBinding Translation.Print.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}"
                x:Name="PrintMenuItem">
                <MenuItem.Icon>
                    <Path Classes="PrintPath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Open with  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.OpenWith}"
                Header="{CompiledBinding Translation.OpenWith.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}"
                x:Name="OpenWithMenuItem">
                <MenuItem.Icon>
                    <Image Classes="OpenWithImage" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Locate on disk  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.OpenInExplorer}"
                Header="{CompiledBinding Translation.ShowInFolder.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}">
                <MenuItem.Icon>
                    <Path Classes="ShowInFolderPath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Remove image data  -->
            <customControls:StyledMenuItem
                Command="{Binding Exif.RemoveImageMetaDataCommand}"
                CommandParameter="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value}"
                Header="{CompiledBinding Translation.RemoveImageData.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}"
                x:Name="RemoveImageDataMenuItem">
                <MenuItem.Icon>
                    <Image
                        Height="12"
                        Source="{StaticResource OffImage}"
                        Width="12" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Set as wallpaper  -->
            <customControls:StyledMenuItem
                Header="{CompiledBinding Translation.SetAsWallpaper.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}"
                IsVisible="{CompiledBinding GlobalSettings.ShowSetAsWallpaper.Value}"
                x:Name="WallpaperMenuItem">
                <MenuItem.Icon>
                    <Image Classes="WallpaperImage" />
                </MenuItem.Icon>

                <!--  Set as wallpaper filled  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetAsWallpaperFilled}"
                    Header="{CompiledBinding Translation.Fill.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}"
                    IsVisible="{CompiledBinding GlobalSettings.ShowSetAsWallpaper.Value}">
                    <MenuItem.Icon>
                        <Image Classes="WallpaperImage" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Set as wallpaper fit  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetAsWallpaperFitted}"
                    Header="{CompiledBinding Translation.Fit.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}"
                    IsVisible="{CompiledBinding GlobalSettings.ShowSetAsWallpaper.Value}">
                    <MenuItem.Icon>
                        <Image Classes="WallpaperImage" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Set as wallpaper stretched  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetAsWallpaperStretched}"
                    Header="{CompiledBinding Translation.Stretch.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}"
                    IsVisible="{CompiledBinding GlobalSettings.ShowSetAsWallpaper.Value}">
                    <MenuItem.Icon>
                        <Image Classes="WallpaperImage" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>


                <!--  Set as wallpaper centered  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetAsWallpaperCentered}"
                    Header="{CompiledBinding Translation.Center.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}"
                    IsVisible="{CompiledBinding GlobalSettings.ShowSetAsWallpaper.Value}">
                    <MenuItem.Icon>
                        <Image Classes="WallpaperImage" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Set as wallpaper tiled  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetAsWallpaperTiled}"
                    Header="{CompiledBinding Translation.Tile.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}"
                    IsVisible="{CompiledBinding GlobalSettings.ShowSetAsWallpaper.Value}">
                    <MenuItem.Icon>
                        <Image Classes="WallpaperImage" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>
            </customControls:StyledMenuItem>

            <!--  File properties  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.ShowFileProperties}"
                Header="{CompiledBinding Translation.FileProperties.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}">
                <MenuItem.Icon>
                    <Image
                        Height="12"
                        Source="{StaticResource FileUserImage}"
                        Stretch="Fill"
                        Width="12" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Optimize image  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.OptimizeImage}"
                Header="{CompiledBinding Translation.OptimizeImage.Value,
                                         Mode=OneWay}"
                IsEnabled="True">
                <MenuItem.Icon>
                    <Image
                        Height="12"
                        Source="{StaticResource PortalImage}"
                        Width="12" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Convert image  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.ConvertWindow}"
                Header="{CompiledBinding Translation.ConvertTo.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}">
                <MenuItem.Icon>
                    <Image
                        Height="12"
                        Source="{StaticResource FileImage}"
                        Stretch="Fill"
                        Width="12" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <Separator />

            <!--  Delete file  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.DeleteFile}"
                Header="{CompiledBinding Translation.DeleteFile.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}">
                <MenuItem.Icon>
                    <Path Classes="RecyclePath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <Separator />

            <!--  Copy  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.CopyFile}"
                Header="{CompiledBinding Translation.Copy.Value,
                                         Mode=OneWay}">
                <MenuItem.Icon>
                    <Path Classes="CopyPath Xl" />
                </MenuItem.Icon>

                <!--  Copy file  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.CopyFile}"
                    Header="{CompiledBinding Translation.CopyFile.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}">
                    <MenuItem.Icon>
                        <Path Classes="CopyPath Xl" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Copy image  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.CopyImage}"
                    Header="{CompiledBinding Translation.CopyImage.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}">
                    <MenuItem.Icon>
                        <Path Classes="CopyPath Xl" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Copy file path  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.CopyFilePath}"
                    Header="{Binding Translation.FileCopyPath.Value, Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}">
                    <MenuItem.Icon>
                        <Path Classes="CopyPath Xl" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Copy base64  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.CopyBase64}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}">
                    <MenuItem.Header>
                        <TextBlock>
                            <Run Text="{CompiledBinding Translation.Copy.Value, Mode=OneWay}" />
                            <Run Text=" base64" />
                        </TextBlock>
                    </MenuItem.Header>
                    <MenuItem.Icon>
                        <Path Classes="CopyPath Xl" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <Separator />

                <!--  Duplicate file  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.DuplicateFile}"
                    Header="{CompiledBinding Translation.DuplicateFile.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}">
                    <MenuItem.Icon>
                        <Path Classes="DuplicatePath" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

            </customControls:StyledMenuItem>

            <Separator />

            <!--  Close  -->
            <customControls:StyledMenuItem Header="{CompiledBinding Translation.Close.Value, Mode=OneWay}" x:Name="CloseItem">
                <MenuItem.Icon>
                    <Path Classes="ClosePath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

        </ContextMenu>
    </UserControl.ContextMenu>

    <Panel>
        <uc:SpinWaiter
            HorizontalAlignment="Center"
            IsVisible="False"
            VerticalAlignment="Center"
            x:Name="SpinWaiter" />
        <customControls:AutoScrollViewer
            Background="Transparent"
            Focusable="True"
            VerticalScrollBarVisibility="Visible"
            x:Name="ScrollViewer">

            <Panel Margin="5" x:Name="ParentPanel">

                <StackPanel x:Name="MainContainer">

                    <WrapPanel ItemsAlignment="Center">

                        <!--  File name  -->
                        <StackPanel Margin="15,10" Orientation="Horizontal">
                            <TextBlock
                                Classes="txt"
                                Margin="0,8,0,0"
                                Text="{CompiledBinding Translation.FileName.Value,
                                                       Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextWidth,
                                                        FallbackValue=0}" />
                            <customControls:FuncTextBox
                                Classes="TStyle x"
                                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                            Converter={x:Static ObjectConverters.IsNotNull},
                                                            FallbackValue=False}"
                                Text="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value.Name}"
                                Width="{CompiledBinding InfoWindow.TextBoxXlWidth.Value,
                                                        FallbackValue=0}"
                                x:Name="FileNameTextBox" />
                            <customControls:CopyButton
                                Classes="ToolButtonHover ToolWindowBorderStyle"
                                CopyText="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value}"
                                IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value,
                                                            FallbackValue=True}"
                                ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                              Mode=OneWay}">
                                <Path Classes="CopyPath Xl" />
                            </customControls:CopyButton>
                        </StackPanel>

                        <!--  Folder path  -->
                        <StackPanel Margin="15,10" Orientation="Horizontal">
                            <TextBlock
                                Classes="txt"
                                Margin="0,8,0,0"
                                Text="{CompiledBinding Translation.Folder.Value,
                                                       Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextWidth,
                                                        FallbackValue=0}" />
                            <customControls:FuncTextBox
                                Classes="TStyle x"
                                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                            Converter={x:Static ObjectConverters.IsNotNull},
                                                            FallbackValue=False}"
                                Text="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value.DirectoryName,
                                                       FallbackValue=''}"
                                Width="{CompiledBinding InfoWindow.TextBoxXlWidth.Value,
                                                        FallbackValue=0}"
                                x:Name="DirectoryNameTextBox" />
                            <customControls:CopyButton
                                Classes="ToolButtonHover ToolWindowBorderStyle"
                                CopyText="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value.DirectoryName,
                                                           FallbackValue=''}"
                                IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value,
                                                            FallbackValue=False}"
                                ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                              Mode=OneWay}">
                                <Path Classes="CopyPath Xl" />
                            </customControls:CopyButton>
                        </StackPanel>

                        <!--  Full path  -->
                        <StackPanel Margin="15,10" Orientation="Horizontal">
                            <TextBlock
                                Classes="txt"
                                Margin="0,8,0,0"
                                Text="{CompiledBinding Translation.FullPath.Value,
                                                       Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextWidth,
                                                        FallbackValue='0'}" />
                            <customControls:FuncTextBox
                                Classes="TStyle x"
                                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                            Converter={x:Static ObjectConverters.IsNotNull},
                                                            FallbackValue=False}"
                                Text="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value.FullName,
                                                       FallbackValue=''}"
                                Width="{CompiledBinding InfoWindow.TextBoxXlWidth.Value}"
                                x:Name="FullPathTextBox" />
                            <customControls:CopyButton
                                Classes="ToolButtonHover ToolWindowBorderStyle"
                                CopyText="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value.FullName,
                                                           FallbackValue=''}"
                                IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                              Mode=OneWay}">
                                <Path Classes="CopyPath Xl" />
                            </customControls:CopyButton>
                        </StackPanel>

                        <!--  Width  -->
                        <StackPanel Margin="15,10" Orientation="Horizontal">
                            <TextBlock
                                Classes="txt"
                                Margin="0,8,0,0"
                                Text="{CompiledBinding Translation.Width.Value,
                                                       Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextWidth}" />
                            <customControls:NumTextBox
                                Classes="TStyle x"
                                Text="{CompiledBinding Exif.PixelWidth.Value,
                                                       Mode=OneWay}"
                                ToolTip.Tip="{CompiledBinding Translation.SizeTooltip.Value,
                                                              Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextBoxWidth.Value}"
                                x:Name="PixelWidthTextBox" />
                            <customControls:CopyButton
                                Classes="ToolButtonHover ToolWindowBorderStyle"
                                CopyText="{CompiledBinding Exif.PixelWidth.Value,
                                                           Mode=OneWay}"
                                IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                              Mode=OneWay}">
                                <Path Classes="CopyPath Xl" />
                            </customControls:CopyButton>
                        </StackPanel>

                        <!--  Height  -->
                        <StackPanel Margin="15,10" Orientation="Horizontal">
                            <TextBlock
                                Classes="txt"
                                Margin="0,8,0,0"
                                Text="{CompiledBinding Translation.Height.Value,
                                                       Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextWidth}" />
                            <customControls:NumTextBox
                                Classes="TStyle x"
                                Text="{CompiledBinding Exif.PixelHeight.Value,
                                                       Mode=OneWay}"
                                ToolTip.Tip="{CompiledBinding Translation.SizeTooltip.Value,
                                                              Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextBoxWidth.Value}"
                                x:Name="PixelHeightTextBox" />
                            <customControls:CopyButton
                                Classes="ToolButtonHover ToolWindowBorderStyle"
                                CopyText="{CompiledBinding Exif.PixelHeight.Value,
                                                           Mode=OneWay}"
                                IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                              Mode=OneWay}">
                                <Path Classes="CopyPath Xl" />
                            </customControls:CopyButton>
                        </StackPanel>

                        <!--  Size Mp  -->
                        <StackPanel Margin="15,10" Orientation="Horizontal">
                            <TextBlock
                                Classes="txt"
                                Margin="0,8,0,0"
                                Text="{CompiledBinding Translation.SizeMp.Value,
                                                       Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextWidth,
                                                        FallbackValue=''}" />
                            <customControls:FuncTextBox
                                Classes=" TStyle x"
                                IsReadOnly="True"
                                Text="{CompiledBinding Exif.SizeMp.Value,
                                                       Mode=OneWay,
                                                       FallbackValue=''}"
                                Width="{CompiledBinding InfoWindow.TextBoxWidth.Value}"
                                x:Name="SizeMpTextBox" />
                            <customControls:CopyButton
                                Classes="ToolButtonHover ToolWindowBorderStyle"
                                CopyText="{CompiledBinding Exif.SizeMp.Value,
                                                           Mode=OneWay}"
                                IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                              Mode=OneWay}">
                                <Path Classes="CopyPath Xl" />
                            </customControls:CopyButton>
                        </StackPanel>

                        <!--  Resolution  -->
                        <StackPanel Margin="15,10" Orientation="Horizontal">
                            <TextBlock
                                Classes="txt"
                                Margin="0,8,0,0"
                                Text="{CompiledBinding Translation.Resolution.Value,
                                                       Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextWidth}"
                                x:Name="ResolutionTextBlock" />
                            <customControls:FuncTextBox
                                Classes=" TStyle x"
                                IsReadOnly="True"
                                Text="{CompiledBinding Exif.Resolution.Value,
                                                       Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextBoxWidth.Value}" />
                            <customControls:CopyButton
                                Classes="ToolButtonHover ToolWindowBorderStyle"
                                CopyText="{CompiledBinding Exif.Resolution.Value,
                                                           Mode=OneWay}"
                                IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                              Mode=OneWay}">
                                <Path Classes="CopyPath Xl" />
                            </customControls:CopyButton>
                        </StackPanel>

                        <!--  Print Size Centimeters  -->
                        <StackPanel Margin="15,10" Orientation="Horizontal">
                            <TextBlock
                                Classes="txt"
                                Margin="0,8,0,0"
                                Text="{CompiledBinding Translation.PrintSizeCm.Value,
                                                       Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextWidth}" />
                            <customControls:FuncTextBox
                                Classes=" TStyle x"
                                IsReadOnly="True"
                                Text="{CompiledBinding Exif.PrintSizeCm.Value,
                                                       Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextBoxWidth.Value}"
                                x:Name="PrintSizeCmTextBox" />
                            <customControls:CopyButton
                                Classes="ToolButtonHover ToolWindowBorderStyle"
                                CopyText="{CompiledBinding Exif.PrintSizeCm.Value,
                                                           Mode=OneWay}"
                                IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                              Mode=OneWay}">
                                <Path Classes="CopyPath Xl" />
                            </customControls:CopyButton>
                        </StackPanel>

                        <!--  Print Size Inches  -->
                        <StackPanel Margin="15,10" Orientation="Horizontal">
                            <TextBlock
                                Classes="txt"
                                Margin="0,8,0,0"
                                Text="{CompiledBinding Translation.PrintSizeIn.Value,
                                                       Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextWidth}" />
                            <customControls:FuncTextBox
                                Classes=" TStyle x"
                                IsReadOnly="True"
                                Text="{CompiledBinding Exif.PrintSizeInch.Value,
                                                       Mode=OneWay,
                                                       FallbackValue=''}"
                                Width="{CompiledBinding InfoWindow.TextBoxWidth.Value,
                                                        FallbackValue=0}"
                                x:Name="PrintSizeInchTextBox" />
                            <customControls:CopyButton
                                Classes="ToolButtonHover ToolWindowBorderStyle"
                                CopyText="{CompiledBinding Exif.PrintSizeInch.Value,
                                                           Mode=OneWay,
                                                           FallbackValue=''}"
                                IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value,
                                                            FallbackValue=False}"
                                ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                              Mode=OneWay}">
                                <Path Classes="CopyPath Xl" />
                            </customControls:CopyButton>
                        </StackPanel>

                        <!--  Aspect Ratio  -->
                        <StackPanel Margin="15,10" Orientation="Horizontal">
                            <TextBlock
                                Classes="txt"
                                Margin="0,8,0,0"
                                Text="{CompiledBinding Translation.ReadAbleAspectRatio.Value,
                                                       Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextWidth,
                                                        FallbackValue=0}" />
                            <customControls:FuncTextBox
                                Classes=" TStyle x"
                                IsReadOnly="True"
                                Text="{CompiledBinding Exif.AspectRatio.Value,
                                                       Mode=OneWay,
                                                       FallbackValue=''}"
                                Width="{CompiledBinding InfoWindow.TextBoxWidth.Value,
                                                        FallbackValue=0}"
                                x:Name="AspectRatioTextBox" />
                            <customControls:CopyButton
                                Classes="ToolButtonHover ToolWindowBorderStyle"
                                CopyText="{CompiledBinding Exif.AspectRatio.Value,
                                                           Mode=OneWay,
                                                           FallbackValue=''}"
                                IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value,
                                                            FallbackValue=False}"
