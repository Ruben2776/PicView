                                                            Converter={x:Static ObjectConverters.IsNotNull}}"
                                IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                              Mode=OneWay}">
                                <Path Classes="CopyPath Xl" />
                            </customControls:CopyButton>
                        </StackPanel>

                        <!--  Created  -->
                        <StackPanel Margin="15,10" Orientation="Horizontal">
                            <TextBlock
                                Classes="txt"
                                Margin="0,8,0,0"
                                Text="{CompiledBinding Translation.Created.Value,
                                                       Mode=OneWay}"
                                Width="{CompiledBinding InfoWindow.TextWidth,
                                                        FallbackValue=0}" />
                            <customControls:DateTimePickerButtons
                                Background="{DynamicResource ToolWindowButtonBackground}"
                                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                            Converter={x:Static ObjectConverters.IsNotNull}}"
                                Margin="5,0,0,0"
                                SelectedDateTime="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value.CreationTime,
                                                                   Mode=TwoWay,
                                                                   FallbackValue=''}"
                                Width="{CompiledBinding InfoWindow.TextBoxWidth.Value}"
                                x:Name="CreationTimeBox" />

                            <customControls:CopyButton
                                Classes="ToolButtonHover ToolWindowBorderStyle"
                                CopyText="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value.CreationTime,
                                                           FallbackValue=''}"
