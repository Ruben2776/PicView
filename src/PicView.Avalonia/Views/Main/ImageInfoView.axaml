                                                               Mode=OneWay}"
                                    IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                    ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                                  Mode=OneWay}">
                                    <Path Classes="CopyPath Xl" />
                                </customControls:CopyButton>
                            </StackPanel>

                            <!--  Title  -->
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Classes="txt"
                                    Margin="0,8,2,0"
                                    Text="{CompiledBinding Translation.Title.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextWidth}" />
                                <customControls:FuncTextBox
                                    Classes=" TStyle x"
                                    Command="{CompiledBinding Exif.SetTitleCommand}"
                                    CommandParameter="{Binding $self.Text}"
                                    MaxHeight="84"
                                    Text="{CompiledBinding Exif.Title.Value,
                                                           Mode=TwoWay}"
                                    Width="{CompiledBinding InfoWindow.TextBoxXxlWidth.Value}"
                                    x:Name="TitleBox" />
                                <customControls:CopyButton
                                    Classes="ToolButtonHover ToolWindowBorderStyle"
                                    CopyText="{CompiledBinding Exif.Title.Value,
                                                               Mode=OneWay}"
                                    IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                    ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                                  Mode=OneWay}">
                                    <Path Classes="CopyPath Xl" />
                                </customControls:CopyButton>
                            </StackPanel>

                            <!--  Comment  -->
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Classes="txt"
                                    Margin="0,8,2,0"
                                    Text="{CompiledBinding Exif.CommentLabel.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextWidth}" />
                                <customControls:FuncTextBox
                                    Classes=" TStyle x"
                                    Command="{CompiledBinding Exif.SetCommentCommand}"
                                    CommandParameter="{Binding $self.Text}"
                                    MaxHeight="600"
                                    Text="{CompiledBinding Exif.Comment.Value,
                                                           Mode=TwoWay}"
                                    Width="{CompiledBinding InfoWindow.TextBoxXxlWidth.Value}"
                                    x:Name="CommentBox" />
                                <customControls:CopyButton
                                    Classes="ToolButtonHover ToolWindowBorderStyle"
                                    CopyText="{CompiledBinding Exif.Comment.Value,
                                                               Mode=OneWay}"
                                    IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                    ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                                  Mode=OneWay}">
                                    <Path Classes="CopyPath Xl" />
                                </customControls:CopyButton>
                            </StackPanel>
                        </WrapPanel>

                    </StackPanel>

                    <!--  Gps  -->
                    <StackPanel IsEnabled="{CompiledBinding Exif.IsExifAvailable.Value}">
                        <StackPanel
                            Height="20"
                            HorizontalAlignment="Center"
                            Margin="15,20"
                            Orientation="Horizontal">
                            <Rectangle
                                Fill="{DynamicResource ImageInfoSeparatorColor}"
                                Height="1"
                                Margin="0,0,7,0"
                                Width="{CompiledBinding InfoWindow.HalfLineWidth.Value}" />
                            <Path
                                Data="{StaticResource GpsGeometry}"
                                Fill="{DynamicResource MainTextColor}"
                                Stretch="Uniform" />
                            <Rectangle
                                Fill="{DynamicResource ImageInfoSeparatorColor}"
                                Height="1"
                                Margin="7,0,0,0"
                                Width="{CompiledBinding InfoWindow.HalfLineWidth.Value}" />
                        </StackPanel>

                        <WrapPanel HorizontalAlignment="Center" Margin="5,10,0,0">

                            <!--  Latitude  -->
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Classes="txt"
                                    Margin="0,8,2,0"
                                    Text="{CompiledBinding Translation.Latitude.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextWidth}" />
                                <customControls:FuncTextBox
                                    Background="{DynamicResource DisabledBackgroundColor}"
                                    Classes=" TStyle x"
                                    Command="{CompiledBinding Exif.SetLatitudeCommand}"
                                    CommandParameter="{Binding $self.Text}"
                                    IsReadOnly="True"
                                    Text="{CompiledBinding Exif.Latitude.Value,
                                                           Mode=TwoWay}"
                                    Width="{CompiledBinding InfoWindow.TextBoxWidth.Value}"
                                    x:Name="LatitudeBox" />
                                <customControls:CopyButton
                                    Classes="ToolButtonHover ToolWindowBorderStyle"
                                    CopyText="{CompiledBinding Exif.Latitude.Value,
                                                               Mode=OneWay}"
                                    IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                    ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                                  Mode=OneWay}">
                                    <Path Classes="CopyPath Xl" />
                                </customControls:CopyButton>
                            </StackPanel>

                            <!--  Longitude  -->
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Classes="txt"
                                    Margin="0,8,2,0"
                                    Text="{CompiledBinding Translation.Longitude.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextWidth}" />
                                <customControls:FuncTextBox
                                    Background="{DynamicResource DisabledBackgroundColor}"
                                    Classes=" TStyle x"
                                    Command="{CompiledBinding Exif.SetLongitudeCommand}"
                                    CommandParameter="{Binding $self.Text}"
                                    IsReadOnly="True"
                                    Text="{CompiledBinding Exif.Longitude.Value,
                                                           Mode=TwoWay}"
                                    Width="{CompiledBinding InfoWindow.TextBoxWidth.Value}"
                                    x:Name="LongitudeBox" />
                                <customControls:CopyButton
                                    Classes="ToolButtonHover ToolWindowBorderStyle"
                                    CopyText="{CompiledBinding Exif.Longitude.Value,
                                                               Mode=OneWay}"
                                    IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                    ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                                  Mode=OneWay}">
                                    <Path Classes="CopyPath Xl" />
                                </customControls:CopyButton>
                            </StackPanel>

                            <!--  Altitude  -->
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Classes="txt"
                                    Margin="0,8,2,0"
                                    Text="{CompiledBinding Translation.Altitude.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextWidth}" />
                                <customControls:FuncTextBox
                                    Background="{DynamicResource DisabledBackgroundColor}"
                                    Classes=" TStyle x"
                                    Command="{CompiledBinding Exif.SetAltitudeCommand}"
                                    CommandParameter="{Binding $self.Text}"
                                    IsReadOnly="True"
                                    Text="{CompiledBinding Exif.Altitude.Value,
                                                           Mode=TwoWay}"
                                    Width="{CompiledBinding InfoWindow.TextBoxWidth.Value}"
                                    x:Name="AltitudeBox" />
                                <customControls:CopyButton
                                    Classes="ToolButtonHover ToolWindowBorderStyle"
                                    CopyText="{CompiledBinding Exif.Altitude.Value,
                                                               Mode=OneWay}"
                                    IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                    ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                                  Mode=OneWay}">
                                    <Path Classes="CopyPath Xl" />
                                </customControls:CopyButton>
                            </StackPanel>

                            <!--  Map link buttons  -->
                            <StackPanel Margin="0,5" Orientation="Horizontal">
                                <Button
                                    Classes="ToolButtonHover ToolWindowBorderStyle"
                                    Command="{CompiledBinding Exif.OpenGoogleLinkCommand,
                                                              Mode=OneWay}"
                                    Margin="117,0,15,0"
                                    x:Name="GoogleLinkButton">
                                    <Path
                                        Data="{StaticResource GoogleGeometry}"
                                        Fill="{DynamicResource MainTextColor}"
                                        Height="20"
                                        Stretch="Fill"
                                        Width="20" />
                                </Button>
                                <Button
                                    Classes="ToolButtonHover ToolWindowBorderStyle"
                                    Command="{CompiledBinding Exif.OpenBingLinkCommand,
                                                              Mode=OneWay}"
                                    x:Name="BingLinkButton">
                                    <Path
                                        Data="{StaticResource BingGeometry}"
                                        Fill="{DynamicResource MainTextColor}"
                                        Height="20"
                                        Stretch="Fill"
                                        Width="20" />
                                </Button>

                            </StackPanel>
                        </WrapPanel>

                    </StackPanel>

                    <!--  Color  -->
                    <StackPanel IsEnabled="{CompiledBinding Exif.IsExifAvailable.Value}">
                        <StackPanel
                            Height="20"
                            HorizontalAlignment="Center"
                            Margin="15,20"
                            Orientation="Horizontal">
                            <Rectangle
                                Fill="{DynamicResource ImageInfoSeparatorColor}"
                                Height="1"
                                Margin="0,0,7,0"
                                Width="{CompiledBinding InfoWindow.HalfLineWidth.Value}" />
                            <Image Source="{StaticResource PaletteImage}" />
                            <Rectangle
                                Fill="{DynamicResource ImageInfoSeparatorColor}"
                                Height="1"
                                Margin="7,0,0,0"
                                Width="{CompiledBinding InfoWindow.HalfLineWidth.Value}" />
                        </StackPanel>

                        <WrapPanel HorizontalAlignment="Center" Margin="5,10,0,0">

                            <!--  Color representation  -->
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Classes="txt"
                                    Margin="0,8,2,0"
                                    Text="{CompiledBinding Translation.ColorRepresentation.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextWidth}" />
                                <ComboBox
                                    Background="{DynamicResource DisabledBackgroundColor}"
                                    Classes="CStyle x"
                                    CornerRadius="2"
                                    ItemsSource="{CompiledBinding Exif.ColorRepresentation.Choices}"
                                    Margin="5,0,0,0"
                                    MinWidth="180"
                                    Padding="5,7,1,7"
                                    SelectedIndex="{CompiledBinding Exif.ColorRepresentation.SelectedIndex.Value,
                                                                    Mode=TwoWay}"
                                    Tag="{CompiledBinding Exif.ColorRepresentation}"
                                    Width="{CompiledBinding InfoWindow.TextBoxWidth.Value}"
                                    x:Name="ColorRepresentationBox" />
                                <customControls:CopyButton
                                    Classes="ToolButtonHover ToolWindowBorderStyle"
                                    CopyText="{CompiledBinding Exif.ColorRepresentation.Text.Value,
                                                               Mode=OneWay}"
                                    IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                    ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                                  Mode=OneWay}">
                                    <Path Classes="CopyPath Xl" />
                                </customControls:CopyButton>
                            </StackPanel>

                            <!--  Resolution unit  -->
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Classes="txt"
                                    Margin="0,8,2,0"
                                    Text="{CompiledBinding Translation.ResolutionUnit.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextWidth}" />
                                <ComboBox
                                    Background="{DynamicResource DisabledBackgroundColor}"
                                    Classes="CStyle x"
                                    CornerRadius="2"
                                    ItemsSource="{CompiledBinding Exif.ResolutionUnit.Choices}"
                                    Margin="5,0,0,0"
                                    MinWidth="180"
                                    Padding="5,7,1,7"
                                    SelectedIndex="{CompiledBinding Exif.ResolutionUnit.SelectedIndex.Value,
                                                                    Mode=TwoWay}"
                                    Tag="{CompiledBinding Exif.ResolutionUnit}"
                                    Width="{CompiledBinding InfoWindow.TextBoxWidth.Value}"
                                    x:Name="ResolutionUnitBox" />
