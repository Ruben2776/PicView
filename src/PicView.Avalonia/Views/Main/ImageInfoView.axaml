                                </customControls:CopyButton>
                            </StackPanel>

                        </WrapPanel>
                    </StackPanel>

                    <!--  AI Metadata  -->
                    <StackPanel IsEnabled="{CompiledBinding Exif.IsSdMetadataAvailable.Value}" x:Name="SdMetadataPanel">
                        <StackPanel
                            Height="20"
                            HorizontalAlignment="Center"
                            Margin="15,20"
                            Orientation="Horizontal">
                            <Rectangle
                                Fill="{DynamicResource ImageInfoSeparatorColor}"
                                Height="1"
                                Margin="0,0,7,0"
                                Width="{CompiledBinding InfoWindow.HalfLineWidth.Value}" />
                            <Image Source="{StaticResource BotImage}" />
                            <Rectangle
                                Fill="{DynamicResource ImageInfoSeparatorColor}"
                                Height="1"
                                Margin="7,0,0,0"
                                Width="{CompiledBinding InfoWindow.HalfLineWidth.Value}" />
                        </StackPanel>

                        <WrapPanel HorizontalAlignment="Center" Margin="5,10,0,0">

                            <!--  Generated with  -->
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Classes="txt"
                                    Margin="0,8,2,0"
                                    Text="{CompiledBinding Translation.GeneratedWith.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextWidth}" />
                                <customControls:FuncTextBox
                                    Classes="TStyle x"
                                    IsReadOnly="True"
                                    Text="{CompiledBinding Exif.SdGenerator.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextBoxWidth.Value}"
                                    x:Name="SdGeneratorBox" />
                                <customControls:CopyButton
                                    Classes="ToolButtonHover ToolWindowBorderStyle"
                                    CopyText="{CompiledBinding Exif.SdGenerator.Value,
                                                               Mode=OneWay}"
                                    IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                    ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                                  Mode=OneWay}">
                                    <Path Classes="CopyPath Xl" />
                                </customControls:CopyButton>
                            </StackPanel>

                            <!--  Stored in, or that the pixels are being scanned for hidden AI Metadata  -->
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Classes="txt"
                                    Margin="0,8,2,0"
                                    Text="{CompiledBinding Translation.StoredIn.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextWidth}" />
                                <customControls:FuncTextBox
                                    Classes="TStyle x"
                                    IsReadOnly="True"
                                    Text="{CompiledBinding Exif.SdStorage.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextBoxWidth.Value}"
                                    x:Name="SdStorageBox" />
                                <customControls:CopyButton
                                    Classes="ToolButtonHover ToolWindowBorderStyle"
                                    CopyText="{CompiledBinding Exif.SdStorage.Value,
                                                               Mode=OneWay}"
                                    IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                    ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                                  Mode=OneWay}">
                                    <Path Classes="CopyPath Xl" />
                                </customControls:CopyButton>
                            </StackPanel>

                            <!--  Prompt  -->
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Classes="txt"
                                    Margin="0,8,2,0"
                                    Text="{CompiledBinding Translation.Prompt.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextWidth}" />
                                <customControls:FuncTextBox
                                    AcceptsReturn="True"
                                    Classes=" TStyle x"
                                    Command="{CompiledBinding Exif.SetSdPromptCommand}"
                                    CommandParameter="{Binding $self.Text}"
                                    CommitOnLostFocus="True"
                                    IsReadOnly="{CompiledBinding !Exif.IsSdEditable.Value,
                                                                 FallbackValue=True}"
                                    MaxHeight="600"
                                    Text="{CompiledBinding Exif.SdPrompt.Value,
                                                           Mode=TwoWay}"
                                    TextWrapping="Wrap"
                                    Width="{CompiledBinding InfoWindow.TextBoxXxlWidth.Value}"
                                    x:Name="SdPromptBox" />
                                <customControls:CopyButton
                                    Classes="ToolButtonHover ToolWindowBorderStyle"
                                    CopyText="{CompiledBinding Exif.SdPrompt.Value,
                                                               Mode=OneWay}"
                                    IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                    ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                                  Mode=OneWay}">
                                    <Path Classes="CopyPath Xl" />
                                </customControls:CopyButton>
                            </StackPanel>

                            <!--  Negative prompt  -->
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Classes="txt"
                                    Margin="0,8,2,0"
                                    Text="{CompiledBinding Translation.NegativePrompt.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextWidth}" />
                                <customControls:FuncTextBox
                                    AcceptsReturn="True"
                                    Classes=" TStyle x"
                                    Command="{CompiledBinding Exif.SetSdNegativePromptCommand}"
                                    CommandParameter="{Binding $self.Text}"
                                    CommitOnLostFocus="True"
                                    IsReadOnly="{CompiledBinding !Exif.IsSdEditable.Value,
                                                                 FallbackValue=True}"
                                    MaxHeight="600"
                                    Text="{CompiledBinding Exif.SdNegativePrompt.Value,
                                                           Mode=TwoWay}"
                                    TextWrapping="Wrap"
                                    Width="{CompiledBinding InfoWindow.TextBoxXxlWidth.Value}"
                                    x:Name="SdNegativePromptBox" />
                                <customControls:CopyButton
                                    Classes="ToolButtonHover ToolWindowBorderStyle"
                                    CopyText="{CompiledBinding Exif.SdNegativePrompt.Value,
                                                               Mode=OneWay}"
                                    IsVisible="{CompiledBinding InfoWindow.IsCopyButtonEnabled.Value}"
                                    ToolTip.Tip="{CompiledBinding Translation.Copy.Value,
                                                                  Mode=OneWay}">
                                    <Path Classes="CopyPath Xl" />
                                </customControls:CopyButton>
                            </StackPanel>

                            <!--  Generation settings  -->
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock
                                    Classes="txt"
                                    Margin="0,8,2,0"
                                    Text="{CompiledBinding Translation.Settings.Value,
                                                           Mode=OneWay}"
                                    Width="{CompiledBinding InfoWindow.TextWidth}" />
