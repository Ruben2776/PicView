<UserControl
    x:Class="PicView.Avalonia.Views.Main.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:PicView.Avalonia.Views.UC.Buttons"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:keybindings="using:PicView.Core.Keybindings"
    xmlns:uc="clr-namespace:PicView.Avalonia.Views.UC"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    x:DataType="viewModels:MainWindowViewModel"
    Background="Transparent"
    DragDrop.AllowDrop="True"
    Focusable="True">
    <UserControl.Resources>

        <ContextMenu x:Key="MainContextMenu">

            <!--  Open  -->
            <customControls:StyledMenuItem
                MinWidth="180"
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.Open}"
                Header="{CompiledBinding Translation.Open.Value,
                                         Mode=OneWay}">
                <MenuItem.Icon>
                    <Image Classes="OpenImage" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Save  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.Save}"
                Header="{CompiledBinding Translation.Save.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}">
                <MenuItem.Icon>
                    <Path Classes="SavePath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Save as  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.SaveAs}"
                Header="{CompiledBinding Translation.SaveAs.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull}}">
                <MenuItem.Icon>
                    <Path Classes="SavePath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Print  -->
            <customControls:StyledMenuItem
                x:Name="PrintMenuItem"
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.Print}"
                Header="{CompiledBinding Translation.Print.Value,
                                         Mode=OneWay}"
                IsEnabled="{Binding WindowTabs.ActiveTab.Value.ShouldPrintBeEnabled.Value}">
                <MenuItem.Icon>
                    <Path Classes="PrintPath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Open with  -->
            <customControls:StyledMenuItem
                x:Name="OpenWithMenuItem"
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.OpenWith}"
                Header="{CompiledBinding Translation.OpenWith.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}">
                <MenuItem.Icon>
                    <Image
                        Width="12"
                        Height="12"
                        Source="{StaticResource OpenExternalImage}" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Locate on disk  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.OpenInExplorer}"
                Header="{CompiledBinding Translation.ShowInFolder.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}">
                <MenuItem.Icon>
                    <Path Classes="ShowInFolderPath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <Separator />

            <!--  Sort files by  -->
            <customControls:StyledMenuItem Header="{CompiledBinding Translation.SortFilesBy.Value, Mode=OneWay}">
                <MenuItem.Icon>
                    <Path Classes="SortFilesPath" />
                </MenuItem.Icon>

                <!--  Sort files by name  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SortFilesByName}"
                    GroupName="SortType"
                    Header="{CompiledBinding Translation.FileName.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding WindowTabs.IsSortedByName.Value}"
                    ToggleType="Radio" />

                <!--  Sort files by size  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SortFilesBySize}"
                    GroupName="SortType"
                    Header="{CompiledBinding Translation.FileSize.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding WindowTabs.IsSortedByFileSize.Value}"
                    ToggleType="Radio" />

                <!--  Sort files by extension  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SortFilesByExtension}"
                    GroupName="SortType"
                    Header="{CompiledBinding Translation.FileExtension.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding WindowTabs.IsSortedByExtension.Value}"
                    ToggleType="Radio" />

                <!--  Sort files by creation time  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SortFilesByCreationTime}"
                    GroupName="SortType"
                    Header="{CompiledBinding Translation.Created.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding WindowTabs.IsSortedByCreationTime.Value}"
                    ToggleType="Radio" />

                <!--  Sort files by last access time  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SortFilesByLastAccessTime}"
                    GroupName="SortType"
                    Header="{CompiledBinding Translation.LastAccessTime.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding WindowTabs.IsSortedByLastAccessTime.Value}"
                    ToggleType="Radio" />

                <!--  Sort files by last write time  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SortFilesByLastWriteTime}"
                    GroupName="SortType"
                    Header="{CompiledBinding Translation.Modified.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding WindowTabs.IsSortedByLastWriteTime.Value}"
                    ToggleType="Radio" />

                <!--  Sort files randomly  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SortFilesRandomly}"
                    GroupName="SortType"
                    Header="{CompiledBinding Translation.Random.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding WindowTabs.IsSortedByRandomization.Value}"
                    ToggleType="Radio" />

                <Separator />

                <!--  Sort files ascending  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SortFilesAscending}"
                    GroupName="SortDirection"
                    Header="{CompiledBinding Translation.Ascending.Value,
                                             Mode=OneWay}"
                    IsChecked="{CompiledBinding WindowTabs.IsAscending.Value}"
                    ToggleType="Radio" />

                <!--  Sort files descending  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SortFilesDescending}"
                    GroupName="SortDirection"
                    Header="{CompiledBinding Translation.Descending.Value,
                                             Mode=OneWay}"
                    IsChecked="{CompiledBinding !WindowTabs.IsAscending.Value}"
                    ToggleType="Radio" />
            </customControls:StyledMenuItem>

            <Separator />

            <!--  Settings  -->
            <customControls:StyledMenuItem Header="{CompiledBinding Translation.Settings.Value, Mode=OneWay}">
                <MenuItem.Icon>
                    <Path
                        Width="12"
                        Height="12"
                        Data="{StaticResource WrenchGeometry}"
                        Fill="{DynamicResource MainTextColor}"
                        Stretch="Fill" />
                </MenuItem.Icon>

                <!--  Toggle Subdirectories  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ToggleSubdirectories}"
                    Header="{CompiledBinding Translation.SearchSubdirectory.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding GlobalSettings.IsIncludingSubdirectories.Value, Mode=OneWay}"
                    ToggleType="CheckBox" />

                <Separator />

                <!--  Toggle looping  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ToggleLooping}"
                    Header="{CompiledBinding Translation.IsLooping.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding GlobalSettings.IsLooping.Value, Mode=OneWay}"
                    ToggleType="CheckBox" />

                <Separator />

                <!--  Toggle scrolling  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ToggleScroll}"
                    Header="{CompiledBinding Translation.IsScrolling.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding IsScrollingEnabled.Value, Mode=OneWay}"
                    ToggleType="CheckBox" />

                <!--  Zoom to fit  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ZoomToFit}"
                    Header="{CompiledBinding Translation.ZoomToFit.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding IsZoomedToFit.Value, Mode=OneWay}"
                    ToggleType="CheckBox" />

                <!--  Toggle side-by-side  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SideBySide}"
                    Header="{CompiledBinding Translation.SideBySide.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding IsSideBySide.Value, Mode=OneWay}"
                    ToggleType="CheckBox" />

                <Separator />

                <!--  Toggle topmost  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetTopMost}"
                    Header="{CompiledBinding Translation.StayTopMost.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding IsTopMost.Value, Mode=OneWay}"
                    ToggleType="CheckBox" />

                <!--  Toggle auto fit  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.AutoFitWindow}"
                    Header="{CompiledBinding Translation.AutoFitWindow.Value,
                                             Mode=OneWay}"
                    IsChecked="{Binding IsAutoFit.Value, Mode=OneWay}"
                    ToggleType="CheckBox" />

                <Separator />

                <!--  Toggle UI  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ToggleInterface}"
                    Header="{CompiledBinding Translation.IsShowingUI.Value,
                                             Mode=OneWay}"
                    IsVisible="{CompiledBinding IsUIShown.Value,
                                                Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource EyeOffImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ToggleInterface}"
                    Header="{CompiledBinding Translation.IsShowingUI.Value,
                                             Mode=OneWay}"
                    IsVisible="{CompiledBinding !IsUIShown.Value,
                                                Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource EyeImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Change background  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ChangeBackground}"
                    Header="{CompiledBinding Translation.ChangeBackground.Value,
                                             Mode=OneWay}"
                    StaysOpenOnClick="True">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource PaletteImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Toggle docked gallery  -->
                <customControls:StyledMenuItem Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.ToggleDockedCommand}" Header="{CompiledBinding Translation.IsShowingDockedGallery.Value, Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource GalleryImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Toggle bottom bar  -->
                <customControls:StyledMenuItem
                    Command="{Binding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ToggleBottomToolbar}"
                    Header="{CompiledBinding Translation.ShowBottomToolbar.Value,
                                             Mode=OneWay}"
                    IsChecked="{CompiledBinding IsBottomToolbarShown.Value}"
                    IsVisible="{CompiledBinding !IsBottomToolbarShown.Value}"
                    ToggleType="CheckBox">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource Panel-Bottom}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <Separator />

                <!--  Show Settings window  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SettingsWindow}"
                    Header="{CompiledBinding Translation.ShowAllSettingsWindow.Value,
                                             Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image Classes="CogImage" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>
            </customControls:StyledMenuItem>

            <Separator />

            <!--  Navigation  -->
            <customControls:StyledMenuItem Header="{CompiledBinding Translation.Navigation.Value, Mode=OneWay}">
                <MenuItem.Icon>
                    <Image
                        Width="14"
                        Height="14"
                        Source="{StaticResource SignPostImage}" />
                </MenuItem.Icon>

                <!--  Next  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.Next}"
                    Header="{CompiledBinding Translation.NextImage.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.CanNavigateForwards.Value,
                                                FallbackValue=False}"
                    StaysOpenOnClick="True">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource NextImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Prev  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.Prev}"
                    Header="{CompiledBinding Translation.PrevImage.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.CanNavigateBackwards.Value,
                                                FallbackValue=False}"
                    StaysOpenOnClick="True">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource PrevImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <Separator />

                <!--  Next 10  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.Next10}"
                    Header="{CompiledBinding Translation.AdvanceBy10Images.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.CanNavigateForwards.Value}"
                    StaysOpenOnClick="True">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource NextImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Next 100  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.Next100}"
                    Header="{CompiledBinding Translation.AdvanceBy100Images.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.CanNavigateForwards.Value}"
                    StaysOpenOnClick="True">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource NextImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Prev 10  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.Prev10}"
                    Header="{CompiledBinding Translation.GoBackBy10Images.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.CanNavigateBackwards.Value}"
                    StaysOpenOnClick="True">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource PrevImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Prev 100  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.Prev100}"
                    Header="{CompiledBinding Translation.GoBackBy100Images.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.CanNavigateBackwards.Value}"
                    StaysOpenOnClick="True">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource PrevImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <Separator />

                <!--  First Image  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.First}"
                    Header="{CompiledBinding Translation.FirstImage.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.CanNavigateBackwards.Value}">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource FirstImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Last Image  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.Last}"
                    Header="{CompiledBinding Translation.LastImage.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.CanNavigateForwards.Value}">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource LastImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <Separator />

                <!--  Next folder  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.NextFolder}"
                    Header="{CompiledBinding Translation.NextFolder.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False,
                                                Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image
                            Width="14"
                            Height="14"
                            Source="{StaticResource NextFolderImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Prev folder  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.PrevFolder}"
                    Header="{CompiledBinding Translation.PrevFolder.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False,
                                                Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image
                            Width="14"
                            Height="14"
                            Source="{StaticResource PrevFolderImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Next archive  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.NextArchive}"
                    Header="{CompiledBinding Translation.NextArchive.Value,
                                             Mode=OneWay}"
                    IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <MenuItem.Icon>
                        <Image
                            Width="14"
                            Height="14"
                            Source="{StaticResource ArchiveFile}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Prev archive  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.PrevArchive}"
                    Header="{CompiledBinding Translation.PrevArchive.Value,
                                             Mode=OneWay}"
                    IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <MenuItem.Icon>
                        <Image
                            Width="14"
                            Height="14"
                            Source="{StaticResource ArchiveFile}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>
            </customControls:StyledMenuItem>

            <Separator />

            <!--  Set as wallpaper  -->
            <customControls:StyledMenuItem
                x:Name="WallpaperMenuItem"
                Header="{CompiledBinding Translation.SetAsWallpaper.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False}"
                IsVisible="{CompiledBinding GlobalSettings.ShowSetAsWallpaper.Value}">
                <MenuItem.Icon>
                    <Image Classes="WallpaperImage" />
                </MenuItem.Icon>

                <!--  Set as wallpaper filled  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetAsWallpaperFilled}"
                    Header="{CompiledBinding Translation.Fill.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}"
                    IsVisible="{CompiledBinding GlobalSettings.ShowSetAsWallpaper.Value}">
                    <MenuItem.Icon>
                        <Image Classes="WallpaperImage" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Set as wallpaper fit  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetAsWallpaperFitted}"
                    Header="{CompiledBinding Translation.Fit.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}"
                    IsVisible="{CompiledBinding GlobalSettings.ShowSetAsWallpaper.Value}">
                    <MenuItem.Icon>
                        <Image Classes="WallpaperImage" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Set as wallpaper stretched  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetAsWallpaperStretched}"
                    Header="{CompiledBinding Translation.Stretch.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}"
                    IsVisible="{CompiledBinding GlobalSettings.ShowSetAsWallpaper.Value}">
                    <MenuItem.Icon>
                        <Image Classes="WallpaperImage" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>


                <!--  Set as wallpaper centered  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetAsWallpaperCentered}"
                    Header="{CompiledBinding Translation.Center.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}"
                    IsVisible="{CompiledBinding GlobalSettings.ShowSetAsWallpaper.Value}">
                    <MenuItem.Icon>
                        <Image Classes="WallpaperImage" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Set as wallpaper tiled  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetAsWallpaperTiled}"
                    Header="{CompiledBinding Translation.Tile.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False}"
                    IsVisible="{CompiledBinding GlobalSettings.ShowSetAsWallpaper.Value}">
                    <MenuItem.Icon>
                        <Image Classes="WallpaperImage" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>
            </customControls:StyledMenuItem>

            <!--  Image  -->
            <customControls:StyledMenuItem Header="{CompiledBinding Translation.Image.Value, Mode=OneWay}">
                <MenuItem.Icon>
                    <Image
                        Width="13"
                        Height="13"
                        Source="{StaticResource ImageOutLine}" />
                </MenuItem.Icon>

                <!--  File properties  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ShowFileProperties}"
                    Header="{CompiledBinding Translation.FileProperties.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False,
                                                Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource FileUserImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <Separator />

                <!--  Optimize image  -->
                <customControls:StyledMenuItem
                    x:Name="OptimizeMenuItem"
                    Command="{Binding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.OptimizeImage}"
                    Header="{CompiledBinding Translation.OptimizeImage.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.ShouldOptimizeImageBeEnabled.Value,
                                                Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource PortalImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <Separator />

                <!--  Crop  -->
                <customControls:StyledMenuItem
                    x:Name="CropMenuItem"
                    Command="{Binding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.Crop}"
                    Header="{Binding Translation.Crop.Value, Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.ShouldCropBeEnabled.Value,
                                                Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image Classes="CropImage" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <Separator />

                <!--  Flip  -->
                <customControls:StyledMenuItem
                    Command="{Binding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.Flip}"
                    Header="{CompiledBinding WindowTabs.ActiveTab.Value.Orientation.FlipLabel.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False,
                                                Mode=OneWay}"
                    StaysOpenOnClick="True">
                    <MenuItem.Icon>
                        <Image Classes="FlipImage">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="{Binding WindowTabs.ActiveTab.Value.Orientation.ScaleX.Value}" />
                            </Image.RenderTransform>
                        </Image>
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Rotate left  -->
                <customControls:StyledMenuItem
                    Command="{Binding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.RotateLeft}"
                    Header="{CompiledBinding Translation.RotateLeft.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False,
                                                Mode=OneWay}"
                    StaysOpenOnClick="True">
                    <MenuItem.Icon>
                        <Path Classes="RotateLeftPath" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Rotate right  -->
                <customControls:StyledMenuItem
                    Command="{Binding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.RotateRight}"
                    Header="{CompiledBinding Translation.RotateRight.Value,
                                             Mode=OneWay}"
                    IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                Converter={x:Static ObjectConverters.IsNotNull},
                                                FallbackValue=False,
                                                Mode=OneWay}"
                    StaysOpenOnClick="True">
                    <MenuItem.Icon>
                        <Path Classes="RotateRightPath" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>
            </customControls:StyledMenuItem>

            <Separator />

            <!--  Tool windows  -->
            <customControls:StyledMenuItem Header="{CompiledBinding Translation.ToolWindows.Value, Mode=OneWay}">
                <MenuItem.Icon>
                    <Image
                        Width="12"
                        Height="12"
                        Source="{StaticResource BrushImage}" />
                </MenuItem.Icon>

                <!--  Exif window  -->
                <customControls:StyledMenuItem
                    Command="{CompiledBinding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ImageInfoWindow}"
                    Header="{CompiledBinding Translation.ImageInfo.Value,
                                             Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource CameraImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Image effects  -->
                <customControls:StyledMenuItem
                    Command="{Binding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.EffectsWindow}"
                    Header="{CompiledBinding Translation.Effects.Value,
                                             Mode=OneWay}"
                    ToolTip.Tip="{CompiledBinding Translation.EffectsTooltip.Value,
                                                  Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource SparklesImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Resize  Image  -->
                <customControls:StyledMenuItem
                    Command="{Binding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ResizeWindow}"
                    Header="{CompiledBinding Translation.ResizeImage.Value,
                                             Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource UpscaleImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Batch Resize  Images  -->
                <customControls:StyledMenuItem
                    Command="{Binding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.BatchResizeWindow}"
                    Header="{CompiledBinding Translation.BatchResize.Value,
                                             Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image
                            Width="12"
                            Height="12"
                            Source="{StaticResource BatchResizeImage}" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>
            </customControls:StyledMenuItem>

            <Separator />

            <!--  Delete file  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.DeleteFile}"
                Header="{CompiledBinding Translation.DeleteFile.Value,
                                         Mode=OneWay}"
                IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                            Converter={x:Static ObjectConverters.IsNotNull},
                                            FallbackValue=False,
                                            Mode=OneWay}">
                <MenuItem.Icon>
                    <Path Classes="RecyclePath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <Separator />

            <!--  Paste  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.Paste}"
                Header="{CompiledBinding Translation.Paste.Value,
                                         Mode=OneWay}">
                <MenuItem.Icon>
                    <Path Classes="PastePath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Copy  -->
            <customControls:StyledMenuItem Header="{Binding Translation.Copy.Value, Mode=OneWay}">
                <MenuItem.Icon>
                    <Path
                        Width="12"
                        Height="12"
                        Data="{StaticResource CopyGeometry}"
                        Fill="{DynamicResource MainTextColor}"
                        Stretch="Fill" />
                </MenuItem.Icon>

                <!--  Copy image  -->
                <customControls:StyledMenuItem
                    Command="{Binding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.CopyImage}"
                    Header="{Binding Translation.CopyImage.Value, Mode=OneWay}"
                    IsEnabled="{Binding WindowTabs.ActiveTab.Value.Image.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}">
                    <MenuItem.Icon>
                        <Path Classes="CopyPath" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Copy file path  -->
                <customControls:StyledMenuItem
                    Command="{Binding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.CopyFilePath}"
                    Header="{Binding Translation.FileCopyPath.Value, Mode=OneWay}"
                    IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}">
                    <MenuItem.Icon>
                        <Path Classes="CopyPath" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <!--  Copy base64  -->
                <customControls:StyledMenuItem
                    Command="{Binding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.CopyBase64}"
                    IsEnabled="{Binding WindowTabs.ActiveTab.Value.Image.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}">
                    <MenuItem.Header>
                        <TextBlock>
                            <Run Text="{Binding Translation.Copy.Value, Mode=OneWay}" />
                            <Run Text=" base64" />
                        </TextBlock>
                    </MenuItem.Header>
                    <MenuItem.Icon>
                        <Path Classes="CopyPath" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <Separator />

                <!--  Duplicate file  -->
                <customControls:StyledMenuItem
                    Command="{Binding RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.DuplicateFile}"
                    Header="{Binding Translation.DuplicateFile.Value, Mode=OneWay}"
                    IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}">
                    <MenuItem.Icon>
                        <Path Classes="DuplicatePath" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

            </customControls:StyledMenuItem>

            <!--  Copy file  -->
            <customControls:StyledMenuItem
                Command="{Binding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.CopyFile}"
                Header="{Binding Translation.CopyFile.Value, Mode=OneWay}"
                IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}">
                <MenuItem.Icon>
                    <Path Classes="CopyPath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <Separator />

            <!--  Fullscreen  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.ToggleFullscreen}"
                Header="{CompiledBinding Translation.Fullscreen.Value,
                                         Mode=OneWay}"
                IsVisible="{CompiledBinding !IsFullscreen.Value,
                                            Mode=OneWay}">
                <MenuItem.Icon>
                    <Path Classes="FullscreenPath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Maximize  -->
            <customControls:StyledMenuItem
                x:Name="MaximizeMenuItem"
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.Maximize}"
                Header="{CompiledBinding Translation.Maximize.Value,
                                         Mode=OneWay}"
                IsVisible="{CompiledBinding ShouldMaximizeBeShown.Value,
                                            Mode=OneWay}">
                <MenuItem.Icon>
                    <Image Classes="MaximizeImage" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Restore  -->
            <customControls:StyledMenuItem
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.Restore}"
                Header="{CompiledBinding Translation.RestoreDown.Value,
                                         Mode=OneWay}"
                IsVisible="{CompiledBinding ShouldRestoreBeShown.Value,
                                            Mode=OneWay}">
                <MenuItem.Icon>
                    <Path Classes="RestorePath" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>

            <!--  Close  -->
            <customControls:StyledMenuItem
                x:Name="CloseMenuItem"
                Command="{CompiledBinding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.CloseWindow}"
                Header="{CompiledBinding Translation.Close.Value,
                                         Mode=OneWay}">
                <MenuItem.Icon>
                    <PathIcon
                        Width="12"
                        Height="12"
                        Data="{StaticResource CloseGeometry}"
                        Foreground="{DynamicResource MainTextColor}" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Panel x:Name="MainPanel">
        <customControls:DraggableTabControl
            x:Name="MainTabControl"
            Background="{DynamicResource BehindTabBackground}"
            DataContext="{CompiledBinding WindowTabs}"
            ItemsSource="{CompiledBinding Tabs.Value,
                                          Mode=TwoWay}"
            SelectedItem="{Binding ActiveTab.Value, Mode=TwoWay}">

            <customControls:DraggableTabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="Theme" Value="{StaticResource DraggableTabItem}" />
                </Style>
            </customControls:DraggableTabControl.Styles>

            <customControls:DraggableTabControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Background="Transparent" LastChildFill="True">
                        <customControls:IconButton
                            Height="{Binding TabHeight}"
                            Padding="9,0"
                            Background="Transparent"
                            Classes="AltHover"
                            Command="{CompiledBinding CloseTab}"
                            Data="{StaticResource CloseGeometry}"
                            DockPanel.Dock="Right"
                            Foreground="{DynamicResource MainTextColor}"
                            IconHeight="12"
                            IconWidth="12" />
                        <TextBlock
                            Margin="7,0,0,0"
                            Classes="txt"
                            Text="{CompiledBinding TabTitle.Value,
                                                   Mode=OneWay}"
                            TextWrapping="NoWrap" />
                        <ToolTip.Tip>
                            <DockPanel Width="140" Height="235">
                                <TextBlock
                                    MaxWidth="135"
                                    HorizontalAlignment="Center"
                                    Classes="txt bold"
                                    DockPanel.Dock="Top"
                                    FontSize="12"
                                    Text="{Binding TabTitle.Value, Mode=OneWay}" />
                                <customControls:ThumbImage
                                    HorizontalAlignment="Center"
                                    DockPanel.Dock="Bottom"
                                    Source="{CompiledBinding Image.Value,
                                                             TargetNullValue={StaticResource LogoImage}}" />
                            </DockPanel>
                        </ToolTip.Tip>
                    </DockPanel>
                </DataTemplate>
            </customControls:DraggableTabControl.ItemTemplate>

            <customControls:DraggableTabControl.ContentTemplate>
                <DataTemplate DataType="viewModels:TabViewModel">
                    <ContentControl Content="{Binding CurrentView.Value, Mode=OneWay}" />
                </DataTemplate>
            </customControls:DraggableTabControl.ContentTemplate>

        </customControls:DraggableTabControl>

        <uc:SpinWaiter
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding IsLoadingIndicatorShown.Value, Mode=OneWay}"
            ZIndex="9" />

        <DockPanel
            x:Name="AltButtonsPanel"
            Height="150"
            VerticalAlignment="Top"
            IsHitTestVisible="{Binding !IsUIShown.Value, Mode=OneWay}"
            IsVisible="{Binding !WindowTabs.ActiveTab.Value.Gallery.IsGalleryExpanded.Value}"
            LastChildFill="True"
            Opacity="0"
            ZIndex="9">
            <buttons:AltClose
                x:Name="AltClose"
                VerticalAlignment="Top"
                DockPanel.Dock="Right"
                IsVisible="{Binding !IsUIShown.Value}" />
            <buttons:AltRestore
                x:Name="AltRestore"
                VerticalAlignment="Top"
                DockPanel.Dock="Right"
                IsVisible="{Binding !IsUIShown.Value}" />
            <buttons:AltMinimize
                x:Name="AltMinimize"
                VerticalAlignment="Top"
                DockPanel.Dock="Right"
                IsVisible="{Binding !IsUIShown.Value}" />
            <Border
                x:Name="AltTitleBorder"
                Height="{StaticResource TopBorderHeight}"
                Padding="2,0"
                VerticalAlignment="Top"
                Background="{DynamicResource PopUpBackgroundColor}"
                BorderBrush="{DynamicResource PopUpMainBorderColor}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Left"
                IsVisible="{Binding !IsUIShown.Value}"
                PointerPressed="DragMove">
                <TextBlock
                    Classes="txt"
                    Text="{Binding WindowTabs.ActiveTab.Value.Title.Value}"
                    TextAlignment="Center" />
            </Border>
        </DockPanel>

        <uc:ToolTipMessage
            x:Name="ToolTipMessage"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0"
            ZIndex="9" />

        <!--  Bottom-right Archive Extraction Progress Indicator  -->
        <Border
            Margin="0,0,16,16"
            Padding="8,4"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{DynamicResource PopUpBackgroundColor}"
            BorderBrush="{DynamicResource PopUpMainBorderColor}"
            BorderThickness="1"
            CornerRadius="4"
            IsHitTestVisible="False"
            IsVisible="{Binding WindowTabs.ActiveTab.Value.ArchiveExtractionProgressText.Value, Mode=OneWay, Converter={x:Static ObjectConverters.IsNotNull}}"
            ZIndex="10">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <Viewbox
                    Width="14"
                    Height="14"
                    VerticalAlignment="Center">
                    <uc:SpinWaiter />
                </Viewbox>
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="txt"
                    FontSize="12"
                    Text="{Binding WindowTabs.ActiveTab.Value.ArchiveExtractionProgressText.Value, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Panel>
</UserControl>