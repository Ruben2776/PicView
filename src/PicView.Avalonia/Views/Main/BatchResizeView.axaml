<UserControl
    x:Class="PicView.Avalonia.Views.Main.BatchResizeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    x:DataType="viewModels:CoreViewModel">

    <Panel Margin="0,15,0,30">

        <!--  Files processing panel log  -->
        <Panel
            x:Name="ProcessingPanel"
            Background="Transparent"
            IsVisible="{CompiledBinding BatchResize.IsRunning.Value}">
            <Border
                Margin="10,0,10,70"
                Background="{DynamicResource ToolWindowButtonBackground}"
                BorderBrush="{DynamicResource ToolWindowButtonBorderColor}"
                BorderThickness="0,0,0,1"
                CornerRadius="6">
                <Border.ContextMenu>
                    <ContextMenu>
                        <customControls:StyledMenuItem Header="{CompiledBinding Translation.Cancel, Mode=OneWay}">
                            <MenuItem.Icon>
                                <Path Classes="RestorePath" />
                            </MenuItem.Icon>
                        </customControls:StyledMenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <customControls:AutoScrollViewer MinHeight="50">
                    <ItemsControl Padding="15,10,10,10" ItemsSource="{CompiledBinding BatchResize.ProcessedFiles.Value}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, 65, 65" ColumnSpacing="10">
                                    <TextBlock
                                        Margin="0,5"
                                        Background="Transparent"
                                        Classes="txt"
                                        Text="{Binding FileName}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Background="Transparent"
                                        Classes="txt"
                                        Foreground="Red"
                                        Text="{Binding OldSize}"
                                        TextDecorations="StrikeThrough" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Background="Transparent"
                                        Classes="txt"
                                        Foreground="ForestGreen"
                                        Text="{Binding NewSize}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </customControls:AutoScrollViewer>
            </Border>

            <ProgressBar
                Height="32"
                Margin="10,0,10,25"
                VerticalAlignment="Bottom"
                CornerRadius="6"
                FontFamily="/Assets/Fonts/Roboto-Bold.ttf#Roboto"
                IsIndeterminate="{CompiledBinding BatchResize.IsIndeterminate.Value,
                                                  Mode=OneWay}"
                Maximum="{CompiledBinding BatchResize.ProgressMaximum.Value}"
                Minimum="0"
                ShowProgressText="True"
                Value="{CompiledBinding BatchResize.Progress.Value,
                                        Mode=OneWay}" />

            <StackPanel
                Margin="10,0,10,-20"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Orientation="Horizontal">
                <Button
                    Width="NaN"
                    Height="35"
                    Margin="5,0,0,0"
                    Padding="10"
                    Background="{DynamicResource ToolWindowButtonBackground}"
                    BorderBrush="{DynamicResource ToolWindowButtonBorderColor}"
                    BorderThickness="1"
                    Classes="MenuItemHover"
                    Command="{CompiledBinding BatchResize.CancelCommand}"
                    CornerRadius="4"
                    DockPanel.Dock="Left"
                    IsVisible="{CompiledBinding !BatchResize.IsFinished.Value}">
                    <TextBlock
                        Padding="15,0"
                        Classes="txt"
                        Text="{CompiledBinding Translation.Cancel.Value,
                                               Mode=OneWay}"
                        TextAlignment="Center" />
                </Button>
                <Button
                    Background="{DynamicResource ToolWindowButtonBackground}"
                    BorderBrush="{DynamicResource ToolWindowButtonBorderColor}"
                    BorderThickness="1"
                    Classes="altHover"
                    Command="{CompiledBinding BatchResize.CloseProgressCommand}"
                    CornerRadius="4"
                    DockPanel.Dock="Left"
                    IsVisible="{CompiledBinding BatchResize.IsFinished.Value}">
                    <TextBlock
                        Padding="15,0"
                        Classes="txt"
                        Text="{CompiledBinding Translation.Close.Value,
                                               Mode=OneWay}"
                        TextAlignment="Center" />
                </Button>
                <Button
                    x:Name="ShowInFolderButton"
                    Background="{DynamicResource ToolWindowButtonBackground}"
                    BorderBrush="{DynamicResource ToolWindowButtonBorderColor}"
                    BorderThickness="1"
                    Classes="altHover"
                    Command="{CompiledBinding BatchResize.ShowInFolderCommand}"
                    CornerRadius="4"
                    DockPanel.Dock="Left"
                    IsVisible="{CompiledBinding BatchResize.IsFinished.Value}">
                    <TextBlock
                        Padding="15,0"
                        Classes="txt"
                        Text="{CompiledBinding Translation.ShowInFolder.Value,
                                               Mode=OneWay}"
                        TextAlignment="Center" />
                </Button>
            </StackPanel>
        </Panel>

        <DockPanel IsVisible="{CompiledBinding !BatchResize.IsRunning.Value}">

            <!--  Tabs  -->
            <TabControl
                x:Name="MainTabControl"
                HorizontalAlignment="Center"
                DockPanel.Dock="Top">
                <TabItem
                    x:Name="SelectFilesTabItem"
                    Classes="FloatingTab"
                    CornerRadius="6">
                    <TabItem.Header>
                        <StackPanel Width="112" VerticalAlignment="Center">
                            <PathIcon
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                Data="{StaticResource FolderGeometry}"
                                Foreground="{DynamicResource MainTextColor}" />
                            <TextBlock
                                Margin="0,5,0,0"
                                Classes="txt"
                                Text="{CompiledBinding Translation.SelectFiles}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                <TabItem
                    x:Name="ResizeSettingsTabItem"
                    Classes="FloatingTab"
                    CornerRadius="6">
                    <TabItem.Header>
                        <StackPanel Width="112" VerticalAlignment="Center">
                            <Image
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                Source="{StaticResource UpscaleImage}" />
                            <TextBlock
                                Margin="0,5,0,0"
                                Classes="txt"
                                Text="{CompiledBinding Translation.ResizeSettings}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                <TabItem
                    x:Name="ThumbnailTabItem"
                    Classes="FloatingTab"
                    CornerRadius="6">
                    <TabItem.Header>
                        <StackPanel Width="112" VerticalAlignment="Center">
                            <Image
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                Source="{StaticResource BatchResizeImage}" />
                            <TextBlock
                                Margin="0,5,0,0"
                                Classes="txt"
                                Text="{CompiledBinding Translation.Thumbnail}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
            </TabControl>

            <!--  Add folder of files buttons  -->
            <StackPanel
                Margin="0,15"
                HorizontalAlignment="Center"
                DockPanel.Dock="Top"
                IsVisible="{Binding Path=IsSelected, ElementName=SelectFilesTabItem}"
                Orientation="Horizontal"
                Spacing="10">
                <customControls:TextIconButton
                    x:Name="AddFileButton"
                    Padding="7"
                    Background="Transparent"
                    Classes="MenuItemHover"
                    Command="{CompiledBinding BatchResize.SelectAndAddFileCommand}"
                    CornerRadius="4"
                    Foreground="{DynamicResource MainTextColor}"
                    Icon="{StaticResource AddFileImage}"
                    IconHeight="16"
                    IconMargin="5,0,10,0"
                    IconWidth="16"
                    Text="{CompiledBinding Translation.AddFiles}" />
                <customControls:TextIconButton
                    x:Name="AddFolderButton"
                    Padding="7"
                    Background="Transparent"
                    Classes="MenuItemHover"
                    Command="{CompiledBinding BatchResize.SelectAndAddFolderCommand}"
                    CornerRadius="4"
                    Foreground="{DynamicResource MainTextColor}"
                    Icon="{StaticResource AddFolderImage}"
                    IconHeight="16"
                    IconMargin="5,0,10,0"
                    IconWidth="16"
                    Text="{CompiledBinding Translation.AddFolder}" />

            </StackPanel>

            <!--  add files log  -->
            <Border
                x:Name="FileLogHeaderBorder"
                Margin="10,0"
                Background="{DynamicResource LogPanelHeaderColor}"
                BorderBrush="{DynamicResource LogPanelBorderColor}"
                BorderThickness="1"
                CornerRadius="4,4,0,0"
                DockPanel.Dock="Top"
                IsVisible="{Binding Path=IsSelected, ElementName=SelectFilesTabItem}">

                <!--  Files panel header  -->
                <DockPanel VerticalAlignment="Top" LastChildFill="True">
                    <Button
                        x:Name="UnSelectAllButton"
                        Padding="10,2,10,2"
                        Classes="errorHover focus"
                        Command="{CompiledBinding BatchResize.RemoveAllCommand}"
                        CornerRadius="0,4,0,0"
                        DockPanel.Dock="Right">
                        <TextBlock Classes="txt" Text="{CompiledBinding Translation.RemoveAll.Value, Mode=OneWay}" />
                    </Button>

                    <!--  Filter  -->
                    <Panel DockPanel.Dock="Left">

                        <Image
                            Width="14"
                            Height="14"
                            Margin="15,0,0,0"
                            HorizontalAlignment="Left"
                            Source="{StaticResource SearchImage}" />

                        <TextBox
                            x:Name="FilterBox"
                            Padding="50,7,4,7"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            FontFamily="/Assets/Fonts/Roboto-Regular.ttf#Roboto"
                            Foreground="{DynamicResource MainTextColor}"
                            PlaceholderText="{CompiledBinding Translation.Filter.Value,
                                                              Mode=OneWay}"
                            Text="{CompiledBinding BatchResize.FilterText.Value,
                                                   FallbackValue='',
                                                   Mode=TwoWay}" />

                        <!--  File count  -->
                        <StackPanel
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right"
                            IsVisible="{Binding Path=!IsVisible, ElementName=ClearButton}"
                            Orientation="Horizontal">
                            <TextBlock
                                Classes="txt"
                                Foreground="{DynamicResource MainTextColorFaded}"
                                Text="{CompiledBinding BatchResize.SelectedFiles.Value.Count}" />
                            <TextBlock Classes="txt" Text=" " />
                            <TextBlock
                                Classes="txt"
                                Foreground="{DynamicResource MainTextColorFaded}"
                                Text="{CompiledBinding Translation.Files}" />
                        </StackPanel>

                        <!--  clear  -->
                        <customControls:IconButton
                            x:Name="ClearButton"
                            Padding="10,3,10,3"
                            HorizontalAlignment="Right"
                            Classes="altHover"
                            Command="{CompiledBinding BatchResize.ClearFilterCommand}"
                            Data="{StaticResource CloseGeometry}"
                            DockPanel.Dock="Right"
                            Foreground="{DynamicResource MainTextColorFaded}"
                            IconHeight="12"
                            IconWidth="12"
                            IsVisible="{CompiledBinding BatchResize.FilterText.Value,
                                                        Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />


                    </Panel>
                </DockPanel>
            </Border>
            <!--  Add Files panel log  -->
            <Border
                x:Name="FilePanelLogBorder"
                Margin="10,0,10,75"
                Background="{DynamicResource LogPanelBackgroundColor}"
                BorderBrush="{DynamicResource LogPanelBorderColor}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,4,4"
                DockPanel.Dock="Top"
                DragDrop.AllowDrop="True"
                IsVisible="{Binding Path=IsSelected, ElementName=SelectFilesTabItem}">
                <Panel>
                    <customControls:AutoScrollViewer IsVisible="{CompiledBinding !BatchResize.IsFiltering.Value}">
                        <ItemsControl ItemsSource="{CompiledBinding BatchResize.SelectedFiles.Value}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <customControls:IconButton
                                            Padding="16,12"
                                            Background="Transparent"
                                            Classes="errorHover"
                                            Command="{Binding #MainTabControl.((viewModels:CoreViewModel)DataContext).BatchResize.RemoveFileFromListCommand}"
                                            CommandParameter="{Binding}"
                                            Data="{StaticResource CloseGeometry}"
                                            DockPanel.Dock="Left"
                                            IconHeight="12"
                                            IconWidth="12" />
                                        <Button
                                            Background="Transparent"
                                            Classes="MenuItemHover"
                                            DockPanel.Dock="Right">
                                            <TextBlock
                                                Margin="10,0"
                                                Classes="txt"
                                                Text="{Binding Name}" />
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </customControls:AutoScrollViewer>
                    <customControls:AutoScrollViewer IsVisible="{CompiledBinding BatchResize.IsFiltering.Value}">
                        <ItemsControl ItemsSource="{CompiledBinding BatchResize.FilteredFiles.Value}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <customControls:IconButton
                                            Padding="16,12"
                                            Background="Transparent"
                                            Classes="errorHover"
                                            Command="{Binding #MainTabControl.((viewModels:CoreViewModel)DataContext).BatchResize.RemoveFileFromListCommand}"
                                            CommandParameter="{Binding}"
                                            Data="{StaticResource CloseGeometry}"
                                            DockPanel.Dock="Left"
                                            IconHeight="12"
                                            IconWidth="12" />
                                        <Button
                                            Background="Transparent"
                                            Classes="MenuItemHover"
                                            DockPanel.Dock="Right">
                                            <TextBlock
                                                Margin="10,0"
                                                Classes="txt"
                                                Text="{Binding Name}" />
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </customControls:AutoScrollViewer>
                </Panel>
            </Border>

            <!--  Main output folder  -->
            <DockPanel
                Height="36"
                Margin="0,-85,0,0"
                DockPanel.Dock="Top"
                IsVisible="{Binding Path=IsSelected, ElementName=SelectFilesTabItem}"
                LastChildFill="True">
                <TextBlock
                    Margin="15,0,5,0"
                    VerticalAlignment="Center"
                    Classes="txt"
                    DockPanel.Dock="Left"
                    Text="{CompiledBinding Translation.OutputFolder.Value,
                                           Mode=OneWay}" />

                <customControls:IconButton
                    x:Name="OutputFolderButton"
                    Width="30"
                    Margin="5,0,10,0"
                    Background="Transparent"
                    Classes="MenuItemHover"
                    ClickMode="Release"
                    Command="{CompiledBinding BatchResize.PickOutputFolderCommand}"
                    CornerRadius="4"
                    Data="{StaticResource FolderGeometry}"
                    DockPanel.Dock="Right"
                    Foreground="{DynamicResource MainTextColor}"
                    IconHeight="20"
                    IconWidth="20"
                    IsRepeatEnabled="False" />
                <customControls:FuncTextBox
                    x:Name="OutputFolderTextBox"
                    MinWidth="252"
                    Classes="TStyle"
                    DockPanel.Dock="Left"
                    Text="{CompiledBinding BatchResize.OutputFolder.Value,
                                           Mode=TwoWay}" />
            </DockPanel>


            <!--  Resize settings  -->
            <customControls:AutoScrollViewer
                x:Name="ResizeSettingsContainer"
                Margin="10,15"
                DockPanel.Dock="Top"
                IsVisible="{Binding Path=IsSelected, ElementName=ResizeSettingsTabItem}">
                <StackPanel HorizontalAlignment="Center" Spacing="15">

                    <!--  Compression  -->
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Width="130"
                            Margin="5,0,0,0"
                            Classes="txt"
                            Foreground="{DynamicResource MainTextColor}"
                            Text="{CompiledBinding Translation.Compression.Value,
                                                   Mode=OneWay}" />
                        <ComboBox
                            Width="252"
                            Height="30"
                            Margin="10,0,0,0"
                            Padding="5,7,0,7"
                            Background="{DynamicResource ToolWindowButtonBackground}"
                            BorderBrush="{DynamicResource ToolWindowButtonBorderColor}"
                            BorderThickness="1"
                            CornerRadius="2"
                            DisplayMemberBinding="{Binding Label}"
                            FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                            Foreground="{DynamicResource MainTextColor}"
                            ItemsSource="{CompiledBinding BatchResize.CompressionChoices}"
                            SelectedValue="{CompiledBinding BatchResize.Compression.Value,
                                                            Mode=TwoWay}"
                            SelectedValueBinding="{Binding Value}" />
                    </StackPanel>

                    <!--  Quality  -->
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Width="130"
                            Margin="5,0,0,0"
                            Classes="txt"
                            IsEnabled="{CompiledBinding BatchResize.IsQualityEnabled.Value}"
                            Text="{CompiledBinding Translation.Quality.Value,
                                                   Mode=OneWay}" />
                        <CheckBox
                            Margin="10,0,6,0"
                            Classes="altHover"
                            IsChecked="{CompiledBinding BatchResize.IsQualityEnabled.Value,
                                                        Mode=TwoWay}" />
                        <customControls:CustomSlider
                            Width="170"
                            Height="10"
                            Margin="0,0,10,2"
                            IsEnabled="{CompiledBinding BatchResize.IsQualityEnabled.Value}"
                            IsSnapToTickEnabled="True"
                            Maximum="100"
                            Minimum="1"
                            TickFrequency="1"
                            Value="{CompiledBinding BatchResize.Quality.Value,
                                                    Mode=TwoWay}" />
                        <TextBlock
                            Margin="10,0,0,3"
                            Classes="txt"
                            IsEnabled="{CompiledBinding BatchResize.IsQualityEnabled.Value}"
                            Text="{CompiledBinding BatchResize.Quality.Value}" />
                    </StackPanel>

                    <!--  Convert to  -->
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Width="130"
                            Margin="5,0,0,0"
                            Classes="txt"
                            Text="{CompiledBinding Translation.ConvertTo.Value,
                                                   Mode=OneWay}" />
                        <ComboBox
                            Width="252"
                            Margin="11,0,0,0"
                            Padding="5,7,0,7"
                            Background="{DynamicResource ToolWindowButtonBackground}"
                            BorderBrush="{DynamicResource ToolWindowButtonBorderColor}"
                            BorderThickness="1"
                            CornerRadius="2"
                            DisplayMemberBinding="{Binding Label}"
                            FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                            Foreground="{DynamicResource MainTextColor}"
                            ItemsSource="{CompiledBinding BatchResize.ConversionChoices}"
                            SelectedValue="{CompiledBinding BatchResize.Conversion.Value,
                                                            Mode=TwoWay}"
                            SelectedValueBinding="{Binding Value}" />
                    </StackPanel>

                    <!--  Resize  -->
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Width="130"
                            Margin="5,0,0,0"
                            Classes="txt"
                            Text="{CompiledBinding Translation.Resize.Value,
                                                   Mode=OneWay}" />
                        <ComboBox
                            Width="252"
                            Height="30"
                            Margin="10,0,0,0"
                            Padding="5,7,0,7"
                            Background="{DynamicResource ToolWindowButtonBackground}"
                            BorderBrush="{DynamicResource ToolWindowButtonBorderColor}"
                            BorderThickness="1"
                            CornerRadius="2"
                            DisplayMemberBinding="{Binding Label}"
                            FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                            Foreground="{DynamicResource MainTextColor}"
                            ItemsSource="{CompiledBinding BatchResize.ResizeChoices}"
                            SelectedValue="{CompiledBinding BatchResize.Resize.Value,
                                                            Mode=TwoWay}"
                            SelectedValueBinding="{Binding Value}" />
                    </StackPanel>

                    <!--  Percentage  -->
                    <StackPanel
                        Margin="10,0,0,0"
                        HorizontalAlignment="Center"
                        IsVisible="{CompiledBinding BatchResize.IsPercentageResizing.Value}"
                        Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                Margin="5,0,0,0"
                                Classes="txt"
                                FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                                Text="{CompiledBinding Translation.Percentage.Value,
                                                       Mode=OneWay}" />
                            <customControls:FuncTextBox
                                Width="130"
                                Classes="hover TStyle"
                                Text="{CompiledBinding BatchResize.Percentage.Value,
                                                       Mode=TwoWay}" />
                        </StackPanel>

                        <Image
                            Width="12"
                            Height="12"
                            Margin="15,0"
                            Source="{StaticResource PercentageIcon}" />
                    </StackPanel>

                    <!--  Width and height adjustment  -->
                    <StackPanel
                        Margin="10,0,0,0"
                        HorizontalAlignment="Center"
                        IsVisible="{CompiledBinding BatchResize.IsWidthAndHeightResizing.Value}"
                        Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                Margin="5,0,0,0"
                                Classes="txt"
                                FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                                Text="{CompiledBinding Translation.Width.Value,
                                                       Mode=OneWay}" />
                            <customControls:NumTextBox
                                Width="110"
                                Height="35"
                                MinWidth="100"
                                Margin="0"
                                Background="{DynamicResource SecondaryBackgroundColor}"
                                Classes="hover TStyle"
                                CornerRadius="4"
                                Foreground="{DynamicResource MainTextColor}"
                                Text="{CompiledBinding BatchResize.Width.Value,
                                                       Mode=TwoWay}" />
                        </StackPanel>

                        <Button
                            Width="38"
                            Height="35"
                            Margin="15,0"
                            Background="Transparent"
                            Classes="altHover"
                            Command="{CompiledBinding BatchResize.ToggleAspectRatioCommand}"
                            Foreground="{DynamicResource MainTextColor}">
                            <Panel>
                                <Image
                                    Width="21"
                                    Height="21"
                                    IsVisible="{CompiledBinding !BatchResize.IsKeepingAspectRatio.Value}"
                                    Source="{StaticResource UnlinkChainImage}" />
                                <Image
                                    Width="21"
                                    Height="21"
                                    IsVisible="{CompiledBinding BatchResize.IsKeepingAspectRatio.Value}"
                                    Source="{StaticResource LinkChainImage}" />
                            </Panel>
                        </Button>

                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <TextBlock
                                Margin="5,0,0,0"
                                Classes="txt"
                                FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                                Text="{CompiledBinding Translation.Height.Value,
                                                       Mode=OneWay}" />
                            <customControls:NumTextBox
                                Width="110"
                                Height="35"
                                MinWidth="100"
                                Margin="0"
                                Background="{DynamicResource SecondaryBackgroundColor}"
                                Classes="hover TStyle"
                                CornerRadius="4"
                                Foreground="{DynamicResource MainTextColor}"
                                Text="{CompiledBinding BatchResize.Height.Value,
                                                       Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Width  -->
                    <StackPanel
                        Margin="10,0,0,0"
                        HorizontalAlignment="Center"
                        IsVisible="{CompiledBinding BatchResize.IsWidthResizing.Value}"
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock
                            Margin="5,0,0,0"
                            Classes="txt"
                            FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                            Text="{CompiledBinding Translation.Width.Value,
                                                   Mode=OneWay}" />
                        <customControls:NumTextBox
                            Width="175"
                            Height="35"
                            MinWidth="60"
                            Margin="0"
                            Background="{DynamicResource SecondaryBackgroundColor}"
                            Classes="hover TStyle"
                            CornerRadius="4"
                            Foreground="{DynamicResource MainTextColor}"
                            Text="{CompiledBinding BatchResize.Width.Value,
                                                   Mode=TwoWay}" />
                    </StackPanel>

                    <!--  Height  -->
                    <StackPanel
                        Margin="10,0,0,0"
                        HorizontalAlignment="Center"
                        IsVisible="{CompiledBinding BatchResize.IsHeightResizing.Value}"
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock
                            Margin="5,0,0,0"
                            Classes="txt"
                            FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                            Text="{CompiledBinding Translation.Height.Value,
                                                   Mode=OneWay}" />
                        <customControls:NumTextBox
                            Width="175"
                            Height="35"
                            MinWidth="60"
                            Margin="0"
                            Background="{DynamicResource SecondaryBackgroundColor}"
                            Classes="hover TStyle"
                            CornerRadius="4"
                            Foreground="{DynamicResource MainTextColor}"
                            Text="{CompiledBinding BatchResize.Height.Value,
                                                   Mode=TwoWay}" />
                    </StackPanel>

                </StackPanel>
            </customControls:AutoScrollViewer>

            <!--  Generate thumbnails  -->
            <customControls:AutoScrollViewer
                x:Name="ThumbnailTabContainer"
                Margin="0,0,0,20"
                DockPanel.Dock="Top"
                IsVisible="{Binding Path=IsSelected, ElementName=ThumbnailTabItem}">
                <StackPanel Margin="15,5">

                    <StackPanel
                        Margin="0,10"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Width="130"
                            Margin="5,0,0,0"
                            Classes="txt"
                            Text="{CompiledBinding Translation.GenerateThumbnails.Value,
                                                   Mode=OneWay}" />
                        <ComboBox
                            Width="240"
                            Height="30"
                            Margin="11,0,10,0"
                            Padding="5,7,0,7"
                            Background="{DynamicResource ToolWindowButtonBackground}"
                            BorderBrush="{DynamicResource ToolWindowButtonBorderColor}"
                            BorderThickness="1"
                            CornerRadius="2"
                            DisplayMemberBinding="{Binding Label}"
                            FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                            Foreground="{DynamicResource MainTextColor}"
                            ItemsSource="{CompiledBinding BatchResize.ThumbnailAmountChoices}"
                            MaxDropDownHeight="300"
                            SelectedValue="{CompiledBinding BatchResize.ThumbnailAmount.Value,
                                                            Mode=TwoWay}"
                            SelectedValueBinding="{Binding Value}" />
                    </StackPanel>

                    <ItemsControl HorizontalAlignment="Center" ItemsSource="{CompiledBinding BatchResize.Thumbnails}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:BatchThumbnailRow">
                                <StackPanel>
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            Width="130"
                                            Margin="8,0,0,0"
                                            Classes="txt">
                                            <Run Text="{CompiledBinding #MainTabControl.((viewModels:CoreViewModel)DataContext).Translation.Thumbnail.Value, Mode=OneWay}" />
                                            <Run Text="{CompiledBinding Number, Mode=OneWay}" />
                                            <LineBreak />
                                            <Run Text="{CompiledBinding #MainTabControl.((viewModels:CoreViewModel)DataContext).Translation.OutputFolder.Value, Mode=OneWay}" />
                                        </TextBlock>
                                        <customControls:FuncTextBox
                                            Width="410"
                                            Margin="4,0,10,0"
                                            Classes="hover TStyle"
                                            Text="{CompiledBinding Subfolder.Value,
                                                                   Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel Margin="4,10,0,15" Orientation="Horizontal">
                                        <TextBlock
                                            Width="125"
                                            Margin="8,0,0,0"
                                            Classes="txt"
                                            Text="{CompiledBinding #MainTabControl.((viewModels:CoreViewModel)DataContext).Translation.Resize.Value,
                                                                   Mode=OneWay}" />
                                        <ComboBox
                                            Width="195"
                                            Height="30"
                                            Margin="6,0,10,0"
                                            Padding="5,7,0,7"
                                            Background="{DynamicResource ToolWindowButtonBackground}"
                                            BorderBrush="{DynamicResource ToolWindowButtonBorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            DisplayMemberBinding="{Binding Label}"
                                            FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                                            Foreground="{DynamicResource MainTextColor}"
                                            ItemsSource="{CompiledBinding SizeChoices}"
                                            SelectedValue="{CompiledBinding Size.Value,
                                                                            Mode=TwoWay}"
                                            SelectedValueBinding="{Binding Value}" />
                                        <customControls:FuncTextBox
                                            Width="200"
                                            Classes="hover TStyle"
                                            Text="{CompiledBinding Value.Value,
                                                                   Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </customControls:AutoScrollViewer>

            <DockPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                DockPanel.Dock="Bottom">

                <Button
                    x:Name="CancelButton"
                    Width="NaN"
                    Height="35"
                    Padding="10"
                    Background="{DynamicResource WindowButtonBackgroundColor}"
                    BorderBrush="{DynamicResource TitleBarButtonBorder}"
                    BorderThickness="1"
                    Classes="ToolButtonHover"
                    CornerRadius="4"
                    DockPanel.Dock="Left"
                    IsVisible="True">
                    <TextBlock
                        Padding="15,0"
                        Classes="txt"
                        Text="{CompiledBinding Translation.Cancel.Value,
                                               Mode=OneWay}"
                        TextAlignment="Center" />
                </Button>

                <Button
                    x:Name="ResetButton"
                    Width="NaN"
                    Height="35"
                    Padding="10"
                    Background="{DynamicResource WindowButtonBackgroundColor}"
                    BorderBrush="{DynamicResource TitleBarButtonBorder}"
                    BorderThickness="1"
                    Classes="ToolButtonHover"
                    CornerRadius="4"
                    DockPanel.Dock="Left"
                    IsVisible="False">
                    <TextBlock
                        x:Name="ResetButtonTextBlock"
                        Padding="15,0"
                        Classes="txt"
                        Text="{CompiledBinding Translation.Reset.Value,
                                               Mode=OneWay}"
                        TextAlignment="Center" />
                </Button>

                <Button
                    x:Name="StartButton"
                    Width="NaN"
                    Height="35"
                    Margin="5,0,0,0"
                    Padding="10"
                    Background="{DynamicResource AccentColor}"
                    BorderThickness="1"
                    Classes="PrimaryBtnHover"
                    Command="{CompiledBinding BatchResize.StartCommand}"
                    CornerRadius="4"
                    DockPanel.Dock="Right">
                    <TextBlock
                        Padding="15,0"
                        Classes="txt"
                        Foreground="{StaticResource SecondaryTextColor}"
                        Text="{CompiledBinding Translation.Start.Value,
                                               Mode=OneWay}"
                        TextAlignment="Center" />
                </Button>
            </DockPanel>

        </DockPanel>

        <Path
            Width="12"
            Height="12"
            Margin="0,0,5,-22"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Data="{StaticResource GripGeometry}"
            Fill="{DynamicResource BottomBarForegroundColor}"
            Stretch="Fill"
            Stroke="{DynamicResource BottomBarBorderColor}"
            StrokeThickness="1"
            WindowDecorationProperties.ElementRole="ResizeSE" />
    </Panel>

</UserControl>
