<UserControl
    x:Class="PicView.Avalonia.Views.Config.WindowSettingsView"
    x:DataType="viewModels:CoreViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:keybindings="using:PicView.Core.Keybindings"
    xmlns:ui="clr-namespace:PicView.Avalonia.UI"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel HorizontalAlignment="Center">

        <StackPanel Classes="searchHeader">
            <Image
                Height="18"
                Source="{StaticResource WindowImage}"
                Width="18" />
            <TextBlock
                Classes="txt bold"
                Margin="0,20,0,20"
                Text="{CompiledBinding Translation.Window.Value,
                                       Mode=OneWay}" />
        </StackPanel>

        <Border Classes="searchBorder" ui:SearchProperties.Keywords="{CompiledBinding SettingsViewModel.SearchData.Value.WindowScalingSearchTags}">
            <StackPanel>
                <TextBlock
                    Classes="txt bold"
                    Margin="0,20,0,20"
                    Text="{CompiledBinding Translation.WindowScaling.Value,
                                           Mode=OneWay}" />

                <!--  Auto fit  -->
                <customControls:TextToggleButton
                    Classes="MenuItemHover settingsToggleButton"
                    Command="{CompiledBinding MainWindows.ActiveWindow.Value.RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.AutoFitWindow}"
                    IsChecked="{CompiledBinding MainWindows.ActiveWindow.Value.IsAutoFit.Value,
                                                Mode=OneWay}"
                    Text="{CompiledBinding Translation.AutoFitWindow.Value,
                                           Mode=OneWay}"
                    x:Name="AutoFitToggleButton" />

                <!--  Window spacing  -->
                <TextBlock
                    Classes="txt bold"
                    IsEnabled="{CompiledBinding MainWindows.ActiveWindow.Value.IsAutoFit.Value}"
                    Margin="0,10,0,10"
                    MaxWidth="300"
                    Text="{CompiledBinding Translation.WindowMargin.Value,
                                           Mode=OneWay}" />
                <customControls:CustomSlider
                    Height="30"
                    HorizontalAlignment="Center"
                    IsEnabled="{CompiledBinding MainWindows.ActiveWindow.Value.IsAutoFit.Value}"
                    IsSnapToTickEnabled="True"
                    Margin="0,1,0,1"
                    Maximum="100"
                    Minimum="0"
                    TickFrequency="1"
                    TickPlacement="BottomRight"
                    Value="{CompiledBinding SettingsViewModel.WindowMargin.Value}"
                    Width="300" />
                <TextBlock
                    Classes="txt"
                    FontFamily="/Assets/Fonts/Roboto-Bold.ttf#Roboto"
                    Foreground="{StaticResource MainTextColorFaded}"
                    IsEnabled="{CompiledBinding MainWindows.ActiveWindow.Value.IsAutoFit.Value}"
                    Margin="0,0,0,15"
                    Text="{CompiledBinding SettingsViewModel.WindowMargin.Value,
                                           Mode=OneWay}" />
            </StackPanel>
        </Border>

        <TextBlock
            Classes="txt bold searchHeader"
            Margin="0,20,0,20"
            Text="{CompiledBinding Translation.WindowManagement.Value,
                                   Mode=OneWay}" />

        <Border Classes="searchBorder" ui:SearchProperties.Keywords="{CompiledBinding SettingsViewModel.SearchData.Value.WindowSameWindowSearchTags}">
            <ComboBox
                BorderThickness="1"
                FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                Foreground="{DynamicResource MainTextColor}"
                HorizontalAlignment="Left"
                Margin="0,6,0,10"
                Padding="5,7,0,7"
                SelectedIndex="{CompiledBinding GlobalSettings.OpeningModeIndex.Value,
                                                Mode=TwoWay}"
                Width="300"
                x:Name="OpeningModeBox">
                <ComboBoxItem Content="{CompiledBinding Translation.OpenInNewWindow.Value, Mode=OneWay}" Foreground="{DynamicResource MainTextColor}" />
                <ComboBoxItem Content="{CompiledBinding Translation.OpenInSameWindow.Value, Mode=OneWay}" Foreground="{DynamicResource MainTextColor}" />
                <ComboBoxItem Content="{CompiledBinding Translation.OpenInNewTab.Value, Mode=OneWay}" Foreground="{DynamicResource MainTextColor}" />
            </ComboBox>
        </Border>

        <Border Classes="searchBorder" ui:SearchProperties.Keywords="{CompiledBinding SettingsViewModel.SearchData.Value.WindowTopMostSearchTags}">
            <customControls:TextToggleButton
                Classes="MenuItemHover settingsToggleButton"
                Command="{CompiledBinding MainWindows.ActiveWindow.Value.RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.SetTopMost}"
                IsChecked="{CompiledBinding MainWindows.ActiveWindow.Value.WindowSettings.IsTopMost.Value,
                                            Mode=OneWay}"
                Text="{CompiledBinding Translation.StayTopMost.Value,
                                       Mode=OneWay}"
                x:Name="TopMostToggleButton" />
        </Border>

        <Border Classes="searchBorder" ui:SearchProperties.Keywords="{CompiledBinding SettingsViewModel.SearchData.Value.WindowCenteredSearchTags}">
            <customControls:TextToggleButton
                Classes="MenuItemHover settingsToggleButton"
                IsChecked="{CompiledBinding MainWindows.ActiveWindow.Value.WindowSettings.IsStayingCentered.Value,
                                            Mode=TwoWay}"
                IsEnabled="{CompiledBinding MainWindows.ActiveWindow.Value.IsAutoFit.Value}"
                Text="{CompiledBinding Translation.StayCentered.Value,
                                       Mode=OneWay}"
                x:Name="StayCenteredToggleButton" />
        </Border>

        <Border Classes="searchBorder" ui:SearchProperties.Keywords="{CompiledBinding SettingsViewModel.SearchData.Value.WindowEscSearchTags}">
            <customControls:TextToggleButton
                Classes="MenuItemHover settingsToggleButton"
                IsChecked="{CompiledBinding SettingsViewModel.IsShowingConfirmationOnEsc.Value}"
                Text="{CompiledBinding Translation.ShowConfirmationOnEsc.Value,
                                       Mode=OneWay}"
                x:Name="ShowConfirmationEscToggleButton" />
        </Border>

        <Border Classes="searchBorder" ui:SearchProperties.Keywords="{CompiledBinding SettingsViewModel.SearchData.Value.WindowEscFullscreenSearchTags}">
            <customControls:TextToggleButton
                Classes="MenuItemHover settingsToggleButton"
                IsChecked="{CompiledBinding SettingsViewModel.IsEscLeavingFullscreen.Value}"
                Text="{CompiledBinding Translation.EscLeavesFullscreen.Value,
                                       Mode=OneWay}"
                x:Name="EscLeavesFullscreenToggleButton" />
        </Border>

    </StackPanel>
</UserControl>