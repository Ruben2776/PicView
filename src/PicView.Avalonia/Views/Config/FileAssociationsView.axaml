<UserControl
    Focusable="True"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="PicView.Avalonia.Views.Config.FileAssociationsView"
    x:DataType="viewModels:CoreViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:keybindings="using:PicView.Core.Keybindings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center">

        <Border Classes="searchBorder">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Image
                        Height="18"
                        Source="{StaticResource FileAssociationImage}"
                        Width="18" />
                    <TextBlock
                        Classes="txt bold searchHeader"
                        Margin="0,20,0,20"
                        Text="{CompiledBinding Translation.FileAssociations.Value,
                                               Mode=OneWay}" />
                </StackPanel>
                <customControls:TextIconButton
                    Background="{DynamicResource MenuBackgroundColor}"
                    BorderBrush="{DynamicResource MenuBorderColor}"
                    BorderThickness="1"
                    Classes="MenuItemHover"
                    Command="{Binding MainWindows.ActiveWindow.Value.RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.FileAssociationsWindow}"
                    CornerRadius="4"
                    Foreground="{DynamicResource MainTextColor}"
                    HorizontalAlignment="Center"
                    Icon="{StaticResource FileAssociationImage}"
                    IconHeight="18"
                    IconMargin="5,5,10,5"
                    IconWidth="18"
                    Padding="6"
                    Text="{Binding Translation.FileAssociations.Value}"
                    Width="300"
                    x:Name="KeyBindingsButton" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
