<!--  The one context menu that every Gallery Item of a gallery view shares. The view creates it on the first right-click  -->
<ContextMenu
    x:Class="PicView.Avalonia.Views.Gallery.GalleryItemContextMenu"
    x:DataType="viewModels:GalleryItemViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:gallerySettings="clr-namespace:PicView.Core.Gallery;assembly=PicView.Core"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Open with  -->
    <customControls:StyledMenuItem
        Click="OpenWith_OnClick"
        Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.OpenWith.Value,
                                 Mode=OneWay}"
        x:Name="OpenWith">
        <MenuItem.Icon>
            <Image
                Height="12"
                Source="{StaticResource OpenExternalImage}"
                Width="12" />
        </MenuItem.Icon>
    </customControls:StyledMenuItem>

    <!--  Locate on disk  -->
    <customControls:StyledMenuItem
        Click="LocateOnDisk_OnClick"
        Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.ShowInFolder.Value,
                                 Mode=OneWay}"
        x:Name="LocateOnDisk">
        <MenuItem.Icon>
            <Path Classes="ShowInFolderPath" />
        </MenuItem.Icon>
    </customControls:StyledMenuItem>
    <Separator />

    <!--  Set as wallpaper  -->
    <customControls:StyledMenuItem Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.SetAsWallpaper.Value, Mode=OneWay}" x:Name="WallpaperMenuItem">
        <MenuItem.Icon>
            <Image Classes="WallpaperImage" />
        </MenuItem.Icon>

        <!--  Set as wallpaper filled  -->
        <customControls:StyledMenuItem
            Click="WallpaperFilled_OnClick"
            Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Fill.Value,
                                     Mode=OneWay}"
            x:Name="WallpaperFilled">
            <MenuItem.Icon>
                <Image Classes="WallpaperImage" />
            </MenuItem.Icon>
        </customControls:StyledMenuItem>

        <!--  Set as wallpaper fit  -->
        <customControls:StyledMenuItem
            Click="WallpaperFitted_OnClick"
            Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Fit.Value,
                                     Mode=OneWay}"
            x:Name="WallpaperFitted">
            <MenuItem.Icon>
                <Image Classes="WallpaperImage" />
            </MenuItem.Icon>
        </customControls:StyledMenuItem>

        <!--  Set as wallpaper stretched  -->
        <customControls:StyledMenuItem
            Click="WallpaperStretched_OnClick"
            Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Stretch.Value,
                                     Mode=OneWay}"
            x:Name="WallpaperStretched">
            <MenuItem.Icon>
                <Image Classes="WallpaperImage" />
            </MenuItem.Icon>
        </customControls:StyledMenuItem>


        <!--  Set as wallpaper centered  -->
        <customControls:StyledMenuItem
            Click="WallpaperCentered_OnClick"
            Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Center.Value,
                                     Mode=OneWay}"
            x:Name="WallpaperCentered">
            <MenuItem.Icon>
                <Image Classes="WallpaperImage" />
            </MenuItem.Icon>
        </customControls:StyledMenuItem>

        <!--  Set as wallpaper tiled  -->
        <customControls:StyledMenuItem
            Click="WallpaperTiled_OnClick"
            Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Tile.Value,
                                     Mode=OneWay}"
            x:Name="WallpaperTiled">
            <MenuItem.Icon>
                <Image Classes="WallpaperImage" />
            </MenuItem.Icon>
        </customControls:StyledMenuItem>

        <!--  Set as lockscreen  -->
        <Separator x:Name="LockscreenSeparator" />
        <customControls:StyledMenuItem Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.SetAsLockScreenImage.Value, Mode=OneWay}" Click="Lockscreen_OnClick" x:Name="LockscreenItem">
            <MenuItem.Icon>
                <Image Classes="WallpaperImage" />
            </MenuItem.Icon>
        </customControls:StyledMenuItem>
    </customControls:StyledMenuItem>

    <customControls:StyledMenuItem
        Click="CopyFile_OnClick"
        Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.CopyFile.Value,
                                 Mode=OneWay}"
        x:Name="CopyFile">
        <MenuItem.Icon>
            <Path
                Data="{StaticResource CopyGeometry}"
                Fill="{DynamicResource MainTextColor}"
                Height="12"
                Stretch="Fill"
                Width="12" />
        </MenuItem.Icon>
    </customControls:StyledMenuItem>

    <customControls:StyledMenuItem
        Click="CopyImage_OnClick"
        Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.CopyImage.Value,
                                 Mode=OneWay}"
        x:Name="CopyImage">
        <MenuItem.Icon>
            <Path
                Data="{StaticResource CopyGeometry}"
                Fill="{DynamicResource MainTextColor}"
                Height="12"
                Stretch="Fill"
                Width="12" />
        </MenuItem.Icon>
    </customControls:StyledMenuItem>

    <customControls:StyledMenuItem Click="CopyBase64_OnClick" x:Name="CopyBase64">
        <MenuItem.Header>
            <TextBlock>
                <Run Text="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Copy.Value, Mode=OneWay}" />
                <Run Text=" base64" />
            </TextBlock>
        </MenuItem.Header>
        <MenuItem.Icon>
            <Path
                Data="{StaticResource CopyGeometry}"
                Fill="{DynamicResource MainTextColor}"
                Height="12"
                Stretch="Fill"
                Width="12" />
        </MenuItem.Icon>
    </customControls:StyledMenuItem>

    <customControls:StyledMenuItem
        Click="DuplicateFile_OnClick"
        Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.DuplicateFile.Value,
                                 Mode=OneWay}"
        x:Name="DuplicateFile">
        <MenuItem.Icon>
            <Path
                Data="{StaticResource CopyGeometry}"
                Fill="{DynamicResource MainTextColor}"
                Height="12"
                Stretch="Fill"
                Width="12" />
        </MenuItem.Icon>
    </customControls:StyledMenuItem>

    <Separator />

    <customControls:StyledMenuItem
        Click="DeleteFile_OnClick"
        Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.DeleteFile.Value,
                                 Mode=OneWay}"
        x:Name="DeleteFile">
        <MenuItem.Icon>
            <Path
                Data="{StaticResource RecycleGeometry}"
                Fill="{DynamicResource MainTextColor}"
                Height="12"
                Stretch="Fill"
                Width="12" />
        </MenuItem.Icon>
    </customControls:StyledMenuItem>
    <Separator />

    <!--  Expanded menu items  -->
    <customControls:StyledMenuItem
        Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.GalleryDisplayMode.Value, Mode=OneWay}"
        IsVisible="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowTabs.ActiveTab.Value.Gallery.IsGalleryExpanded.Value}"
        x:Name="ItemDisplayModeMenuItem">
        <MenuItem.Icon>
            <Image
                Height="12"
                Source="{StaticResource GalleryImage}"
                Width="12" />
        </MenuItem.Icon>
        <customControls:StyledMenuItem
            Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.SetExpandedDisplayModeCommand}"
            CommandParameter="{x:Static gallerySettings:GalleryDisplayMode.Columns}"
            Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Columns.Value, Mode=OneWay}"
            IsChecked="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.IsExpandedDisplayModeColumns.Value, Mode=OneWay}"
            ToggleType="Radio" />
        <customControls:StyledMenuItem
            Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.SetExpandedDisplayModeCommand}"
            CommandParameter="{x:Static gallerySettings:GalleryDisplayMode.Masonry}"
            Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Masonry.Value, Mode=OneWay}"
            IsChecked="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.IsExpandedDisplayModeMasonry.Value, Mode=OneWay}"
            ToggleType="Radio" />
        <customControls:StyledMenuItem
            Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.SetExpandedDisplayModeCommand}"
            CommandParameter="{x:Static gallerySettings:GalleryDisplayMode.Rows}"
            Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Rows.Value, Mode=OneWay}"
            IsChecked="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.IsExpandedDisplayModeRows.Value, Mode=OneWay}"
            ToggleType="Radio" />
    </customControls:StyledMenuItem>
    <customControls:StyledMenuItem Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Stretch.Value, Mode=OneWay}" x:Name="ItemExpandedStretchMenuItem">
        <MenuItem.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="$parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowTabs.ActiveTab.Value.Gallery.IsGalleryExpanded.Value" />
                <Binding Path="$parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.IsExpandedDisplayModeColumns.Value" />
            </MultiBinding>
        </MenuItem.IsVisible>
        <MenuItem.Icon>
            <Image Classes="SquareDimensionsImage" />
        </MenuItem.Icon>
        <customControls:StyledMenuItem
            Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.SetExpandedStretchModeCommand}"
            CommandParameter="{x:Static gallerySettings:GalleryStretchMode.Uniform}"
            Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Uniform.Value, Mode=OneWay}"
            IsChecked="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.IsExpandedStretchUniform.Value, Mode=OneWay}"
            ToggleType="Radio" />
        <customControls:StyledMenuItem
            Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.SetExpandedStretchModeCommand}"
            CommandParameter="{x:Static gallerySettings:GalleryStretchMode.UniformToFill}"
            Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.UniformToFill.Value, Mode=OneWay}"
            IsChecked="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.IsExpandedStretchUniformToFill.Value, Mode=OneWay}"
            ToggleType="Radio" />
        <customControls:StyledMenuItem
            Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.SetExpandedStretchModeCommand}"
            CommandParameter="{x:Static gallerySettings:GalleryStretchMode.Square}"
            Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Square.Value, Mode=OneWay}"
            IsChecked="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.IsExpandedStretchSquare.Value, Mode=OneWay}"
            ToggleType="Radio" />
        <customControls:StyledMenuItem
            Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.SetExpandedStretchModeCommand}"
            CommandParameter="{x:Static gallerySettings:GalleryStretchMode.FillSquare}"
            Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.FillSquare.Value, Mode=OneWay}"
            IsChecked="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.IsExpandedStretchSquareFill.Value, Mode=OneWay}"
            ToggleType="Radio" />
    </customControls:StyledMenuItem>

    <!--  Docked menu items  -->
    <customControls:StyledMenuItem Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Stretch.Value, Mode=OneWay}" IsVisible="{CompiledBinding !$parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowTabs.ActiveTab.Value.Gallery.IsGalleryExpanded.Value}">
        <MenuItem.Icon>
            <Image Classes="SquareDimensionsImage" />
        </MenuItem.Icon>
        <customControls:StyledMenuItem
            Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.SetDockedStretchModeCommand}"
            CommandParameter="{x:Static gallerySettings:GalleryStretchMode.Uniform}"
            Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Uniform.Value, Mode=OneWay}"
            IsChecked="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.IsDockedStretchUniform.Value, Mode=OneWay}"
            ToggleType="Radio" />
        <customControls:StyledMenuItem
            Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.SetDockedStretchModeCommand}"
            CommandParameter="{x:Static gallerySettings:GalleryStretchMode.UniformToFill}"
            Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.UniformToFill.Value, Mode=OneWay}"
            IsChecked="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.IsDockedStretchUniformToFill.Value, Mode=OneWay}"
            ToggleType="Radio" />
        <customControls:StyledMenuItem
            Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.SetDockedStretchModeCommand}"
            CommandParameter="{x:Static gallerySettings:GalleryStretchMode.Square}"
            Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.Square.Value, Mode=OneWay}"
            IsChecked="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.IsDockedStretchSquare.Value, Mode=OneWay}"
            ToggleType="Radio" />
        <customControls:StyledMenuItem
            Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.SetDockedStretchModeCommand}"
            CommandParameter="{x:Static gallerySettings:GalleryStretchMode.FillSquare}"
            Header="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.FillSquare.Value, Mode=OneWay}"
            IsChecked="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowSettings.Gallery.IsDockedStretchSquareFill.Value, Mode=OneWay}"
            ToggleType="Radio" />
    </customControls:StyledMenuItem>
    <customControls:StyledMenuItem Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.ExpandedGalleryItemSize.Value, Mode=OneWay}" PointerPressed="ShowGalleryItemSizeSlider">
        <MenuItem.Icon>
            <Image Classes="ScalingImage" />
        </MenuItem.Icon>
    </customControls:StyledMenuItem>

    <Separator />

    <customControls:StyledMenuItem Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowTabs.ActiveTab.Value.Gallery.ToggleExpandedCommand}" Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.ShowImageGallery.Value, Mode=OneWay}">
        <MenuItem.Icon>
            <Path
                Data="{StaticResource GalleryGeometry}"
                Fill="{DynamicResource MainTextColor}"
                Height="12"
                Stretch="Fill"
                Width="12" />
        </MenuItem.Icon>
    </customControls:StyledMenuItem>
    <Separator />
    <customControls:StyledMenuItem
        Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowTabs.ActiveTab.Value.Gallery.ContractCommand}"
        Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.HideDockedGallery.Value,
                                 Mode=OneWay}"
        IsVisible="{CompiledBinding !$parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowTabs.ActiveTab.Value.Gallery.IsGalleryExpanded.Value}">
        <MenuItem.Icon>
            <Path
                Data="{StaticResource CloseGeometry}"
                Fill="{DynamicResource MainTextColor}"
                Height="12"
                Stretch="Fill"
                Width="12" />
        </MenuItem.Icon>
    </customControls:StyledMenuItem>
    <customControls:StyledMenuItem
        Command="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowTabs.ActiveTab.Value.Gallery.ContractCommand}"
        Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.CloseGallery.Value,
                                 Mode=OneWay}"
        IsVisible="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).WindowTabs.ActiveTab.Value.Gallery.IsGalleryExpanded.Value}">
        <MenuItem.Icon>
            <Path
                Data="{StaticResource CloseGeometry}"
                Fill="{DynamicResource MainTextColor}"
                Height="12"
                Stretch="Fill"
                Width="12" />
        </MenuItem.Icon>
    </customControls:StyledMenuItem>
</ContextMenu>
