<customControls:NavigateAbleItem
    x:Class="PicView.Avalonia.Views.Gallery.GalleryItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    x:DataType="viewModels:GalleryItemViewModel"
    Classes="galleryItem">
    <!--  Size, margin, padding, border and background come from the styles in GalleryView.axaml  -->
    <!--  GalleryView.axaml places the tooltip for each layout: above the item unless a style there says otherwise; Masonry and Rows have none  -->
    <Panel
        x:Name="TipHost"
        MinWidth="25"
        MinHeight="25"
        ToolTip.HorizontalOffset="0">
        <customControls:ThumbImage
            x:Name="GalleryImage"
            Source="{Binding Image.Value}"
            Stretch="{CompiledBinding ThumbnailStretch, RelativeSource={RelativeSource FindAncestor, AncestorType=customControls:VirtualizingGallery, Tree=Visual},
                                      Mode=OneWay}" />
        <!--  Motion photo badge  -->
        <Border
            Margin="3"
            Padding="4,3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{DynamicResource GalleryItemBackgroundColor}"
            BorderBrush="{DynamicResource GalleryItemBorderColor}"
            BorderThickness="1"
            CornerRadius="3"
            IsHitTestVisible="False"
            Opacity="0.9">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsMotionPhoto.Value" />
                    <Binding Path="$parent[Window].((viewModels:MainWindowViewModel)DataContext).GallerySettings.ShowMotionPhotoBadges.Value" />
                </MultiBinding>
            </Border.IsVisible>
            <Panel Width="9" Height="9">
                <Path
                    Width="5.45"
                    Height="5.45"
                    Data="{StaticResource LivePhotoRingGeometry}"
                    Stretch="Uniform"
                    Stroke="{DynamicResource MainTextColor}"
                    StrokeThickness="1.7" />
                <Path
                    Data="{StaticResource LivePhotoGlyphGeometry}"
                    Stretch="Uniform"
                    Stroke="{DynamicResource MainTextColor}"
                    StrokeLineCap="Round"
                    StrokeThickness="2" />
            </Panel>
        </Border>
        <ToolTip.Tip>
            <StackPanel MaxWidth="600">
                <TextBlock
                    x:Name="FileName"
                    Margin="2,0,2,6"
                    Classes="txt bold"
                    Foreground="{DynamicResource MainTextColor}"
                    Text="{CompiledBinding FileName}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="FileLocation"
                    Margin="2,0,2,2"
                    Classes="txt"
                    Text="{CompiledBinding FileLocation}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="FileSize"
                    Margin="2,0,2,2"
                    Classes="txt"
                    Text="{CompiledBinding FileSize}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="FileDate"
                    Margin="2,0,2,4"
                    Classes="txt"
                    Text="{CompiledBinding FileDate}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="ImageSize"
                    Margin="2,0,2,4"
                    Classes="txt"
                    Text="{CompiledBinding ImageSize.Value}"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </ToolTip.Tip>
    </Panel>
</customControls:NavigateAbleItem>
