<customControls:AnimatedMenu
    IsOpen="{CompiledBinding TopTitlebarViewModel.DropDownMenu.IsFileMenuVisible.Value}"
    x:Class="PicView.Avalonia.Views.Menu.FileMenu"
    x:DataType="viewModels:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:keybindings="using:PicView.Core.Keybindings">

    <Border Background="Transparent">

        <Grid
            RowDefinitions="Auto,Auto"
            UseLayoutRounding="True"
            Width="361">

            <!--  Main popup body  -->
            <Border
                Background="{DynamicResource MenuBackgroundColor}"
                BorderBrush="{DynamicResource DropMenuSurroundingBorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Grid.Row="0"
                x:Name="MainBorder">

                <Canvas Height="208" Width="359">

                    <Border
                        Background="{DynamicResource DropMenuBackgroundColor}"
                        BorderBrush="{DynamicResource DropMenuBorderColor}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0"
                        Height="47"
                        Width="359"
                        x:Name="TopBorder" />

                    <StackPanel
                        Canvas.Left="-1"
                        Canvas.Top="-1"
                        Orientation="Horizontal"
                        x:Name="TopButtonPanel">

                        <!--  Optimize image  -->
                        <customControls:TextIconButton
                            BorderBrush="{DynamicResource DropMenuBorderColor}"
                            BorderThickness="0,0,1,0"
                            Classes="hover btn"
                            Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.OptimizeImage}"
                            CornerRadius="8,0,0,0"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource PortalImage}"
                            IconHeight="17"
                            IconMargin="15,0,10,0"
                            IconWidth="17"
                            Text="{Binding Translation.OptimizeImage.Value}"
                            ToolTip.Tip="{CompiledBinding Translation.ImageInfo.Value,
                                                          Mode=OneWay}"
                            Width="180" />

                        <!--  Print  -->
                        <customControls:TextIconButton
                            BorderBrush="{DynamicResource DropMenuBorderColor}"
                            BorderThickness="0,0,1,0"
                            Classes="hover btn"
                            Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Print}"
                            Data="{StaticResource PrintGeometry}"
                            IconHeight="17"
                            IconMargin="15,0,10,0"
                            IconWidth="17"
                            IsEnabled="{Binding WindowTabs.ActiveTab.Value.ShouldPrintBeEnabled.Value}"
                            Text="{Binding Translation.Print.Value}"
                            ToolTip.Tip="{CompiledBinding Translation.Print.Value,
                                                          Mode=OneWay}"
                            Width="135" />

                        <!--  Close Menu  -->
                        <customControls:IconButton
                            BorderThickness="0"
                            Classes="hover btn"
                            ClickMode="Release"
                            Command="{CompiledBinding TopTitlebarViewModel.DropDownMenu.CloseMenuCommand}"
                            CornerRadius="0,8,0,0"
                            Data="{StaticResource CloseGeometry}"
                            IconHeight="10"
                            IconWidth="10"
                            ToolTip.Tip="{CompiledBinding Translation.Close.Value,
                                                          Mode=OneWay}"
                            Width="47"
                            x:Name="CloseButton" />
                    </StackPanel>

                    <!--  Open File  -->
                    <customControls:TextIconButton
                        Background="{DynamicResource MenuButtonBackground}"
                        BorderBrush="{DynamicResource DropMenuBorderColor}"
                        BorderThickness="1"
                        Canvas.Left="7"
                        Canvas.Top="53"
                        Classes="AltHover"
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Open}"
                        Data="{StaticResource FolderGeometry}"
                        Foreground="{DynamicResource MainTextColor}"
                        Height="46"
                        IconHeight="17"
                        IconMargin="9,0,9,0"
                        IconWidth="21.39"
                        Text="{CompiledBinding Translation.Open.Value,
                                               Mode=OneWay}"
                        TextMaxWidth="150"
                        ToolTip.Tip="{CompiledBinding Translation.OpenFileDialog.Value,
                                                      Mode=OneWay}"
                        Width="169"
                        x:Name="OpenButton" />

                    <!--  Open With  -->
                    <customControls:TextIconButton
                        Background="{DynamicResource MenuButtonBackground}"
                        BorderBrush="{DynamicResource DropMenuBorderColor}"
                        BorderThickness="1"
                        Canvas.Left="7"
                        Canvas.Top="104"
                        Classes="AltHover"
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.OpenWith}"
                        Foreground="{DynamicResource MainTextColor}"
                        Height="46"
                        Icon="{StaticResource OpenExternalImage}"
                        IconHeight="17"
                        IconMargin="11,0,11,0"
                        IconWidth="17"
                        IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                    Converter={x:Static ObjectConverters.IsNotNull},
                                                    FallbackValue=False,
                                                    Mode=OneWay}"
                        Text="{CompiledBinding Translation.OpenWith.Value,
                                               Mode=OneWay}"
                        TextMaxWidth="150"
                        ToolTip.Tip="{CompiledBinding Translation.OpenWith.Value}"
                        Width="169"
                        x:Name="OpenWithButton" />

                    <!--  Locate On Disk  -->
                    <customControls:TextIconButton
                        Background="{DynamicResource MenuButtonBackground}"
                        BorderBrush="{DynamicResource DropMenuBorderColor}"
                        BorderThickness="1"
                        Canvas.Left="182"
                        Canvas.Top="53"
                        Classes="AltHover"
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.OpenInExplorer}"
                        Data="{StaticResource ShowInFolderGeometry}"
                        Foreground="{DynamicResource MainTextColor}"
                        Height="46"
                        IconHeight="19"
                        IconMargin="11,0,9,0"
                        IconWidth="19"
                        IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                    Converter={x:Static ObjectConverters.IsNotNull},
                                                    FallbackValue=False,
                                                    Mode=OneWay}"
                        Text="{CompiledBinding Translation.ShowInFolder.Value,
                                               Mode=OneWay}"
                        TextMaxWidth="150"
                        ToolTip.Tip="{CompiledBinding Translation.ShowInFolder.Value,
                                                      Mode=OneWay}"
                        Width="169"
                        x:Name="ShowInFolderButton" />

                    <!--  Save File As  -->
                    <customControls:TextIconButton
                        Background="{DynamicResource MenuButtonBackground}"
                        BorderBrush="{DynamicResource DropMenuBorderColor}"
                        BorderThickness="1"
                        Canvas.Left="182"
                        Canvas.Top="104"
                        Classes="AltHover"
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SaveAs}"
                        Data="{StaticResource SaveGeometry}"
                        Foreground="{DynamicResource MainTextColor}"
                        Height="46"
                        IconHeight="19"
                        IconMargin="12,0,11,0"
                        IconWidth="19"
                        IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                    Converter={x:Static ObjectConverters.IsNotNull},
                                                    FallbackValue=False,
                                                    Mode=OneWay}"
                        Text="{CompiledBinding Translation.SaveAs.Value,
                                               Mode=OneWay}"
                        TextMaxWidth="150"
                        ToolTip.Tip="{CompiledBinding Translation.SaveAs.Value,
                                                      Mode=OneWay}"
                        Width="169"
                        x:Name="SaveAsButton" />

                    <!--  Gallery  -->
                    <customControls:TextIconButton
                        Background="{DynamicResource MenuButtonBackground}"
                        BorderBrush="{DynamicResource DropMenuBorderColor}"
                        BorderThickness="1"
                        Canvas.Left="7"
                        Canvas.Top="155"
                        Classes="AltHover"
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ToggleGallery}"
                        Data="{StaticResource GalleryGeometry}"
                        Foreground="{DynamicResource MainTextColor}"
                        Height="46"
                        IconHeight="19"
                        IconMargin="12,0,11,0"
                        IconWidth="19"
                        Text="{CompiledBinding Translation.ShowImageGallery.Value,
                                               Mode=OneWay}"
                        TextMaxWidth="150"
                        ToolTip.Tip="{CompiledBinding Translation.ShowImageGallery.Value,
                                                      Mode=OneWay}"
                        Width="169" />

                    <!--  Delete file  -->
                    <customControls:TextIconButton
                        Background="{DynamicResource MenuButtonBackground}"
                        BorderBrush="{DynamicResource DropMenuBorderColor}"
                        BorderThickness="1"
                        Canvas.Left="182"
                        Canvas.Top="155"
                        Classes="errorHover"
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.DeleteFile}"
                        Data="{StaticResource RecycleGeometry}"
                        Foreground="{DynamicResource MainTextColor}"
                        Height="46"
                        IconHeight="20"
                        IconMargin="11,0,13,0"
                        IconWidth="20"
                        Text="{CompiledBinding Translation.DeleteFile.Value,
                                               Mode=OneWay}"
                        ToolTip.Tip="{Binding Translation.MoveToRecycleBin.Value, Mode=OneWay}"
                        Width="169"
                        x:Name="PrintButton" />
                </Canvas>
            </Border>

            <!--  Arrow  -->
            <Canvas
                ClipToBounds="False"
                Grid.Row="1"
                Height="16"
                Margin="29,-1,0,0"
                Width="359">

                <!--  Filled triangle  -->
                <Path
                    Canvas.Left="6"
                    Canvas.Top="-1"
                    Data="M 0,0 L 15,16 L 30,0 Z"
                    Fill="{DynamicResource MenuBackgroundColor}"
                    x:Name="DownArrow" />

                <!--  Outline only on the two sides (no top edge)  -->
                <Path
                    Canvas.Left="6"
                    Canvas.Top="-1"
                    Data="M 0,0 L 15,16 L 30,0"
                    Stroke="{DynamicResource DropMenuSurroundingBorderColor}"
                    StrokeJoin="Round"
                    StrokeThickness="1"
                    x:Name="DownArrowBorder" />
            </Canvas>

        </Grid>

    </Border>
</customControls:AnimatedMenu>