<customControls:AnimatedMenu
    x:Class="PicView.Avalonia.Views.Menu.DropDownMenu"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:gallery="clr-namespace:PicView.Core.Gallery;assembly=PicView.Core"
    xmlns:keybindings="using:PicView.Core.Keybindings"
    xmlns:uc="clr-namespace:PicView.Avalonia.Views.UC"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    x:DataType="viewModels:MainWindowViewModel"
    IsOpen="{CompiledBinding TopTitlebarViewModel.DropDownMenu.IsDropDownMenuVisible.Value}">

    <Border
        x:Name="MainBorder"
        Width="380"
        Background="{DynamicResource DropDownMenuBackgroundColor}"
        BorderBrush="{DynamicResource MenuBorderColor}"
        BorderThickness="1"
        CornerRadius="8">
        <DockPanel>

            <!--  Gallery Carousel  -->
            <Carousel
                x:Name="GalleryCarousel"
                DockPanel.Dock="Top"
                SelectedIndex="{Binding TopTitlebarViewModel.DropDownMenu.GalleryCarouselIndex.Value}">
                <Carousel.PageTransition>
                    <CompositePageTransition>
                        <PageSlide Orientation="Horizontal" Duration="0:00:00.200" />
                    </CompositePageTransition>
                </Carousel.PageTransition>
                <Carousel.Items>
                    <DockPanel
                        VerticalAlignment="Top"
                        IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsGalleryCarouselVisible.Value}"
                        LastChildFill="True">

                        <customControls:IconButton
                            x:Name="GalleryExpandButton"
                            Width="35"
                            Background="{DynamicResource DropDownMenuButtonBackground}"
                            BorderBrush="{DynamicResource DropDownMenuButtonBorderColor}"
                            BorderThickness="0,0,1,0"
                            Classes="hover"
                            Command="{CompiledBinding TopTitlebarViewModel.DropDownMenu.OpenGalleryOptions}"
                            CornerRadius="0,8,0,0"
                            Data="{StaticResource FilledArrowRightGeometry}"
                            DockPanel.Dock="Right"
                            Focusable="True"
                            Foreground="{DynamicResource DropDownMenuButtonForeground}"
                            IconHeight="12"
                            IconWidth="12"
                            IsTabStop="True" />

                        <customControls:TextIconButton
                            x:Name="MainGalleryButton"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            Click="Close_OnClick"
                            Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.ToggleExpandedCommand}"
                            CornerRadius="8,0,0,0"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource GalleryImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Text="{CompiledBinding Translation.ShowImageGallery.Value}" />
                    </DockPanel>
                    <StackPanel VerticalAlignment="Top">
                        <Panel Height="30">
                            <customControls:IconButton
                                x:Name="GalleryContractButton"
                                Width="35"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource DropDownMenuButtonBackground}"
                                BorderBrush="{DynamicResource DropDownMenuButtonBorderColor}"
                                BorderThickness="0,0,1,0"
                                Classes="hover"
                                Command="{CompiledBinding TopTitlebarViewModel.DropDownMenu.CloseGalleryOptions}"
                                CornerRadius="8,0,0,0"
                                Data="{StaticResource FilledArrowLeftGeometry}"
                                Focusable="True"
                                Foreground="{DynamicResource DropDownMenuButtonForeground}"
                                IconHeight="12"
                                IconWidth="12"
                                IsTabStop="True" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Classes="txt"
                                Text="{CompiledBinding Translation.GallerySettings.Value,
                                                       Mode=OneWay}" />
                        </Panel>
                        <Rectangle
                            Height="1"
                            Margin="2,0,5,2"
                            Fill="{DynamicResource DropDownMenuButtonBorderColor}" />
                        <customControls:TextIconButton
                            x:Name="BottomDockButton"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.DockAtCommand}"
                            CommandParameter="{x:Static gallery:GalleryDockPosition.Bottom}"
                            DockPanel.Dock="Top"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource GalleryImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsEnabled="{CompiledBinding !WindowTabs.ActiveTab.Value.Gallery.IsBottomDocked.Value}"
                            IsTabStop="True"
                            Text="{CompiledBinding Translation.ShowDockedGalleryAtBottom.Value}" />
                        <customControls:TextIconButton
                            x:Name="TopDockButton"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.DockAtCommand}"
                            CommandParameter="{x:Static gallery:GalleryDockPosition.Top}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource GalleryImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsEnabled="{CompiledBinding !WindowTabs.ActiveTab.Value.Gallery.IsTopDocked.Value}"
                            IsTabStop="True"
                            Text="{CompiledBinding Translation.ShowDockedGalleryAtTop.Value}" />
                        <customControls:TextIconButton
                            x:Name="RightDockButton"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.DockAtCommand}"
                            CommandParameter="{x:Static gallery:GalleryDockPosition.Right}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource GalleryImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsEnabled="{CompiledBinding !WindowTabs.ActiveTab.Value.Gallery.IsRightDocked.Value}"
                            IsTabStop="True"
                            Text="{CompiledBinding Translation.ShowDockedGalleryToTheRight.Value}" />
                        <customControls:TextIconButton
                            x:Name="LeftDockButton"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.DockAtCommand}"
                            CommandParameter="{x:Static gallery:GalleryDockPosition.Left}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource GalleryImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsEnabled="{CompiledBinding !WindowTabs.ActiveTab.Value.Gallery.IsLeftDocked.Value}"
                            IsTabStop="True"
                            Text="{CompiledBinding Translation.ShowDockedGalleryToTheLeft.Value}" />
                        <customControls:TextIconButton
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.CloseCommand}"
                            CornerRadius="0,0,8,8"
                            Data="{StaticResource CloseGeometry}"
                            DockPanel.Dock="Top"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IconHeight="12"
                            IconMargin="0,0,7,0"
                            IconWidth="12"
                            IsEnabled="{Binding WindowTabs.ActiveTab.Value.Gallery.IsDocked.Value}"
                            IsTabStop="True"
                            Text="{CompiledBinding Translation.HideDockedGallery.Value}" />
                    </StackPanel>
                </Carousel.Items>
            </Carousel>

            <customControls:TextIconButton
                x:Name="BottomDockButton2"
                Padding="15,7,15,7"
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.DockAtCommand}"
                CommandParameter="{x:Static gallery:GalleryDockPosition.Bottom}"
                CornerRadius="8,0,0,0"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                Icon="{StaticResource GalleryImage}"
                IconHeight="14"
                IconMargin="0,0,7,0"
                IconWidth="14"
                IsTabStop="True"
                Text="{CompiledBinding Translation.ShowDockedGalleryAtBottom.Value}">
                <customControls:TextIconButton.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!WindowTabs.ActiveTab.Value.Gallery.IsDocked.Value" />
                        <Binding Path="TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value" />
                    </MultiBinding>
                </customControls:TextIconButton.IsVisible>
            </customControls:TextIconButton>

            <customControls:TextIconButton
                x:Name="HideDockedButton"
                Padding="15,7,15,7"
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.CloseCommand}"
                CornerRadius="8,0,0,0"
                Data="{StaticResource CloseGeometry}"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                IconHeight="12"
                IconMargin="0,0,7,0"
                IconWidth="12"
                IsTabStop="True"
                Text="{CompiledBinding Translation.HideDockedGallery.Value}">
                <customControls:TextIconButton.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="WindowTabs.ActiveTab.Value.Gallery.IsBottomDocked.Value" />
                        <Binding Path="TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value" />
                    </MultiBinding>
                </customControls:TextIconButton.IsVisible>
            </customControls:TextIconButton>

            <Rectangle
                Height="1"
                Margin="15,0,0,0"
                DockPanel.Dock="Top"
                Fill="{DynamicResource DropDownMenuButtonBorderColor}" />

            <!--  Slideshow Carousel  -->
            <Carousel
                x:Name="SlideshowCarousel"
                DockPanel.Dock="Top"
                IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateForwards.Value}"
                SelectedIndex="{Binding TopTitlebarViewModel.DropDownMenu.SlideshowCarouselIndex.Value}">
                <Carousel.PageTransition>
                    <CompositePageTransition>
                        <PageSlide Orientation="Horizontal" Duration="0:00:00.200" />
                    </CompositePageTransition>
                </Carousel.PageTransition>
                <Carousel.Items>
                    <DockPanel
                        VerticalAlignment="Top"
                        IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsSlideshowCarouselVisible.Value}"
                        LastChildFill="True">

                        <customControls:IconButton
                            x:Name="SlideshowExpandButton"
                            Width="35"
                            Background="{DynamicResource DropDownMenuButtonBackground}"
                            BorderBrush="{DynamicResource DropDownMenuButtonBorderColor}"
                            BorderThickness="0,0,1,0"
                            Classes="hover"
                            Command="{CompiledBinding TopTitlebarViewModel.DropDownMenu.OpenSlideshowOptions}"
                            Data="{StaticResource FilledArrowRightGeometry}"
                            DockPanel.Dock="Right"
                            Focusable="True"
                            Foreground="{DynamicResource DropDownMenuButtonForeground}"
                            IconHeight="12"
                            IconWidth="12"
                            IsTabStop="True" />

                        <customControls:TextIconButton
                            x:Name="MainSlideshowButton"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            Click="Close_OnClick"
                            ClickMode="Release"
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.Slideshow}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource SlideshowImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Text="{CompiledBinding Translation.Slideshow.Value}" />
                    </DockPanel>
                    <StackPanel VerticalAlignment="Top">
                        <Panel Height="30">
                            <customControls:IconButton
                                x:Name="SlideshowContractButton"
                                Width="35"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource DropDownMenuButtonBackground}"
                                BorderBrush="{DynamicResource DropDownMenuButtonBorderColor}"
                                BorderThickness="0,0,1,0"
                                Classes="hover"
                                Command="{CompiledBinding TopTitlebarViewModel.DropDownMenu.CloseSlideshowOptions}"
                                CornerRadius="8,0,0,0"
                                Data="{StaticResource FilledArrowLeftGeometry}"
                                Focusable="True"
                                Foreground="{DynamicResource MainTextColor}"
                                IconHeight="12"
                                IconWidth="12"
                                IsTabStop="True" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Classes="txt"
                                Text="{CompiledBinding Translation.Slideshow.Value,
                                                       Mode=OneWay}" />
                        </Panel>
                        <Rectangle
                            Height="1"
                            Margin="5,2"
                            Fill="{DynamicResource DropDownMenuButtonBorderColor}" />
                        <customControls:TextIconButton
                            x:Name="SlideShow2Sec"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="2000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True" />
                        <customControls:TextIconButton
                            x:Name="SlideShow5Sec"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="5000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True" />
                        <customControls:TextIconButton
                            x:Name="SlideShow10Sec"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="10000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True" />
                        <customControls:TextIconButton
                            x:Name="SlideShow20Sec"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="20000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True" />
                        <customControls:TextIconButton
                            x:Name="SlideShow30Sec"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="30000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True" />
                        <customControls:TextIconButton
                            x:Name="SlideShow60Sec"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="60000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True" />
                        <customControls:TextIconButton
                            x:Name="SlideShow90Sec"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="90000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True" />
                        <customControls:TextIconButton
                            x:Name="SlideShow120Sec"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="120000"
                            CornerRadius="0,0,8,8"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True" />
                    </StackPanel>
                </Carousel.Items>
            </Carousel>

            <Rectangle
                Height="1"
                Margin="15,0,0,0"
                DockPanel.Dock="Top"
                Fill="{DynamicResource DropDownMenuButtonBorderColor}" />

            <!--  Effects  -->
            <customControls:TextIconButton
                x:Name="EffectsButton"
                Padding="15,7,15,7"
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{Binding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.EffectsWindow}"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                Icon="{StaticResource SparklesImage}"
                IconHeight="14"
                IconMargin="0,0,7,0"
                IconWidth="14"
                IsTabStop="True"
                IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value}"
                Text="{Binding Translation.Effects.Value}"
                ToolTip.Tip="{CompiledBinding Translation.EffectsTooltip.Value,
                                              Mode=OneWay}" />

            <!--  Single image Resize  -->
            <customControls:TextIconButton
                x:Name="SingleImageResizeButton"
                Padding="15,7,15,7"
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{Binding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.ResizeWindow}"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                Icon="{StaticResource BatchResizeImage}"
                IconHeight="14"
                IconMargin="0,0,7,0"
                IconWidth="14"
                IsTabStop="True"
                IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value}"
                Text="{Binding Translation.ResizeImage.Value}" />

            <!--  Batch Resize  -->
            <customControls:TextIconButton
                x:Name="BatchResizeButton"
                Padding="15,7,15,7"
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{Binding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.BatchResizeWindow}"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                Icon="{StaticResource BatchResizeImage}"
                IconHeight="14"
                IconMargin="0,0,7,0"
                IconWidth="14"
                IsTabStop="True"
                IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value}"
                Text="{Binding Translation.BatchResize.Value}" />

            <!--  Image info  -->
            <customControls:TextIconButton
                x:Name="ImageInfoButton"
                Padding="15,7,15,7"
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{Binding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.ImageInfoWindow}"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                Icon="{StaticResource CameraImage}"
                IconHeight="14"
                IconMargin="0,0,7,0"
                IconWidth="14"
                IsTabStop="True"
                IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value}"
                Text="{Binding Translation.ImageInfo.Value}" />

            <!--  Crop  -->
            <customControls:TextIconButton
                x:Name="CropButton"
                Padding="15,7,15,7"
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{Binding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.Crop}"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                Icon="{StaticResource CropImage}"
                IconHeight="14"
                IconMargin="0,0,7,0"
                IconWidth="14"
                IsEnabled="{Binding WindowTabs.ActiveTab.Value.ShouldCropBeEnabled.Value}"
                IsTabStop="True"
                IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value}"
                Text="{Binding Translation.Crop.Value}" />

            <!--  Print  -->
            <customControls:TextIconButton
                x:Name="PrintButton"
                Padding="15,7,15,7"
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{Binding RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.Print}"
                Data="{StaticResource PrintGeometry}"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                IconHeight="14"
                IconMargin="0,0,7,0"
                IconWidth="14"
                IsEnabled="{Binding WindowTabs.ActiveTab.Value.ShouldPrintBeEnabled.Value}"
                IsTabStop="True"
                IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value}"
                Text="{Binding Translation.Print.Value}" />

            <Rectangle
                Height="1"
                Margin="15,0,0,0"
                DockPanel.Dock="Top"
                Fill="{DynamicResource DropDownMenuButtonBorderColor}" />

            <!--  Settings Carousel  -->
            <Carousel DockPanel.Dock="Top" SelectedIndex="{Binding TopTitlebarViewModel.DropDownMenu.SettingsCarouselIndex.Value}">
                <Carousel.PageTransition>
                    <CompositePageTransition>
                        <PageSlide Orientation="Horizontal" Duration="0:00:00.200" />
                    </CompositePageTransition>
                </Carousel.PageTransition>
                <Carousel.Items>
                    <DockPanel
                        VerticalAlignment="Top"
                        IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsSettingsCarouselVisible.Value}"
                        LastChildFill="True">

                        <!--  Expand into settings  -->
                        <customControls:IconButton
                            x:Name="SettingsExpandButton"
                            Width="35"
                            Background="{DynamicResource DropDownMenuButtonBackground}"
                            BorderBrush="{DynamicResource DropDownMenuButtonBorderColor}"
                            BorderThickness="0,0,1,0"
                            Classes="hover"
                            Command="{CompiledBinding TopTitlebarViewModel.DropDownMenu.OpenSettingsOptions}"
                            Data="{StaticResource FilledArrowRightGeometry}"
                            DockPanel.Dock="Right"
                            Focusable="True"
                            Foreground="{DynamicResource DropDownMenuButtonForeground}"
                            IconHeight="12"
                            IconWidth="12"
                            IsTabStop="True" />

                        <!--  Main settings button  -->
                        <customControls:TextIconButton
                            x:Name="SettingsButton"
                            Padding="15,7,15,7"
                            Background="Transparent"
                            Classes="hover"
                            Click="Close_OnClick"
                            ClickMode="Release"
                            Command="{CompiledBinding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SettingsWindow}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource CogImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Text="{CompiledBinding Translation.Settings.Value}" />
                    </DockPanel>
                    <StackPanel VerticalAlignment="Top">
                        <Panel Height="30">

                            <!--  Close settings  -->
                            <customControls:IconButton
                                x:Name="SettingsContractButton"
                                Width="35"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource DropDownMenuButtonBackground}"
                                BorderBrush="{DynamicResource DropDownMenuButtonBorderColor}"
                                BorderThickness="0,0,1,0"
                                Classes="hover"
                                Command="{CompiledBinding TopTitlebarViewModel.DropDownMenu.CloseSettingsOptions}"
                                CornerRadius="8,0,0,0"
                                Data="{StaticResource FilledArrowLeftGeometry}"
                                Focusable="True"
                                Foreground="{DynamicResource MainTextColor}"
                                IconHeight="14"
                                IconWidth="14"
                                IsTabStop="True" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Classes="txt"
                                Text="{CompiledBinding Translation.Settings.Value,
                                                       Mode=OneWay}" />
                        </Panel>
                        <Rectangle
                            Height="1"
                            Margin="5,2"
                            Fill="{DynamicResource DropDownMenuButtonBorderColor}" />

                        <!--  Auto-fit window  -->
                        <customControls:TextToggleButton
                            x:Name="AutoFitButton"
                            Padding="7,0"
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.AutoFitWindow}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IsChecked="{Binding IsAutoFit.Value, Mode=OneWay}"
                            IsTabStop="True"
                            Text="{Binding Translation.AutoFitWindow.Value}"
                            TextMargin="0,0,7,0"
                            ToolTip.Tip="{CompiledBinding Translation.AutoFitWindow.Value,
                                                          Mode=OneWay}" />

                        <!--  Topmost  -->
                        <customControls:TextToggleButton
                            x:Name="TopMostButton"
                            Padding="7,0"
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SetTopMost}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IsChecked="{Binding IsTopMost.Value, Mode=TwoWay}"
                            IsTabStop="True"
                            Text="{Binding Translation.StayTopMost.Value}"
                            TextMargin="0,0,7,0"
                            ToolTip.Tip="{CompiledBinding Translation.StayTopMost.Value,
                                                          Mode=OneWay}" />

                        <!--  Looping  -->
                        <customControls:TextToggleButton
                            x:Name="LoopingButton"
                            Padding="7,0"
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.ToggleLooping}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IsChecked="{Binding GlobalSettings.IsLooping.Value, Mode=TwoWay}"
                            IsTabStop="True"
                            Text="{Binding Translation.ToggleLooping.Value}"
                            TextMargin="0,0,7,0"
                            ToolTip.Tip="{CompiledBinding Translation.ToggleLooping.Value,
                                                          Mode=OneWay}" />

                        <!--  Scroll  -->
                        <customControls:TextToggleButton
                            x:Name="ScrollButton"
                            Padding="7,0"
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.ToggleScroll}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IsChecked="{Binding IsScrollingEnabled.Value, Mode=TwoWay}"
                            IsTabStop="True"
                            Text="{Binding Translation.IsScrolling.Value}"
                            TextMargin="0,0,7,0"
                            ToolTip.Tip="{CompiledBinding Translation.ToggleScroll.Value,
                                                          Mode=OneWay}" />

                        <!--  Zoom to fit  -->
                        <customControls:TextToggleButton
                            x:Name="ZoomToFitButton"
                            Padding="7,0"
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.ZoomToFit}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IsChecked="{Binding IsZoomedToFit.Value, Mode=TwoWay}"
                            IsTabStop="True"
                            Text="{Binding Translation.ZoomToFit.Value}"
                            TextMargin="0,0,7,0"
                            ToolTip.Tip="{CompiledBinding Translation.ZoomToFit.Value,
                                                          Mode=OneWay}" />

                        <!--  Side by side  -->
                        <customControls:TextToggleButton
                            x:Name="SideBySideButton"
                            Padding="7,0"
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SideBySide}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IsChecked="{Binding IsSideBySide.Value, Mode=TwoWay}"
                            IsTabStop="True"
                            Text="{Binding Translation.SideBySide.Value}"
                            TextMargin="0,0,7,0"
                            ToolTip.Tip="{CompiledBinding Translation.SideBySideTooltip.Value,
                                                          Mode=OneWay}" />

                        <Rectangle
                            Height="1"
                            Margin="5,0"
                            Fill="{DynamicResource DropDownMenuButtonBorderColor}" />

                        <!--  About  -->
                        <customControls:TextIconButton
                            x:Name="AboutButton"
                            Padding="15,9"
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.AboutWindow}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource AboutImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Text="{Binding Translation.About.Value}"
                            ToolTip.Tip="{Binding Translation.AboutWindow.Value}" />


                        <!--  Keybindings  -->
                        <customControls:TextIconButton
                            x:Name="KeybindingsButton"
                            Padding="15,9"
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.KeybindingsWindow}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource KeyImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Text="{Binding Translation.ApplicationShortcuts.Value}"
                            ToolTip.Tip="{Binding Translation.ApplicationShortcuts.Value}" />

                        <!--  Settings  -->
                        <customControls:TextIconButton
                            x:Name="AllSettingsButton"
                            Padding="15,9"
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SettingsWindow}"
                            CornerRadius="0,0,8,8"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource CogImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Text="{Binding Translation.ShowAllSettingsWindow.Value}"
                            ToolTip.Tip="{Binding Translation.ShowAllSettingsWindow.Value}" />
                    </StackPanel>
                </Carousel.Items>
            </Carousel>

            <!--  Favorites  -->
            <DockPanel
                DockPanel.Dock="Top"
                IsVisible="{CompiledBinding TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value}"
                LastChildFill="False">

                <Rectangle
                    Height="1"
                    Margin="15,0,0,0"
                    DockPanel.Dock="Top"
                    Fill="{DynamicResource DropDownMenuButtonBorderColor}" />

                <!--  Favorites header buttons  -->
                <DockPanel DockPanel.Dock="Top">

                    <customControls:IconButton
                        x:Name="AddFavoriteButton"
                        Margin="0,0,0,0"
                        Padding="8,5"
                        Background="Transparent"
                        Classes="hover"
                        Command="{Binding Favorites.AddFavoritesDialogCommand}"
                        DockPanel.Dock="Right"
                        Focusable="True"
                        Foreground="{DynamicResource MainTextColor}"
                        Icon="{StaticResource PlusImage}"
                        IconHeight="14"
                        IconWidth="14"
                        IsTabStop="True"
                        ToolTip.Tip="{CompiledBinding Translation.AddFavorite.Value,
                                                      Mode=OneWay}" />

                    <TextBlock
                        Padding="15,5,0,5"
                        Classes="txt medium"
                        DockPanel.Dock="Left"
                        FontSize="12"
                        Text="{CompiledBinding Translation.Favorites.Value}" />

                </DockPanel>

                <customControls:AutoScrollViewer DockPanel.Dock="Top">
                    <ItemsControl x:Name="FavoritesCollection">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:FavoritesEntryViewModel">
                                <uc:FavoriteItem />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </customControls:AutoScrollViewer>

            </DockPanel>

            <!--  File history  -->
            <DockPanel
                Margin="0,0,0,5"
                Dock="Bottom"
                IsVisible="{CompiledBinding TopTitlebarViewModel.DropDownMenu.IsFileHistoryVisible.Value}"
                LastChildFill="False">

                <Rectangle
                    Height="1"
                    Margin="15,0,0,0"
                    DockPanel.Dock="Top"
                    Fill="{DynamicResource DropDownMenuButtonBorderColor}" />

                <!--  File history header buttons  -->
                <DockPanel DockPanel.Dock="Top">

                    <customControls:IconButton
                        x:Name="HistorySortButton"
                        Margin="0,0,0,0"
                        Padding="8,5"
                        Background="Transparent"
                        Classes="hover"
                        Command="{Binding FileHistory.ToggleSortCommand}"
                        DockPanel.Dock="Right"
                        Focusable="True"
                        Foreground="{DynamicResource MainTextColor}"
                        Icon="{StaticResource SortDescImage}"
                        IconHeight="14"
                        IconWidth="14"
                        IsTabStop="True" />

                    <customControls:IconButton
                        x:Name="HistoryClearButton"
                        Margin="0,0,5,0"
                        Padding="8,4"
                        Classes="errorHover"
                        Command="{Binding FileHistory.ClearHistoryCommand}"
                        Data="{StaticResource RecycleGeometry}"
                        DockPanel.Dock="Right"
                        Focusable="True"
                        Foreground="{DynamicResource MainTextColor}"
                        IconHeight="14"
                        IconWidth="14"
                        IsTabStop="True"
                        ToolTip.Tip="{CompiledBinding Translation.Clear.Value,
                                                      Mode=OneWay}" />

                    <customControls:IconButton
                        x:Name="HistoryFileButton"
                        Margin="0,0,5,0"
                        Padding="8,5"
                        Classes="hover"
                        ClickMode="Release"
                        Command="{Binding FileHistory.OpenFileHistoryCommand}"
                        DockPanel.Dock="Right"
                        Focusable="True"
                        Foreground="{DynamicResource MainTextColor}"
                        Icon="{StaticResource SquareLibrary}"
                        IconHeight="14"
                        IconWidth="14"
                        IsTabStop="True"
                        ToolTip.Tip="{CompiledBinding Translation.OpenFileHistory.Value,
                                                      Mode=OneWay}" />

                    <TextBlock
                        Padding="15,5,0,5"
                        Classes="txt medium"
                        DockPanel.Dock="Left"
                        FontSize="12"
                        Text="{CompiledBinding Translation.RecentFiles.Value}" />

                </DockPanel>

                <customControls:AutoScrollViewer DockPanel.Dock="Top">
                    <StackPanel>

                        <!--  Pinned entries  -->
                        <TextBlock
                            Margin="15,10,15,5"
                            Classes="txt"
                            IsVisible="{CompiledBinding FileHistory.HasPinnedEntries.Value}"
                            Text="{Binding Translation.Pinned.Value}" />

                        <ListBox
                            x:Name="PinnedEntriesCollection"
                            IsVisible="{CompiledBinding FileHistory.HasPinnedEntries.Value}"
                            Theme="{StaticResource NoScrollListBox}">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <uc:FileHistoryItem Focusable="True" IsTabStop="True" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Rectangle
                            Height="1"
                            Margin="10,5,0,10"
                            Fill="{DynamicResource DropDownMenuButtonBorderColor}"
                            IsVisible="{CompiledBinding FileHistory.HasPinnedEntries.Value}"
                            Opacity=".85" />

                        <!--  Unpinned entries  -->
                        <ListBox x:Name="UnPinnedEntriesCollection" Theme="{StaticResource NoScrollListBox}">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <uc:FileHistoryItem />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </customControls:AutoScrollViewer>

            </DockPanel>

        </DockPanel>

    </Border>
</customControls:AnimatedMenu>
