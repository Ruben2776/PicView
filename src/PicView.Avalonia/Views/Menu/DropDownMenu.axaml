<customControls:AnimatedMenu
    IsOpen="{CompiledBinding TopTitlebarViewModel.DropDownMenu.IsDropDownMenuVisible.Value}"
    x:Class="PicView.Avalonia.Views.Menu.DropDownMenu"
    x:DataType="viewModels:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:gallery="clr-namespace:PicView.Core.Gallery;assembly=PicView.Core"
    xmlns:uc="clr-namespace:PicView.Avalonia.Views.UC"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{DynamicResource DropDownMenuBackgroundColor}"
        BorderBrush="{DynamicResource MenuBorderColor}"
        BorderThickness="1"
        CornerRadius="8"
        Width="380"
        x:Name="MainBorder">
        <DockPanel>

            <!--  Gallery Carousel  -->
            <Carousel
                DockPanel.Dock="Top"
                SelectedIndex="{Binding TopTitlebarViewModel.DropDownMenu.GalleryCarouselIndex.Value}"
                x:Name="GalleryCarousel">
                <Carousel.PageTransition>
                    <CompositePageTransition>
                        <PageSlide Duration="0:00:00.200" Orientation="Horizontal" />
                    </CompositePageTransition>
                </Carousel.PageTransition>
                <Carousel.Items>
                    <DockPanel
                        IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsGalleryCarouselVisible.Value}"
                        LastChildFill="True"
                        VerticalAlignment="Top">

                        <customControls:IconButton
                            Background="{DynamicResource DropDownMenuButtonBackground}"
                            BorderBrush="{DynamicResource DropDownMenuButtonBorderColor}"
                            BorderThickness="0,0,1,0"
                            Classes="hover"
                            Command="{CompiledBinding TopTitlebarViewModel.DropDownMenu.OpenGalleryOptions}"
                            CornerRadius="0,8,0,0"
                            Data="{StaticResource FilledArrowRightGeometry}"
                            DockPanel.Dock="Right"
                            Focusable="True"
                            Foreground="{DynamicResource DropDownMenuButtonForeground}"
                            IconHeight="12"
                            IconWidth="12"
                            IsTabStop="True"
                            Width="35"
                            x:Name="GalleryExpandButton" />

                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            Click="Close_OnClick"
                            Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.ToggleGalleryCommand}"
                            CornerRadius="8,0,0,0"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource GalleryImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            Text="{CompiledBinding Translation.ShowImageGallery.Value}"
                            x:Name="MainGalleryButton" />
                    </DockPanel>
                    <StackPanel VerticalAlignment="Top">
                        <Panel Height="30">
                            <customControls:IconButton
                                Background="{DynamicResource DropDownMenuButtonBackground}"
                                BorderBrush="{DynamicResource DropDownMenuButtonBorderColor}"
                                BorderThickness="0,0,1,0"
                                Classes="hover"
                                Command="{CompiledBinding TopTitlebarViewModel.DropDownMenu.CloseGalleryOptions}"
                                CornerRadius="8,0,0,0"
                                Data="{StaticResource FilledArrowLeftGeometry}"
                                Focusable="True"
                                Foreground="{DynamicResource DropDownMenuButtonForeground}"
                                HorizontalAlignment="Left"
                                IconHeight="12"
                                IconWidth="12"
                                IsTabStop="True"
                                Width="35"
                                x:Name="GalleryContractButton" />
                            <TextBlock
                                Classes="txt"
                                HorizontalAlignment="Center"
                                Text="{CompiledBinding Translation.GallerySettings.Value,
                                                       Mode=OneWay}" />
                        </Panel>
                        <Rectangle
                            Fill="{DynamicResource DropDownMenuButtonBorderColor}"
                            Height="1"
                            Margin="2,0,5,2" />
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.SetDockPositionCommand}"
                            CommandParameter="{x:Static gallery:GalleryDockPosition.Bottom}"
                            DockPanel.Dock="Top"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource GalleryImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsEnabled="{CompiledBinding !WindowTabs.ActiveTab.Value.Gallery.IsBottomDocked.Value}"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            Text="{CompiledBinding Translation.ShowDockedGalleryAtBottom.Value}"
                            x:Name="BottomDockButton" />
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.SetDockPositionCommand}"
                            CommandParameter="{x:Static gallery:GalleryDockPosition.Top}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource GalleryImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsEnabled="{CompiledBinding !WindowTabs.ActiveTab.Value.Gallery.IsTopDocked.Value}"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            Text="{CompiledBinding Translation.ShowDockedGalleryAtTop.Value}"
                            x:Name="TopDockButton" />
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.SetDockPositionCommand}"
                            CommandParameter="{x:Static gallery:GalleryDockPosition.Right}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource GalleryImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsEnabled="{CompiledBinding !WindowTabs.ActiveTab.Value.Gallery.IsRightDocked.Value}"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            Text="{CompiledBinding Translation.ShowDockedGalleryToTheRight.Value}"
                            x:Name="RightDockButton" />
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.SetDockPositionCommand}"
                            CommandParameter="{x:Static gallery:GalleryDockPosition.Left}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource GalleryImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsEnabled="{CompiledBinding !WindowTabs.ActiveTab.Value.Gallery.IsLeftDocked.Value}"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            Text="{CompiledBinding Translation.ShowDockedGalleryToTheLeft.Value}"
                            x:Name="LeftDockButton" />
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.CloseGalleryCommand}"
                            CornerRadius="0,0,8,8"
                            Data="{StaticResource CloseGeometry}"
                            DockPanel.Dock="Top"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IconHeight="12"
                            IconMargin="0,0,7,0"
                            IconWidth="12"
                            IsEnabled="{Binding WindowTabs.ActiveTab.Value.Gallery.IsGalleryDocked.Value}"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            Text="{CompiledBinding Translation.HideDockedGallery.Value}" />
                    </StackPanel>
                </Carousel.Items>
            </Carousel>

            <customControls:TextIconButton
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.SetDockPositionCommand}"
                CommandParameter="{x:Static gallery:GalleryDockPosition.Bottom}"
                CornerRadius="8,0,0,0"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                Icon="{StaticResource GalleryImage}"
                IconHeight="14"
                IconMargin="0,0,7,0"
                IconWidth="14"
                IsTabStop="True"
                Padding="15,7,15,7"
                Text="{CompiledBinding Translation.ShowDockedGalleryAtBottom.Value}"
                x:Name="BottomDockButton2">
                <customControls:TextIconButton.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!WindowTabs.ActiveTab.Value.Gallery.IsGalleryDocked.Value" />
                        <Binding Path="TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value" />
                    </MultiBinding>
                </customControls:TextIconButton.IsVisible>
            </customControls:TextIconButton>

            <customControls:TextIconButton
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{CompiledBinding WindowTabs.ActiveTab.Value.Gallery.CloseGalleryCommand}"
                CornerRadius="8,0,0,0"
                Data="{StaticResource CloseGeometry}"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                IconHeight="12"
                IconMargin="0,0,7,0"
                IconWidth="12"
                IsTabStop="True"
                Padding="15,7,15,7"
                Text="{CompiledBinding Translation.HideDockedGallery.Value}"
                x:Name="HideDockedButton">
                <customControls:TextIconButton.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="WindowTabs.ActiveTab.Value.Gallery.IsBottomDocked.Value" />
                        <Binding Path="TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value" />
                    </MultiBinding>
                </customControls:TextIconButton.IsVisible>
            </customControls:TextIconButton>

            <Rectangle
                DockPanel.Dock="Top"
                Fill="{DynamicResource DropDownMenuButtonBorderColor}"
                Height="1"
                Margin="15,0,0,0" />

            <!--  Slideshow Carousel  -->
            <Carousel
                DockPanel.Dock="Top"
                IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateForwards.Value}"
                SelectedIndex="{Binding TopTitlebarViewModel.DropDownMenu.SlideshowCarouselIndex.Value}"
                x:Name="SlideshowCarousel">
                <Carousel.PageTransition>
                    <CompositePageTransition>
                        <PageSlide Duration="0:00:00.200" Orientation="Horizontal" />
                    </CompositePageTransition>
                </Carousel.PageTransition>
                <Carousel.Items>
                    <DockPanel
                        IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsSlideshowCarouselVisible.Value}"
                        LastChildFill="True"
                        VerticalAlignment="Top">

                        <customControls:IconButton
                            Background="{DynamicResource DropDownMenuButtonBackground}"
                            BorderBrush="{DynamicResource DropDownMenuButtonBorderColor}"
                            BorderThickness="0,0,1,0"
                            Classes="hover"
                            Command="{CompiledBinding TopTitlebarViewModel.DropDownMenu.OpenSlideshowOptions}"
                            Data="{StaticResource FilledArrowRightGeometry}"
                            DockPanel.Dock="Right"
                            Focusable="True"
                            Foreground="{DynamicResource DropDownMenuButtonForeground}"
                            IconHeight="12"
                            IconWidth="12"
                            IsTabStop="True"
                            Width="35"
                            x:Name="SlideshowExpandButton" />

                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            Click="Close_OnClick"
                            ClickMode="Release"
                            Command="{Binding SlideshowCommand}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource SlideshowImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            Text="{CompiledBinding Translation.Slideshow.Value}"
                            x:Name="MainSlideshowButton" />
                    </DockPanel>
                    <StackPanel VerticalAlignment="Top">
                        <Panel Height="30">
                            <customControls:IconButton
                                Background="{DynamicResource DropDownMenuButtonBackground}"
                                BorderBrush="{DynamicResource DropDownMenuButtonBorderColor}"
                                BorderThickness="0,0,1,0"
                                Classes="hover"
                                Command="{CompiledBinding TopTitlebarViewModel.DropDownMenu.CloseSlideshowOptions}"
                                CornerRadius="8,0,0,0"
                                Data="{StaticResource FilledArrowLeftGeometry}"
                                Focusable="True"
                                Foreground="{DynamicResource MainTextColor}"
                                HorizontalAlignment="Left"
                                IconHeight="12"
                                IconWidth="12"
                                IsTabStop="True"
                                Width="35"
                                x:Name="SlideshowContractButton" />
                            <TextBlock
                                Classes="txt"
                                HorizontalAlignment="Center"
                                Text="{CompiledBinding Translation.Slideshow.Value,
                                                       Mode=OneWay}" />
                        </Panel>
                        <Rectangle
                            Fill="{DynamicResource DropDownMenuButtonBorderColor}"
                            Height="1"
                            Margin="5,2" />
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="2000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            x:Name="SlideShow2Sec" />
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="5000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            x:Name="SlideShow5Sec" />
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="10000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            x:Name="SlideShow10Sec" />
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="20000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            x:Name="SlideShow20Sec" />
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="30000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            x:Name="SlideShow30Sec" />
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="60000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            x:Name="SlideShow60Sec" />
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="90000"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            x:Name="SlideShow90Sec" />
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            CommandParameter="120000"
                            CornerRadius="0,0,8,8"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource TimerImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            x:Name="SlideShow120Sec" />
                    </StackPanel>
                </Carousel.Items>
            </Carousel>

            <Rectangle
                DockPanel.Dock="Top"
                Fill="{DynamicResource DropDownMenuButtonBorderColor}"
                Height="1"
                Margin="15,0,0,0" />

            <!--  Effects  -->
            <customControls:TextIconButton
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{Binding EffectsWindowCommand}"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                Icon="{StaticResource SparklesImage}"
                IconHeight="14"
                IconMargin="0,0,7,0"
                IconWidth="14"
                IsTabStop="True"
                IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value}"
                Padding="15,7,15,7"
                Text="{Binding Translation.Effects.Value}"
                ToolTip.Tip="{CompiledBinding Translation.EffectsTooltip.Value,
                                              Mode=OneWay}"
                x:Name="EffectsButton" />

            <!--  Single image Resize  -->
            <customControls:TextIconButton
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{Binding ResizeWindowCommand}"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                Icon="{StaticResource BatchResizeImage}"
                IconHeight="14"
                IconMargin="0,0,7,0"
                IconWidth="14"
                IsTabStop="True"
                IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value}"
                Padding="15,7,15,7"
                Text="{Binding Translation.ResizeImage.Value}"
                x:Name="SingleImageResizeButton" />

            <!--  Batch Resize  -->
            <customControls:TextIconButton
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{Binding BatchResizeWindowCommand}"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                Icon="{StaticResource BatchResizeImage}"
                IconHeight="14"
                IconMargin="0,0,7,0"
                IconWidth="14"
                IsTabStop="True"
                IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value}"
                Padding="15,7,15,7"
                Text="{Binding Translation.BatchResize.Value}"
                x:Name="BatchResizeButton" />

            <!--  Image info  -->
            <customControls:TextIconButton
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{Binding ImageInfoWindowCommand}"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                Icon="{StaticResource CameraImage}"
                IconHeight="14"
                IconMargin="0,0,7,0"
                IconWidth="14"
                IsTabStop="True"
                IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value}"
                Padding="15,7,15,7"
                Text="{Binding Translation.ImageInfo.Value}"
                x:Name="ImageInfoButton" />

            <!--  Crop  -->
            <customControls:TextIconButton
                Background="Transparent"
                Classes="hover"
                Click="Close_OnClick"
                Command="{Binding CropCommand}"
                DockPanel.Dock="Top"
                Focusable="True"
                Foreground="{DynamicResource MainTextColor}"
                Icon="{StaticResource CropImage}"
                IconHeight="14"
                IconMargin="0,0,7,0"
                IconWidth="14"
                IsEnabled="{Binding WindowTabs.ActiveTab.Value.ShouldCropBeEnabled.Value}"
                IsTabStop="True"
                IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value}"
                Padding="15,7,15,7"
                Text="{Binding Translation.Crop.Value}"
                x:Name="CropButton" />

            <Rectangle
                DockPanel.Dock="Top"
                Fill="{DynamicResource DropDownMenuButtonBorderColor}"
                Height="1"
                Margin="15,0,0,0" />

            <!--  Settings Carousel  -->
            <Carousel DockPanel.Dock="Top" SelectedIndex="{Binding TopTitlebarViewModel.DropDownMenu.SettingsCarouselIndex.Value}">
                <Carousel.PageTransition>
                    <CompositePageTransition>
                        <PageSlide Duration="0:00:00.200" Orientation="Horizontal" />
                    </CompositePageTransition>
                </Carousel.PageTransition>
                <Carousel.Items>
                    <DockPanel
                        IsVisible="{Binding TopTitlebarViewModel.DropDownMenu.IsSettingsCarouselVisible.Value}"
                        LastChildFill="True"
                        VerticalAlignment="Top">

                        <!--  Expand into settings  -->
                        <customControls:IconButton
                            Background="{DynamicResource DropDownMenuButtonBackground}"
                            BorderBrush="{DynamicResource DropDownMenuButtonBorderColor}"
                            BorderThickness="0,0,1,0"
                            Classes="hover"
                            Command="{CompiledBinding TopTitlebarViewModel.DropDownMenu.OpenSettingsOptions}"
                            Data="{StaticResource FilledArrowRightGeometry}"
                            DockPanel.Dock="Right"
                            Focusable="True"
                            Foreground="{DynamicResource DropDownMenuButtonForeground}"
                            IconHeight="12"
                            IconWidth="12"
                            IsTabStop="True"
                            Width="35"
                            x:Name="SettingsExpandButton" />

                        <!--  Main settings button  -->
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            Click="Close_OnClick"
                            ClickMode="Release"
                            Command="{CompiledBinding SettingsWindowCommand}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource CogImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,7,15,7"
                            Text="{CompiledBinding Translation.Settings.Value}"
                            x:Name="SettingsButton" />
                    </DockPanel>
                    <StackPanel VerticalAlignment="Top">
                        <Panel Height="30">

                            <!--  Close settings  -->
                            <customControls:IconButton
                                Background="{DynamicResource DropDownMenuButtonBackground}"
                                BorderBrush="{DynamicResource DropDownMenuButtonBorderColor}"
                                BorderThickness="0,0,1,0"
                                Classes="hover"
                                Command="{CompiledBinding TopTitlebarViewModel.DropDownMenu.CloseSettingsOptions}"
                                CornerRadius="8,0,0,0"
                                Data="{StaticResource FilledArrowLeftGeometry}"
                                Focusable="True"
                                Foreground="{DynamicResource MainTextColor}"
                                HorizontalAlignment="Left"
                                IconHeight="14"
                                IconWidth="14"
                                IsTabStop="True"
                                Width="35"
                                x:Name="SettingsContractButton" />
                            <TextBlock
                                Classes="txt"
                                HorizontalAlignment="Center"
                                Text="{CompiledBinding Translation.Settings.Value,
                                                       Mode=OneWay}" />
                        </Panel>
                        <Rectangle
                            Fill="{DynamicResource DropDownMenuButtonBorderColor}"
                            Height="1"
                            Margin="5,2" />

                        <!--  Auto-fit window  -->
                        <customControls:TextToggleButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding AutoFitWindowCommand}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IsChecked="{Binding IsAutoFit.Value, Mode=TwoWay}"
                            IsTabStop="True"
                            Padding="7,0"
                            Text="{Binding Translation.AutoFitWindow.Value}"
                            TextMargin="0,0,7,0"
                            ToolTip.Tip="{CompiledBinding Translation.AutoFitWindow.Value,
                                                          Mode=OneWay}"
                            x:Name="AutoFitButton" />

                        <!--  Topmost  -->
                        <customControls:TextToggleButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding SetTopMostCommand}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IsChecked="{Binding IsTopMost.Value, Mode=TwoWay}"
                            IsTabStop="True"
                            Padding="7,0"
                            Text="{Binding Translation.StayTopMost.Value}"
                            TextMargin="0,0,7,0"
                            ToolTip.Tip="{CompiledBinding Translation.StayTopMost.Value,
                                                          Mode=OneWay}"
                            x:Name="TopMostButton" />

                        <!--  Looping  -->
                        <customControls:TextToggleButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding ToggleLoopingCommand}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IsChecked="{Binding GlobalSettings.IsLooping.Value, Mode=TwoWay}"
                            IsTabStop="True"
                            Padding="7,0"
                            Text="{Binding Translation.ToggleLooping.Value}"
                            TextMargin="0,0,7,0"
                            ToolTip.Tip="{CompiledBinding Translation.ToggleLooping.Value,
                                                          Mode=OneWay}"
                            x:Name="LoopingButton" />

                        <!--  Scroll  -->
                        <customControls:TextToggleButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding ToggleScrollCommand}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IsChecked="{Binding IsScrollingEnabled.Value, Mode=TwoWay}"
                            IsTabStop="True"
                            Padding="7,0"
                            Text="{Binding Translation.IsScrolling.Value}"
                            TextMargin="0,0,7,0"
                            ToolTip.Tip="{CompiledBinding Translation.ToggleScroll.Value,
                                                          Mode=OneWay}"
                            x:Name="ScrollButton" />

                        <!--  Zoom to fit  -->
                        <customControls:TextToggleButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding ZoomToFitCommand}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IsChecked="{Binding IsZoomedToFit.Value, Mode=TwoWay}"
                            IsTabStop="True"
                            Padding="7,0"
                            Text="{Binding Translation.ZoomToFit.Value}"
                            TextMargin="0,0,7,0"
                            ToolTip.Tip="{CompiledBinding Translation.ZoomToFit.Value,
                                                          Mode=OneWay}"
                            x:Name="ZoomToFitButton" />

                        <!--  Side by side  -->
                        <customControls:TextToggleButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding SideBySideCommand}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            IsChecked="{Binding IsSideBySide.Value, Mode=TwoWay}"
                            IsTabStop="True"
                            Padding="7,0"
                            Text="{Binding Translation.SideBySide.Value}"
                            TextMargin="0,0,7,0"
                            ToolTip.Tip="{CompiledBinding Translation.SideBySideTooltip.Value,
                                                          Mode=OneWay}"
                            x:Name="SideBySideButton" />

                        <Rectangle
                            Fill="{DynamicResource DropDownMenuButtonBorderColor}"
                            Height="1"
                            Margin="5,0" />

                        <!--  About  -->
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding AboutWindowCommand}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource AboutImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,9"
                            Text="{Binding Translation.About.Value}"
                            ToolTip.Tip="{Binding Translation.AboutWindow.Value}"
                            x:Name="AboutButton" />


                        <!--  Keybindings  -->
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding KeybindingsWindowCommand}"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource KeyImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,9"
                            Text="{Binding Translation.ApplicationShortcuts.Value}"
                            ToolTip.Tip="{Binding Translation.ApplicationShortcuts.Value}"
                            x:Name="KeybindingsButton" />

                        <!--  Settings  -->
                        <customControls:TextIconButton
                            Background="Transparent"
                            Classes="hover"
                            Command="{Binding SettingsWindowCommand}"
                            CornerRadius="0,0,8,8"
                            Focusable="True"
                            Foreground="{DynamicResource MainTextColor}"
                            Icon="{StaticResource CogImage}"
                            IconHeight="14"
                            IconMargin="0,0,7,0"
                            IconWidth="14"
                            IsTabStop="True"
                            Padding="15,9"
                            Text="{Binding Translation.ShowAllSettingsWindow.Value}"
                            ToolTip.Tip="{Binding Translation.ShowAllSettingsWindow.Value}"
                            x:Name="AllSettingsButton" />
                    </StackPanel>
                </Carousel.Items>
            </Carousel>

            <!--  Favorites  -->
            <DockPanel
                DockPanel.Dock="Top"
                IsVisible="{CompiledBinding TopTitlebarViewModel.DropDownMenu.IsExtraButtonsVisible.Value}"
                LastChildFill="False">

                <Rectangle
                    DockPanel.Dock="Top"
                    Fill="{DynamicResource DropDownMenuButtonBorderColor}"
                    Height="1"
                    Margin="15,0,0,0" />

                <!--  Favorites header buttons  -->
                <DockPanel DockPanel.Dock="Top">

                    <customControls:IconButton
                        Background="Transparent"
                        Classes="hover"
                        Command="{Binding Favorites.AddFavoritesDialogCommand}"
                        DockPanel.Dock="Right"
                        Focusable="True"
                        Foreground="{DynamicResource MainTextColor}"
                        Icon="{StaticResource PlusImage}"
                        IconHeight="14"
                        IconWidth="14"
                        IsTabStop="True"
                        Margin="0,0,0,0"
                        Padding="8,5"
                        ToolTip.Tip="{CompiledBinding Translation.AddFavorite.Value,
                                                      Mode=OneWay}"
                        x:Name="AddFavoriteButton" />

                    <TextBlock
                        Classes="txt medium"
                        DockPanel.Dock="Left"
                        FontSize="12"
                        Padding="15,5,0,5"
                        Text="{CompiledBinding Translation.Favorites.Value}" />

                </DockPanel>

                <customControls:AutoScrollViewer DockPanel.Dock="Top">
                    <ItemsControl x:Name="FavoritesCollection">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:FavoritesEntryViewModel">
                                <uc:FavoriteItem />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </customControls:AutoScrollViewer>

            </DockPanel>

            <!--  File history  -->
            <DockPanel
                Dock="Bottom"
                IsVisible="{CompiledBinding TopTitlebarViewModel.DropDownMenu.IsFileHistoryVisible.Value}"
                LastChildFill="False"
                Margin="0,0,0,5">

                <Rectangle
                    DockPanel.Dock="Top"
                    Fill="{DynamicResource DropDownMenuButtonBorderColor}"
                    Height="1"
                    Margin="15,0,0,0" />

                <!--  File history header buttons  -->
                <DockPanel DockPanel.Dock="Top">

                    <customControls:IconButton
                        Background="Transparent"
                        Classes="hover"
                        Command="{Binding FileHistory.ToggleSortCommand}"
                        DockPanel.Dock="Right"
                        Focusable="True"
                        Foreground="{DynamicResource MainTextColor}"
                        Icon="{StaticResource SortDescImage}"
                        IconHeight="14"
                        IconWidth="14"
                        IsTabStop="True"
                        Margin="0,0,0,0"
                        Padding="8,5"
                        x:Name="HistorySortButton" />

                    <customControls:IconButton
                        Classes="errorHover"
                        Command="{Binding FileHistory.ClearHistoryCommand}"
                        Data="{StaticResource RecycleGeometry}"
                        DockPanel.Dock="Right"
                        Focusable="True"
                        Foreground="{DynamicResource MainTextColor}"
                        IconHeight="14"
                        IconWidth="14"
                        IsTabStop="True"
                        Margin="0,0,5,0"
                        Padding="8,4"
                        ToolTip.Tip="{CompiledBinding Translation.Clear.Value,
                                                      Mode=OneWay}"
                        x:Name="HistoryClearButton" />

                    <customControls:IconButton
                        Classes="hover"
                        ClickMode="Release"
                        Command="{Binding FileHistory.OpenFileHistoryCommand}"
                        DockPanel.Dock="Right"
                        Focusable="True"
                        Foreground="{DynamicResource MainTextColor}"
                        Icon="{StaticResource SquareLibrary}"
                        IconHeight="14"
                        IconWidth="14"
                        IsTabStop="True"
                        Margin="0,0,5,0"
                        Padding="8,5"
                        ToolTip.Tip="{CompiledBinding Translation.OpenFileHistory.Value,
                                                      Mode=OneWay}"
                        x:Name="HistoryFileButton" />

                    <TextBlock
                        Classes="txt medium"
                        DockPanel.Dock="Left"
                        FontSize="12"
                        Padding="15,5,0,5"
                        Text="{CompiledBinding Translation.RecentFiles.Value}" />

                </DockPanel>

                <customControls:AutoScrollViewer DockPanel.Dock="Top">
                    <StackPanel>

                        <!--  Pinned entries  -->
                        <TextBlock
                            Classes="txt"
                            IsVisible="{CompiledBinding FileHistory.HasPinnedEntries.Value}"
                            Margin="15,10,15,5"
                            Text="{Binding Translation.Pinned.Value}" />

                        <ListBox
                            IsVisible="{CompiledBinding FileHistory.HasPinnedEntries.Value}"
                            Theme="{StaticResource NoScrollListBox}"
                            x:Name="PinnedEntriesCollection">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <uc:FileHistoryItem Focusable="True" IsTabStop="True" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Rectangle
                            Fill="{DynamicResource DropDownMenuButtonBorderColor}"
                            Height="1"
                            IsVisible="{CompiledBinding FileHistory.HasPinnedEntries.Value}"
                            Margin="10,5,0,10"
                            Opacity=".85" />

                        <!--  Unpinned entries  -->
                        <ListBox Theme="{StaticResource NoScrollListBox}" x:Name="UnPinnedEntriesCollection">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <uc:FileHistoryItem />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </customControls:AutoScrollViewer>

            </DockPanel>

        </DockPanel>

    </Border>
</customControls:AnimatedMenu>
