<UserControl
    x:Class="PicView.Avalonia.Views.UC.ImageViewer"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:PicView.Avalonia.Converters"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:uc="clr-namespace:PicView.Avalonia.Views.UC"
    xmlns:vm="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:zoom="clr-namespace:PicView.Avalonia.CustomControls.Zoom"
    x:DataType="vm:TabViewModel">
    <UserControl.Resources>
        <converters:DisplayableConverter x:Key="DisplayableConverter" />
    </UserControl.Resources>
    <!--  The gallery, click arrows, hover bar and gallery shortcut, and the image background, are the NavigableView's  -->
    <Panel x:Name="MainPanel">
        <LayoutTransformControl x:Name="MainTransform">
            <LayoutTransformControl.LayoutTransform>
                <RotateTransform Angle="{Binding Orientation.Degrees.Value}" />
            </LayoutTransformControl.LayoutTransform>
            <zoom:ZoomPanControl x:Name="ZoomPanControl">
                <customControls:AutoScrollViewer
                    x:Name="ImageScrollViewer"
                    Width="{Binding ParentWindowContext.ScrollViewerWidth.Value}"
                    Height="{Binding ParentWindowContext.ScrollViewerHeight.Value}"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                    <Border
                        x:Name="MainBorder"
                        Width="{Binding ParentWindowContext.ImageWidth.Value}"
                        Height="{Binding ParentWindowContext.ImageHeight.Value}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{CompiledBinding ParentWindowContext.WindowSettings.ConstrainedImageBackground.Value,
                                                     Mode=OneWay}">
                        <DockPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            LastChildFill="False">
                            <Grid DockPanel.Dock="Left">
                                <customControls:PicBox
                                    x:Name="MainImage"
                                    ImageType="{Binding ImageType.Value}"
                                    Playback="{Binding Animation.Primary.Value}"
                                    Source="{CompiledBinding Image.Value,
                                                             Converter={StaticResource DisplayableConverter}}" />
                                <uc:MotionPhotoView x:Name="MotionPhotoView" />
                            </Grid>
                            <Grid DockPanel.Dock="Right" IsVisible="{CompiledBinding ParentWindowContext.WindowSettings.IsSideBySide.Value, Mode=OneWay}">
                                <customControls:PicBox
                                    x:Name="SecondaryImage"
                                    ImageType="{Binding SecondaryImageType.Value}"
                                    Playback="{Binding Animation.Secondary.Value}"
                                    Source="{CompiledBinding SecondaryImage.Value,
                                                             Converter={StaticResource DisplayableConverter}}" />
                                <uc:MotionPhotoView x:Name="SecondaryMotionPhotoView" AllowAutoPlay="False" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </customControls:AutoScrollViewer>
            </zoom:ZoomPanControl>
        </LayoutTransformControl>
        <!--  Moved into the NavigableView's overlay host while this viewer is shown, above its chrome  -->
        <uc:ZoomPreviewer
            x:Name="ZoomPreview"
            Margin="0,0,25,25"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsVisible="False"
            ZIndex="90" />
        <!--
            Floating host for the motion photo badges. Living outside MainTransform,
            the badges stay upright while the code-behind anchors each one to the
            on-screen top-right corner of its image, regardless of rotation,
            flipping or zooming.
        -->
        <Panel x:Name="MotionPhotoBadgeHost" ZIndex="2" />
    </Panel>
</UserControl>