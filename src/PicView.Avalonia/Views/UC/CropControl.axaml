<UserControl
    x:Class="PicView.Avalonia.Views.UC.CropControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    x:DataType="viewModels:TabViewModel"
    Width="{CompiledBinding ParentWindowContext.ScrollViewerWidth.Value, Mode=OneWay}"
    Height="{CompiledBinding ParentWindowContext.ScrollViewerHeight.Value, Mode=OneWay}"
    Margin="0"
    ClipToBounds="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Brush0" Color="{DynamicResource MainTextColor}" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Styles>
            <Style Selector="Border.x">
                <Setter Property="Background" Value="{StaticResource CropBackground}" />
                <Setter Property="BorderBrush" Value="#fff" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="ZIndex" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
            </Style>
        </Styles>
    </UserControl.Styles>
    <UserControl.ContextMenu>
        <ContextMenu x:Name="CropContextMenu">
            <customControls:StyledMenuItem
                Command="{CompiledBinding Crop.CropImageCommand}"
                Header="{CompiledBinding ParentWindowContext.Translation.Crop.Value,
                                         Mode=OneWay}"
                HotKey="Enter">
                <MenuItem.Icon>
                    <Image
                        Width="12"
                        Height="12"
                        Source="{StaticResource CropImage}" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>
            <customControls:StyledMenuItem Command="{CompiledBinding Crop.CopyCropImageCommand}" Header="{CompiledBinding ParentWindowContext.Translation.Copy.Value, Mode=OneWay}">
                <MenuItem.Icon>
                    <Path
                        Width="12"
                        Height="12"
                        Data="{StaticResource CopyGeometry}"
                        Fill="{StaticResource Brush0}"
                        Stretch="Fill" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>
            <customControls:StyledMenuItem Command="{CompiledBinding Crop.CloseCropCommand}" Header="{CompiledBinding ParentWindowContext.Translation.Close.Value, Mode=OneWay}">
                <MenuItem.Icon>
                    <Path
                        Width="12"
                        Height="12"
                        Data="{StaticResource CloseGeometry}"
                        Fill="{StaticResource Brush0}"
                        Stretch="Fill" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>
    <!--  The crop zooms through its own control: Space and a drag pan, a plain drag moves or resizes the selection  -->
    <customControls:ZoomPanControl x:Name="ZoomPanControl" Host="Crop">
        <!--  As large as the view, so a zoomed image has the room the viewer gives it  -->
        <Panel Width="{CompiledBinding ParentWindowContext.ScrollViewerWidth.Value, Mode=OneWay}" Height="{CompiledBinding ParentWindowContext.ScrollViewerHeight.Value, Mode=OneWay}">
            <!--  The fitted image with the selection drawn over it  -->
            <Panel
                x:Name="CropSurface"
                Width="{CompiledBinding ParentWindowContext.ImageWidth.Value, Mode=OneWay}"
                Height="{CompiledBinding ParentWindowContext.ImageHeight.Value, Mode=OneWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <!--  Image control to display the bitmap  -->
                <customControls:PicBox
                    x:Name="ImageControl"
                    CurrentFileInfo="{Binding FileInfo.Value}"
                    ImageType="{Binding ImageType.Value}"
                    Source="{Binding Image.Value}" />

                <!--  Not rounded to whole units: the selection sits on image pixels, which are fractions of a unit  -->
                <Canvas
                    x:Name="RootCanvas"
                    Background="Transparent"
                    UseLayoutRounding="False">

                    <!--  Everything but the selection, dimmed, as one shape with a hole so no seam can show  -->
                    <Path
                        x:Name="Dimming"
                        Fill="#80000000"
                        IsHitTestVisible="False" />

                    <!--  Size Border  -->
                    <Border
                        x:Name="SizeBorder"
                        Padding="8,5"
                        Background="{DynamicResource PopUpBackgroundColor}"
                        BorderBrush="{DynamicResource PopUpMainBorderColor}"
                        BorderThickness="1"
                        CornerRadius="4"
                        IsHitTestVisible="False"
                        ZIndex="2">
                        <TextBlock
                            Classes="txt"
                            FontSize="14"
                            Foreground="{DynamicResource MainTextColor}">
                            <Run Text="{CompiledBinding ParentWindowContext.Translation.Width.Value, Mode=OneWay}" />
                            <Run Text=": " />
                            <Run Text="{CompiledBinding Crop.PixelSelectionWidth.Value, Mode=OneWay}" />
                            <Run Text=" x " />
                            <Run Text="{CompiledBinding ParentWindowContext.Translation.Height.Value, Mode=OneWay}" />
                            <Run Text=": " />
                            <Run Text="{CompiledBinding Crop.PixelSelectionHeight.Value, Mode=OneWay}" />
                        </TextBlock>
                    </Border>

                    <!--  Main Rectangle  -->
                    <Border
                        x:Name="MainRectangle"
                        Width="{CompiledBinding Crop.SelectionWidth.Value}"
                        Height="{CompiledBinding Crop.SelectionHeight.Value}"
                        Background="Transparent"
                        BorderBrush="#fff"
                        BorderThickness="2"
                        Cursor="Hand" />

                    <!--  Top Left  -->
                    <Border
                        x:Name="TopLeftButton"
                        Classes="x"
                        Cursor="TopLeftCorner" />

                    <!--  Top Right  -->
                    <Border
                        x:Name="TopRightButton"
                        Classes="x"
                        Cursor="TopRightCorner" />

                    <!--  Top Middle  -->
                    <Border
                        x:Name="TopMiddleButton"
                        Classes="x"
                        Cursor="SizeNorthSouth" />

                    <!--  Bottom Right  -->
                    <Border
                        x:Name="BottomRightButton"
                        Classes="x"
                        Cursor="BottomRightCorner" />

                    <!--  Bottom Middle  -->
                    <Border
                        x:Name="BottomMiddleButton"
                        Classes="x"
                        Cursor="SizeNorthSouth" />

                    <!--  Bottom Left  -->
                    <Border
                        x:Name="BottomLeftButton"
                        Classes="x"
                        Cursor="BottomLeftCorner" />

                    <!--  Left Middle  -->
                    <Border
                        x:Name="LeftMiddleButton"
                        Classes="x"
                        Cursor="SizeWestEast" />

                    <!--  Right Middle  -->
                    <Border
                        x:Name="RightMiddleButton"
                        Classes="x"
                        Cursor="SizeWestEast" />

                </Canvas>
            </Panel>
        </Panel>
    </customControls:ZoomPanControl>
</UserControl>
