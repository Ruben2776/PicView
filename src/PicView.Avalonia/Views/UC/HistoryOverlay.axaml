<UserControl
    x:Class="PicView.Avalonia.Views.UC.HistoryOverlay"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PicView.Avalonia.ViewModels"
    xmlns:converters="using:PicView.Avalonia.Converters"
    x:DataType="vm:HistoryOverlayViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToBrushConverter x:Key="BoolToBrushConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
    </UserControl.Resources>

    <Border
        Background="#CC1E1E1E"
        CornerRadius="10"
        Padding="10"
        Classes="shadow-lg"
        >
        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="History" FontWeight="SemiBold"/>
                <TextBlock Text="{CompiledBinding StatusText.Value}" Opacity="0.8" Margin="8,0,0,0"/>
                <Button Content="×" HorizontalAlignment="Right"
                        Command="{CompiledBinding CloseCommand}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Height="240" Width="420">
                <ListBox ItemsSource="{CompiledBinding Items}"
                    SelectedIndex="{CompiledBinding SelectedIndex.Value}"
                    BorderThickness="0"
                    Background="Transparent"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Width="420" Height="240">
                    <ListBox.ItemTemplate>
                        <DataTemplate  x:DataType="vm:HistoryItemViewModel">
                            <Border CornerRadius="6"
                                    Padding="6"
                                    Margin="4"
                                    Background="{CompiledBinding IsActive, Converter={StaticResource BoolToBrushConverter}}">
                                    <Border.Transitions>
                                        <Transitions>
                                            <BrushTransition Property="Background" Duration="0:0:0.2" />
                                        </Transitions>
                                    </Border.Transitions>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="{CompiledBinding Thumbnail}" Width="72" Height="72"
                                        Opacity="{CompiledBinding IsFuture, Converter={StaticResource BoolToOpacityConverter}}"/>
                                    <StackPanel>
                                        <TextBlock Text="{CompiledBinding Title}" FontWeight="SemiBold"
                                                Opacity="{CompiledBinding IsFuture, Converter={StaticResource BoolToOpacityConverter}}"/>
                                        <TextBlock Text="{CompiledBinding Subtitle}" Opacity="{CompiledBinding IsFuture, Converter={StaticResource BoolToOpacityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Undo" Command="{CompiledBinding UndoCommand}"/>
                <Button Content="Redo" Command="{CompiledBinding RedoCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
