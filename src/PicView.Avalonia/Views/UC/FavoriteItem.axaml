<UserControl
    x:Class="PicView.Avalonia.Views.UC.FavoriteItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:PicView.Avalonia.Converters"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:vm="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    x:DataType="vm:FavoritesEntryViewModel">
    <UserControl.Resources>
        <converters:FavoriteSlotKeybindConverter x:Key="FavoriteSlotKeybindConverter" />
    </UserControl.Resources>
    <UserControl.Styles>

        <!--  Style for current item  -->
        <Style Selector="Border#AppBorder.isCurrent">
            <Setter Property="Background" Value="#0AFFFFFF" />
        </Style>
        <Style Selector="Border#AppBorder.isCurrent TextBlock">
            <Setter Property="FontFamily" Value="/Assets/Fonts/Roboto-Bold.ttf#Roboto" />
        </Style>
        <Style Selector="Border#AppBorder.isCurrent customControls|TextIconButton">
            <Setter Property="FontFamily" Value="/Assets/Fonts/Roboto-Bold.ttf#Roboto" />
        </Style>

        <!--  Style for hovering over items  -->
        <Style Selector="Border#AppBorder">
            <Setter Property="Background" Value="Transparent" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource AccentColor}" />
            </Style>
        </Style>
        <Style Selector="Border#AppBorder:pointerover TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextColor}" />
        </Style>

        <!--  Show buttons on hover  -->
        <Style Selector=":pointerover &gt; Border#AppBorder">
            <Setter Property="IsVisible" Value="True" />
        </Style>

    </UserControl.Styles>

    <Border x:Name="AppBorder" Classes.isCurrent="{CompiledBinding IsCurrentItem.Value}">
        <DockPanel LastChildFill="True">

            <StackPanel
                x:Name="ButtonPanel"
                HorizontalAlignment="Right"
                Background="Transparent"
                DockPanel.Dock="Right"
                IsVisible="False"
                Orientation="Horizontal">

                <customControls:IconButton
                    Padding="7,0"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource AccentColor}"
                    Classes="accentHover"
                    ClickMode="Release"
                    Command="{CompiledBinding OpenEditDialogCommand}"
                    Foreground="{StaticResource SecondaryTextColor}"
                    Icon="{StaticResource CogImage}"
                    IconHeight="12"
                    IconWidth="12"
                    ToolTip.Tip="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Translation.Edit.Value}" />

                <customControls:IconButton
                    x:Name="RemoveButton"
                    Padding="7,0"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource AccentColor}"
                    Classes="errorHover"
                    ClickMode="Release"
                    Command="{CompiledBinding RemoveCommand}"
                    Data="{StaticResource CloseGeometry}"
                    Foreground="{StaticResource SecondaryTextColor}"
                    IconHeight="12"
                    IconWidth="12"
                    ToolTip.Tip="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Translation.Remove.Value}" />

            </StackPanel>

            <DockPanel DockPanel.Dock="Left">

                <TextBlock
                    Padding="10,0"
                    Classes="txt"
                    DockPanel.Dock="Right"
                    Text="{CompiledBinding Slot.Value,
                                           Converter={StaticResource FavoriteSlotKeybindConverter}}" />

                <customControls:TextIconButton
                    x:Name="MainButton"
                    Padding="5,6"
                    Background="Transparent"
                    Command="{CompiledBinding OpenCommand}"
                    Data="{StaticResource FolderGeometry}"
                    DockPanel.Dock="Left"
                    Foreground="{DynamicResource MainTextColor}"
                    IconHeight="12"
                    IconMargin="10,0,5,0"
                    IconWidth="12"
                    Text="{CompiledBinding FolderName.Value}"
                    ToolTip.Tip="{CompiledBinding FilePath.Value}" />

            </DockPanel>

        </DockPanel>
    </Border>
</UserControl>
