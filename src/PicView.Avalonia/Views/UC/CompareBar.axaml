<UserControl
    Background="Transparent"
    x:Class="PicView.Avalonia.Views.UC.CompareBar"
    x:DataType="vm:TabViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:keybindings="using:PicView.Core.Keybindings"
    xmlns:uc="using:PicView.Avalonia.Views.UC"
    xmlns:vm="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Button.compareBtn, RepeatButton.compareBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextColorFaded}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.compareBtn.active, RepeatButton.compareBtn.active">
            <Setter Property="Foreground" Value="{DynamicResource MainTextColor}" />
            <Setter Property="Background" Value="{DynamicResource ComparePillActiveBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ComparePillActiveBorder}" />
        </Style>
        <Style Selector="Button.compareIconBtn, RepeatButton.compareIconBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.compareIconBtn:not(.active):pointerover, RepeatButton.compareIconBtn:not(.active):pointerover">
            <Setter Property="Foreground" Value="{DynamicResource MainTextColor}" />
            <Setter Property="Background" Value="{DynamicResource ComparePillHoverBackground}" />
        </Style>
        <Style Selector="Button.compareIconBtn.active, RepeatButton.compareIconBtn.active">
            <Setter Property="Foreground" Value="{DynamicResource MainTextColor}" />
            <Setter Property="Background" Value="{DynamicResource ComparePillActiveBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ComparePillActiveBorder}" />
        </Style>
        <Style Selector="Button.compareIconBtn:disabled, RepeatButton.compareIconBtn:disabled">
            <Setter Property="Opacity" Value="{StaticResource ThemeDisabledOpacity}" />
        </Style>
        <Style Selector="Button.compareIconBtn Path, Button.comparePill Path">
            <Setter Property="Stroke" Value="{DynamicResource MainTextColorFaded}" />
        </Style>
        <Style Selector="Button.compareIconBtn:not(.active):pointerover Path, Button.compareIconBtn.active Path, Button.comparePill:not(.active):pointerover Path, Button.comparePill.active Path">
            <Setter Property="Stroke" Value="{DynamicResource MainTextColor}" />
        </Style>
        <!--  Horizontal at the top and bottom; the vertical class at the left and right stacks the groups  -->
        <Style Selector="StackPanel.barGroup">
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
        <Style Selector="Slider">
            <Setter Property="Width" Value="92" />
        </Style>
        <Style Selector="Border.barDivider">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
        </Style>
        <Style Selector="customControls|AutoScrollViewer.barScroll">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="uc|CompareBar.vertical StackPanel.barGroup">
            <Setter Property="Orientation" Value="Vertical" />
        </Style>
        <!--  Reversed so the minimum (A) is at the top, beside the A label above it  -->
        <Style Selector="uc|CompareBar.vertical Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="IsDirectionReversed" Value="True" />
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="92" />
        </Style>
        <!--  At the sides the contextual rows fit the width the permanent rows give  -->
        <Style Selector="uc|CompareBar.vertical TextBlock#AlignHintText">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="uc|CompareBar.vertical NumericUpDown">
            <Setter Property="Width" Value="NaN" />
        </Style>
        <Style Selector="uc|CompareBar.vertical Border.barDivider">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="1" />
        </Style>
        <Style Selector="uc|CompareBar.vertical customControls|AutoScrollViewer.barScroll">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <!--  The close button stays at the end of the bar: the right at the top and bottom, the bottom at the sides  -->
        <Style Selector="RepeatButton#CloseButton">
            <Setter Property="DockPanel.Dock" Value="Right" />
        </Style>
        <Style Selector="uc|CompareBar.vertical RepeatButton#CloseButton">
            <Setter Property="DockPanel.Dock" Value="Bottom" />
        </Style>
        <!--  The 1px border is on the edge that faces the image: the top when docked at the bottom, and so on  -->
        <Style Selector="Border#BarBorder">
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="uc|CompareBar.dockTop Border#BarBorder">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="uc|CompareBar.dockLeft Border#BarBorder">
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <Style Selector="uc|CompareBar.dockRight Border#BarBorder">
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
    </UserControl.Styles>

    <Border
        Background="{DynamicResource PopUpBackgroundColor}"
        BorderBrush="{DynamicResource PopUpMainBorderColor}"
        x:Name="BarBorder">
        <DockPanel>
            <!--  Close Comparison: kept at the end of the bar, outside the scrolling row  -->
            <customControls:IconButton
                Classes="compareIconBtn"
                Command="{CompiledBinding ParentWindowContext.RunActionCommand}"
                CommandParameter="{x:Static keybindings:Actions.Comparison}"
                Data="{StaticResource CloseGeometry}"
                IconHeight="11"
                IconWidth="11"
                ToolTip.Tip="{CompiledBinding ParentWindowContext.Translation.Close.Value}"
                x:Name="CloseButton" />
            <customControls:AutoScrollViewer
                Classes="barScroll"
                Theme="{StaticResource ClickableMenuScrollButtons}"
                x:Name="BarScroll">
                <!--  Contextual rows are left out of its thickness at the sides, so they never resize it  -->
                <customControls:ContextualStackPanel Classes="barGroup" Spacing="6">

                    <StackPanel Classes="barGroup" Spacing="2">
                        <Button
                            Classes="compareBtn"
                            Classes.MenuItemHover="{CompiledBinding !Comparison.IsOverlay.Value}"
                            Classes.active="{CompiledBinding Comparison.IsOverlay.Value}"
                            Command="{CompiledBinding ParentWindowContext.RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.ComparisonModeOverlay}"
                            x:Name="OverlayModeButton">
                            <TextBlock Classes="txt" Text="{CompiledBinding ParentWindowContext.Translation.ComparisonOverlay.Value}" />
                        </Button>
                        <Button
                            Classes="compareBtn"
                            Classes.MenuItemHover="{CompiledBinding !Comparison.IsSplit.Value}"
                            Classes.active="{CompiledBinding Comparison.IsSplit.Value}"
                            Command="{CompiledBinding ParentWindowContext.RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.ComparisonModeSplit}"
                            x:Name="SplitModeButton">
                            <TextBlock Classes="txt" Text="{CompiledBinding ParentWindowContext.Translation.ComparisonSplit.Value}" />
                        </Button>
                        <Button
                            Classes="compareBtn"
                            Classes.MenuItemHover="{CompiledBinding !Comparison.IsSynced.Value}"
                            Classes.active="{CompiledBinding Comparison.IsSynced.Value}"
                            Command="{CompiledBinding ParentWindowContext.RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.ComparisonModeSynced}"
                            x:Name="SyncedModeButton">
                            <TextBlock Classes="txt" Text="{CompiledBinding ParentWindowContext.Translation.ComparisonSideBySideSynced.Value}" />
                        </Button>
                        <Button
                            Classes="compareBtn"
                            Classes.MenuItemHover="{CompiledBinding !Comparison.IsBlink.Value}"
                            Classes.active="{CompiledBinding Comparison.IsBlink.Value}"
                            Command="{CompiledBinding ParentWindowContext.RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.ComparisonModeBlink}"
                            x:Name="BlinkModeButton">
                            <TextBlock Classes="txt" Text="{CompiledBinding ParentWindowContext.Translation.ComparisonBlink.Value}" />
                        </Button>
                        <Button
                            Classes="compareBtn"
                            Classes.MenuItemHover="{CompiledBinding !Comparison.IsDifference.Value}"
                            Classes.active="{CompiledBinding Comparison.IsDifference.Value}"
                            Command="{CompiledBinding ParentWindowContext.RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.ComparisonModeDifference}"
                            x:Name="DifferenceModeButton">
                            <TextBlock Classes="txt" Text="{CompiledBinding ParentWindowContext.Translation.ComparisonDifference.Value}" />
                        </Button>
                    </StackPanel>

                    <!--  Contextual Controls: Overlay Opacity  -->
                    <StackPanel
                        Classes="barGroup"
                        IsVisible="{CompiledBinding Comparison.IsOverlay.Value}"
                        Spacing="6"
                        VerticalAlignment="Center"
                        customControls:ContextualStackPanel.IsContextual="True">
                        <TextBlock Classes="txt" Text="A" />
                        <Slider
                            Maximum="1"
                            Minimum="0"
                            Value="{CompiledBinding Comparison.OverlayOpacity.Value,
                                                    Mode=TwoWay}"
                            VerticalAlignment="Center" />
                        <TextBlock Classes="txt" Text="B" />
                    </StackPanel>

                    <!--  Contextual Controls: Split Orientation  -->
                    <Border
                        Background="{DynamicResource ComparePillGroupBackground}"
                        CornerRadius="16"
                        IsVisible="{CompiledBinding Comparison.IsSplit.Value}"
                        Padding="2"
                        customControls:ContextualStackPanel.IsContextual="True">
                        <StackPanel Classes="barGroup">
                            <customControls:IconButton
                                Classes="compareIconBtn"
                                Classes.active="{CompiledBinding !Comparison.IsSplitHorizontal.Value}"
                                Click="OnSplitVerticalClick"
                                CornerRadius="16,0,0,16"
                                Icon="{StaticResource SeparatorVerticalImage}"
                                IconHeight="12"
                                IconWidth="12"
                                ToolTip.Tip="{CompiledBinding ParentWindowContext.Translation.ComparisonSplitVertical.Value}" />
                            <customControls:IconButton
                                Classes="compareIconBtn"
                                Classes.active="{CompiledBinding Comparison.IsSplitHorizontal.Value}"
                                Click="OnSplitHorizontalClick"
                                CornerRadius="0,16,16,0"
                                Icon="{StaticResource SeparatorHorizontalImage}"
                                IconHeight="12"
                                IconWidth="12"
                                ToolTip.Tip="{CompiledBinding ParentWindowContext.Translation.ComparisonSplitHorizontal.Value}" />
                        </StackPanel>
                    </Border>

                    <!--  Contextual Controls: Blink Timing  -->
                    <Border
                        Background="{DynamicResource ComparePillGroupBackground}"
                        CornerRadius="16"
                        IsVisible="{CompiledBinding Comparison.IsBlink.Value}"
                        Padding="2"
                        customControls:ContextualStackPanel.IsContextual="True">
                        <StackPanel Classes="barGroup" Spacing="4">
                            <Button
                                Classes="compareBtn"
                                Classes.active="{CompiledBinding Comparison.IsBlinkFast.Value}"
                                Click="OnBlinkFastClick">
                                <TextBlock Classes="txt" Text="0.3s" />
                            </Button>
                            <Button
                                Classes="compareBtn"
                                Classes.active="{CompiledBinding !Comparison.IsBlinkFast.Value}"
                                Click="OnBlinkCustomClick">
                                <TextBlock Classes="txt" Text="{CompiledBinding ParentWindowContext.Translation.ComparisonCustom.Value}" />
                            </Button>
                            <NumericUpDown
                                FormatString="0.0"
                                Height="26"
                                Increment="0.1"
                                IsVisible="{CompiledBinding !Comparison.IsBlinkFast.Value}"
                                Maximum="5.0"
                                MinHeight="26"
                                Minimum="0.1"
                                Value="{CompiledBinding Comparison.BlinkInterval.Value,
                                                        Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Width="84" />
                        </StackPanel>
                    </Border>

                    <!--  Divider  -->
                    <Border
                        Background="{DynamicResource HoverBarBorderColor}"
                        Classes="barDivider"
                        Margin="2,0"
                        VerticalAlignment="Center" />

                    <!--  Pick A / Pick B  -->
                    <Border Background="{DynamicResource ComparePillGroupBackground}" CornerRadius="10">
                        <StackPanel Classes="barGroup" Spacing="2">
                            <Button
                                Classes="compareBtn MenuItemHover"
                                Command="{CompiledBinding ParentWindowContext.RunActionCommand}"
                                CommandParameter="{x:Static keybindings:Actions.ComparisonPickA}"
                                CornerRadius="10,0,0,10"
                                Padding="9,4"
                                ToolTip.Tip="{CompiledBinding ParentWindowContext.Translation.ComparisonPickA.Value}">
                                <TextBlock Classes="txt" Text="A" />
                            </Button>
                            <Button
                                Classes="compareBtn MenuItemHover"
                                Command="{CompiledBinding ParentWindowContext.RunActionCommand}"
                                CommandParameter="{x:Static keybindings:Actions.ComparisonPickB}"
                                CornerRadius="0,10,10,0"
                                Padding="9,4"
                                ToolTip.Tip="{CompiledBinding ParentWindowContext.Translation.ComparisonPickB.Value}">
                                <TextBlock Classes="txt" Text="B" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!--  Zoom Controls  -->
                    <StackPanel Classes="barGroup" Spacing="2">
                        <customControls:IconButton
                            Classes="compareIconBtn"
                            Command="{CompiledBinding ParentWindowContext.RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.ZoomOut}"
                            Icon="{StaticResource ZoomOutImage}"
                            IconHeight="14"
                            IconWidth="14"
                            ToolTip.Tip="{CompiledBinding ParentWindowContext.Translation.ZoomOut.Value}"
                            x:Name="ZoomOutButton" />
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{DynamicResource MainTextColor}"
                            MinWidth="38"
                            Text="100%"
                            TextAlignment="Center"
                            VerticalAlignment="Center"
                            x:Name="ZoomPercentText" />
                        <customControls:IconButton
                            Classes="compareIconBtn"
                            Command="{CompiledBinding ParentWindowContext.RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.ZoomIn}"
                            Icon="{StaticResource ZoomInImage}"
                            IconHeight="14"
                            IconWidth="14"
                            ToolTip.Tip="{CompiledBinding ParentWindowContext.Translation.ZoomIn.Value}" />
                    </StackPanel>

                    <!--  Swap A / B  -->
                    <customControls:IconButton
                        Classes="compareIconBtn"
                        Classes.active="{CompiledBinding Comparison.IsSwapped.Value}"
                        Command="{CompiledBinding ParentWindowContext.RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ComparisonSwap}"
                        Icon="{StaticResource LeftRightArrowsImage}"
                        IconHeight="14"
                        IconWidth="14"
                        ToolTip.Tip="{CompiledBinding ParentWindowContext.Translation.ComparisonSwap.Value}" />

                    <!--  Pin Pair  -->
                    <customControls:IconButton
                        Classes="compareIconBtn"
                        Classes.active="{CompiledBinding Comparison.IsPinned.Value}"
                        Command="{CompiledBinding ParentWindowContext.RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ComparisonPin}"
                        Icon="{StaticResource PinImage}"
                        IconHeight="14"
                        IconWidth="14"
                        ToolTip.Tip="{CompiledBinding ParentWindowContext.Translation.ComparisonPin.Value}"
                        x:Name="PinButton" />

                    <!--  Stretch Fill Toggle (Stacked Compare)  -->
                    <Button
                        Classes="compareIconBtn"
                        Classes.active="{CompiledBinding Comparison.IsStretchFill.Value}"
                        Click="OnStretchToggleClick"
                        IsVisible="{CompiledBinding !Comparison.IsSynced.Value}"
                        ToolTip.Tip="{CompiledBinding ParentWindowContext.Translation.ComparisonStretch.Value}"
                        x:Name="StretchButton">
                        <Path
                            Data="M3,6 L3,3 L6,3 M10,3 L13,3 L13,6 M13,10 L13,13 L10,13 M6,13 L3,13 L3,10 M6,6 L10,6 L10,10 L6,10 Z"
                            Height="13"
                            Stretch="Uniform"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="1.4"
                            Width="13" />
                    </Button>

                    <!--  2-Point Anchor Alignment  -->
                    <customControls:IconButton
                        Classes="compareIconBtn"
                        Classes.active="{CompiledBinding Comparison.IsAligning.Value}"
                        Click="OnAlignClick"
                        Data="{StaticResource ComparisonAlignGeometry}"
                        IconHeight="12"
                        IconWidth="12"
                        IsVisible="{CompiledBinding !Comparison.IsSynced.Value}"
                        ToolTip.Tip="{CompiledBinding ParentWindowContext.Translation.ComparisonAlign.Value}"
                        customControls:ContextualStackPanel.IsContextual="True"
                        x:Name="AlignButton" />

                    <customControls:IconButton
                        Classes="compareIconBtn"
                        Click="OnResetAlignClick"
                        Icon="{StaticResource ResetImage}"
                        IconHeight="12"
                        IconWidth="12"
                        IsVisible="{CompiledBinding Comparison.HasAlignment.Value}"
                        ToolTip.Tip="{CompiledBinding ParentWindowContext.Translation.ComparisonAlignReset.Value}"
                        customControls:ContextualStackPanel.IsContextual="True"
                        x:Name="ResetAlignButton" />

                    <TextBlock
                        Classes="txt"
                        IsVisible="{CompiledBinding Comparison.IsAligning.Value}"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        customControls:ContextualStackPanel.IsContextual="True"
                        x:Name="AlignHintText" />

                    <!--  Reset Zoom  -->
                    <customControls:IconButton
                        Classes="compareBtn MenuItemHover"
                        Command="{CompiledBinding ParentWindowContext.RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.ResetZoom}"
                        Icon="{StaticResource RefreshCcwOff}"
                        IconHeight="13"
                        IconWidth="13"
                        ToolTip.Tip="{CompiledBinding ParentWindowContext.Translation.ResetZoom.Value}" />

                    <!--  Bar Position  -->
                    <customControls:TextIconButton
                        Background="Transparent"
                        Icon="{StaticResource PanelBottomDashedImage}"
                        IconHeight="14"
                        IconMargin="0,0,5,0"
                        IconWidth="14"
                        x:Name="BarPositionButton">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem
                                    Click="OnBarPositionBottomClick"
                                    Header="{CompiledBinding ParentWindowContext.Translation.Bottom.Value}"
                                    x:Name="BarPositionBottomItem" />
                                <MenuItem
                                    Click="OnBarPositionTopClick"
                                    Header="{CompiledBinding ParentWindowContext.Translation.Top.Value}"
                                    x:Name="BarPositionTopItem" />
                                <MenuItem
                                    Click="OnBarPositionLeftClick"
                                    Header="{CompiledBinding ParentWindowContext.Translation.Left.Value}"
                                    x:Name="BarPositionLeftItem" />
                                <MenuItem
                                    Click="OnBarPositionRightClick"
                                    Header="{CompiledBinding ParentWindowContext.Translation.Right.Value}"
                                    x:Name="BarPositionRightItem" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </customControls:TextIconButton>

                </customControls:ContextualStackPanel>
            </customControls:AutoScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
