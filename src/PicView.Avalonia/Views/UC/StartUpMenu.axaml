<UserControl
    x:Class="PicView.Avalonia.Views.UC.StartUpMenu"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    x:DataType="viewModels:TabViewModel"
    Background="{DynamicResource StartUpMenuBackground}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SelectFileBrush" Color="{DynamicResource StartUpMenuForeground}" />
        <SolidColorBrush x:Key="OpenLastFileBrush" Color="{DynamicResource StartUpMenuForeground}" />
        <SolidColorBrush x:Key="PasteBrush" Color="{DynamicResource StartUpMenuForeground}" />
    </UserControl.Resources>
    <Panel>
        <Viewbox
            x:Name="LogoViewbox"
            Margin="15,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Image
                x:Name="Logo"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="{StaticResource LogoImage}"
                Stretch="Fill" />
        </Viewbox>
        <StackPanel
            x:Name="Buttons"
            Height="30"
            Margin="0,220,25,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">

            <Button x:Name="SelectFileButton" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Height="18"
                        Data="{StaticResource FolderGeometry}"
                        Fill="{StaticResource SelectFileBrush}"
                        Stretch="Uniform" />
                    <Label
                        x:Name="OpenFileDialogLabel"
                        Padding="8,9,15,5"
                        Content="{Binding ParentWindowContext.Translation.OpenFileDialog.Value}"
                        FontFamily="/Assets/Fonts/Roboto-Bold.ttf#Roboto"
                        FontSize="14"
                        Foreground="{StaticResource SelectFileBrush}" />
                </StackPanel>
            </Button>

            <Button x:Name="OpenLastFileButton" Background="Transparent">
                <StackPanel Height="30" Orientation="Horizontal">
                    <Path
                        Height="18"
                        Data="{StaticResource PlaySkipForwardGeometry}"
                        Fill="{StaticResource OpenLastFileBrush}"
                        Stretch="Uniform" />
                    <Label
                        x:Name="OpenLastFileLabel"
                        Padding="8,8,15,2"
                        FontFamily="/Assets/Fonts/Roboto-Bold.ttf#Roboto"
                        FontSize="14"
                        Foreground="{StaticResource OpenLastFileBrush}" />
                </StackPanel>
            </Button>

            <Button x:Name="PasteButton" Background="Transparent">
                <StackPanel Height="30" Orientation="Horizontal">
                    <Path
                        Width="20"
                        Height="20"
                        Data="{StaticResource PasteGeometry}"
                        Fill="{StaticResource PasteBrush}"
                        Stretch="Fill" />
                    <Label
                        x:Name="FilePasteLabel"
                        Padding="8,9,15,5"
                        FontFamily="/Assets/Fonts/Roboto-Bold.ttf#Roboto"
                        FontSize="14"
                        Foreground="{StaticResource PasteBrush}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Panel>
</UserControl>