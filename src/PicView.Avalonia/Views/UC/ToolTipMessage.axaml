<UserControl
    x:Class="PicView.Avalonia.Views.UC.ToolTipMessage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    x:DataType="viewModels:MainWindowViewModel"
    IsHitTestVisible="False"
    Opacity="0"
    ZIndex="99">
    <Border
        Background="{DynamicResource PopUpBackgroundColor}"
        BorderBrush="{DynamicResource PopUpMainBorderColor}"
        BorderThickness="1"
        CornerRadius="6">

        <TextBlock
            x:Name="ToolTipMessageText"
            Padding="12"
            Classes="txt bold" />
    </Border>
</UserControl>