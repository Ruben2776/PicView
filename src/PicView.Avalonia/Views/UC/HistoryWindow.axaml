<UserControl
    x:Class="PicView.Avalonia.Views.UC.HistoryWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PicView.Avalonia.ViewModels"
    xmlns:converters="using:PicView.Avalonia.Converters"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:uc="clr-namespace:PicView.Avalonia.Views.UC"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:HistoryRedoGreyOpacityConverter x:Key="RedoGreyOpacityConverter" />
        <converters:HistoryEditKindToGeometryConverter x:Key="EditKindToGeometry"/>
    </UserControl.Resources>


    <Border
        Background="{DynamicResource MainBackgroundColor}"
        BorderBrush="{DynamicResource MainBorderColor}"
        BorderThickness="1"
        CornerRadius="6"
        Classes="shadow-lg">

        <Grid RowDefinitions="Auto,*" Margin="0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Margin="2,0,0,0" Text="History" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <customControls:IconButton
                    Grid.Column="1"
                    Classes="altHover mainBtn"
                    CornerRadius="0,6,0,0"
                    Data="{StaticResource CloseGeometry}"
                    Foreground="{DynamicResource MainTextColor}"
                    Command="{CompiledBinding HistoryManager.CloseCommand}"
                    Height="22"
                    Width="36"
                    IconHeight="18"
                    IconWidth="10"
                    Padding="1"
                    ToolTip.Tip="{CompiledBinding Translation.Close.Value}"
                    x:Name="CloseButton" />                
            </Grid>

            <ListBox
                Grid.Row="1"
                ItemsSource="{Binding HistoryManager.WindowVm.Items}"
                SelectedIndex="{Binding HistoryManager.WindowVm.SelectedIndex.Value}"
                BorderThickness="0"
                Background="Transparent">
                <ListBox.Styles>
                    <!-- Optional: kill ListBoxItem borders -->
                    <Style Selector="ListBoxItem">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>

                    <!-- Selected: red background, white text -->
                    <Style Selector="ListBoxItem:selected Border#RowBg">
                        <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected TextBlock">
                        <Setter Property="Foreground" Value="White"/>
                    </Style>

                    <!-- Hover (non-selected): blue background, white text -->
                    <Style Selector="ListBoxItem:pointerover:not(:selected) Border#RowBg">
                        <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover:not(:selected) TextBlock">
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <Border x:Name="RowBg" Padding="6">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <Grid.Opacity>
                                    <MultiBinding Converter="{StaticResource RedoGreyOpacityConverter}">
                                        <Binding Path="IsRedoBranch.Value"/>
                                        <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}" Path="IsSelected"/>
                                    </MultiBinding>
                                </Grid.Opacity>

                                <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding Subtitle}" HorizontalAlignment="Left" Opacity="0.8" FontSize="10" />
                                </StackPanel>

                                <Path Grid.Column="1"
                                    Data="{Binding Kind, Converter={StaticResource EditKindToGeometry}}"
                                    Stroke="{DynamicResource MainTextColor}"
                                    StrokeThickness="1.4"
                                    StrokeJoin="Round"
                                    Width="16" Height="16"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Stretch="UniformToFill"
                                    Margin="6,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
