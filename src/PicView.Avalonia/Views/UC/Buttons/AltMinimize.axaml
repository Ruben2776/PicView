<UserControl
    x:Class="PicView.Avalonia.Views.UC.Buttons.AltMinimize"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    Height="{StaticResource TopBorderHeight}"
    x:DataType="viewModels:MainWindowViewModel"
    Background="Transparent">
    <Button
        x:Name="XButton"
        Width="35"
        Height="{StaticResource TopBorderHeight}"
        VerticalAlignment="Top"
        Background="{DynamicResource PopUpBackgroundColor}"
        BorderBrush="{DynamicResource PopUpMainBorderColor}"
        BorderThickness="1,0,0,1"
        Classes="hover"
        ClickMode="Release"
        Command="{CompiledBinding MinimizeCommand}"
        IsVisible="{CompiledBinding !IsUIShown.Value}"
        ZIndex="99">
        <Viewbox Width="15" Height="15">
            <Path
                x:Name="Icon"
                Margin="7.5,0,0,7"
                Data="{StaticResource MinimizeGeometry}"
                Fill="{DynamicResource MainTextColor}"
                Stretch="Fill" />
        </Viewbox>
    </Button>
</UserControl>
