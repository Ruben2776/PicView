<UserControl
    x:Class="PicView.Avalonia.Views.UC.Buttons.SettingsMenuButton"
    x:DataType="viewModels:CoreViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:keybindings="using:PicView.Core.Keybindings"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <customControls:IconButton
        Background="{DynamicResource WindowButtonBackgroundColor}"
        Classes="WindowToolButtonHover"
        ClickMode="Press"
        Foreground="{DynamicResource MainTextColor}"
        Icon="{StaticResource MenuImage}"
        IconHeight="12"
        IconWidth="12"
        IsRepeatEnabled="False"
        Width="30"
        x:Name="SettingsButton">
        <customControls:IconButton.Flyout>
            <MenuFlyout FlyoutPresenterClasses="noCornerRadius" Placement="Bottom">
                <customControls:StyledMenuItem
                    Command="{CompiledBinding MainWindows.ActiveWindow.Value.RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ShowSettingsFile}"
                    Foreground="{DynamicResource MainTextColor}"
                    Header="UserSettings.json"
                    x:Name="UserSettingsItem">
                    <MenuItem.Icon>
                        <Image
                            Height="12"
                            Source="{StaticResource BracesImage}"
                            Width="12" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>
                <customControls:StyledMenuItem
                    Command="{CompiledBinding MainWindows.ActiveWindow.Value.RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ShowKeybindingsFile}"
                    Foreground="{DynamicResource MainTextColor}"
                    Header="keybindings.json"
                    x:Name="KeybindingsItem">
                    <MenuItem.Icon>
                        <Image
                            Height="12"
                            Source="{StaticResource BracesImage}"
                            Width="12" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>

                <Separator IsVisible="{CompiledBinding GlobalSettings.CanChooseConfigLocation}" />
                <customControls:StyledMenuItem
                    Command="{CompiledBinding MainWindows.ActiveWindow.Value.RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetConfigLocationAuto}"
                    Foreground="{DynamicResource MainTextColor}"
                    GroupName="ConfigLocation"
                    Header="{CompiledBinding Translation.Auto.Value,
                                             Mode=OneWay}"
                    IsChecked="{CompiledBinding GlobalSettings.IsConfigAuto.Value,
                                                Mode=OneWay}"
                    IsVisible="{CompiledBinding GlobalSettings.CanChooseConfigLocation}"
                    ToggleType="Radio" />
                <customControls:StyledMenuItem
                    Command="{CompiledBinding MainWindows.ActiveWindow.Value.RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetConfigLocationPortable}"
                    Foreground="{DynamicResource MainTextColor}"
                    GroupName="ConfigLocation"
                    Header="{CompiledBinding Translation.Portable.Value,
                                             Mode=OneWay}"
                    IsChecked="{CompiledBinding GlobalSettings.IsConfigPortable.Value,
                                                Mode=OneWay}"
                    IsVisible="{CompiledBinding GlobalSettings.CanChooseConfigLocation}"
                    ToggleType="Radio" />
                <customControls:StyledMenuItem
                    Command="{CompiledBinding MainWindows.ActiveWindow.Value.RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.SetConfigLocationRoaming}"
                    Foreground="{DynamicResource MainTextColor}"
                    GroupName="ConfigLocation"
                    Header="{CompiledBinding Translation.Roaming.Value,
                                             Mode=OneWay}"
                    IsChecked="{CompiledBinding GlobalSettings.IsConfigRoaming.Value,
                                                Mode=OneWay}"
                    IsVisible="{CompiledBinding GlobalSettings.CanChooseConfigLocation}"
                    ToggleType="Radio" />
                <Separator IsVisible="{CompiledBinding GlobalSettings.CanChooseConfigLocation}" />

                <customControls:StyledMenuItem
                    Command="{CompiledBinding MainWindows.ActiveWindow.Value.RunActionCommand}"
                    CommandParameter="{x:Static keybindings:Actions.ResetSettings}"
                    Foreground="{DynamicResource MainTextColor}"
                    Header="{CompiledBinding Translation.ResetButtonText.Value,
                                             Mode=OneWay}">
                    <MenuItem.Icon>
                        <Image
                            Height="12"
                            Source="{StaticResource ResetImage}"
                            Width="12" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>
            </MenuFlyout>
        </customControls:IconButton.Flyout>
    </customControls:IconButton>
</UserControl>