<UserControl
    x:Class="PicView.Avalonia.Views.UC.Buttons.AltRestore"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="viewModels:MainWindowViewModel"
    Background="Transparent"
    mc:Ignorable="d">
    <Button
        x:Name="RestoreButton"
        Width="35"
        Height="30"
        VerticalAlignment="Top"
        Background="{DynamicResource PopUpBackgroundColor}"
        BorderBrush="{DynamicResource PopUpMainBorderColor}"
        BorderThickness="1,0,0,1"
        Classes="hover"
        ClickMode="Release"
        Command="{CompiledBinding ToggleFullscreenCommand}"
        CornerRadius="0,0,0,0"
        IsVisible="{CompiledBinding !IsUIShown.Value}"
        ZIndex="99">
        <Panel>
            <Path
                x:Name="FullScreenIcon"
                Width="12"
                Height="12"
                Margin="0,0,0,3"
                Data="{StaticResource FullscreenGeometry}"
                Fill="{DynamicResource MainTextColor}"
                IsVisible="{CompiledBinding !IsFullscreen.Value}"
                Stretch="Fill" />
            <Path
                x:Name="RestoreIcon"
                Width="12"
                Height="12"
                Margin="0,0,0,3"
                Data="{StaticResource RestoreGeometry}"
                Fill="{DynamicResource MainTextColor}"
                IsVisible="{CompiledBinding IsFullscreen.Value}"
                Stretch="Fill" />
        </Panel>
    </Button>
</UserControl>
