<UserControl
    x:Class="PicView.Avalonia.Views.UC.Buttons.AltClose"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    x:DataType="viewModels:MainWindowViewModel"
    Background="Transparent">
    <Button
        x:Name="XButton"
        Width="35"
        Height="30"
        VerticalAlignment="Top"
        Background="{DynamicResource PopUpBackgroundColor}"
        BorderBrush="{DynamicResource PopUpMainBorderColor}"
        BorderThickness="1,0,0,1"
        Classes="hover"
        ClickMode="Release"
        Command="{CompiledBinding ExitCommand}"
        CornerRadius="0,0,0,0"
        IsVisible="{CompiledBinding !IsUIShown.Value}"
        ToolTip.Tip="{CompiledBinding Translation.Close.Value,
                                      Mode=OneWay}"
        ZIndex="99">
        <Path
            Width="12"
            Height="12"
            Margin="0,0,0,3"
            Data="{StaticResource CloseGeometry}"
            Fill="{DynamicResource MainTextColor}"
            Stretch="Fill" />
    </Button>
</UserControl>
