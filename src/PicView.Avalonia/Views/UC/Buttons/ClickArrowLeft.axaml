<UserControl
    x:Class="PicView.Avalonia.Views.UC.Buttons.ClickArrowLeft"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    Width="100"
    Height="200"
    x:DataType="viewModels:TabViewModel"
    Background="Transparent"
    Focusable="False">
    <RepeatButton
        x:Name="PolyButton"
        Width="50"
        Height="60"
        HorizontalAlignment="Left"
        Background="{DynamicResource PopUpBackgroundColor}"
        BorderBrush="{DynamicResource PopUpMainBorderColor}"
        BorderThickness="0,1,1,1"
        Classes="hover"
        Command="{CompiledBinding Prev}"
        CornerRadius="0, 2, 2, 0"
        IsVisible="{CompiledBinding CanNavigateBackwards.Value,
                                    FallbackValue=False}">
        <Polygon
            x:Name="ArrowPolygon"
            Width="20"
            Height="40"
            Margin="0,5,5,0"
            Fill="{DynamicResource MainTextColor}"
            Points="352,128.4 319.7,96 160,256 160,256 160,256 319.7,416 352,383.6 224.7,256"
            RenderTransformOrigin="0.5,0.5"
            Stretch="Uniform" />
    </RepeatButton>
</UserControl>