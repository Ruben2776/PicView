<customControls:AnimatedPopUp
    ClickingOutsideCloses="True"
    Padding="20"
    x:Class="PicView.Avalonia.Views.UC.PopUps.QuickEditingDialog"
    x:DataType="viewModels:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <customControls:AutoScrollViewer>
        <StackPanel Background="Transparent">

            <!--  Tool Windows  -->
            <TextBlock
                Classes="txt bold"
                FontSize="14"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Text="{CompiledBinding Translation.ToolWindows.Value}" />

            <Border
                Background="{DynamicResource MenuBackgroundColor}"
                BorderBrush="{DynamicResource MenuBorderColor}"
                BorderThickness="1"
                CornerRadius="4">
                <WrapPanel Orientation="Horizontal">
                    <!--  Single Resize  -->
                    <Button
                        Background="Transparent"
                        BorderBrush="{DynamicResource MenuBorderColor}"
                        BorderThickness="0,0,1,0"
                        Classes="MenuItemHover"
                        CornerRadius="4,0,0,4"
                        Height="35"
                        Padding="15,0"
                        ToolTip.Tip="{CompiledBinding Translation.ShowAllSettingsWindow.Value,
                                                      Mode=OneWay}"
                        Width="185"
                        x:Name="SingleResizeButton">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Height="54" Width="45">
                                <Image
                                    Canvas.Left="5"
                                    Canvas.Top="16"
                                    Height="19">
                                    <Image.Source>
                                        <DrawingImage>
                                            <DrawingImage.Drawing>
                                                <DrawingGroup ClipGeometry="M0,0 V512 H512 V0 H0 Z">
                                                    <GeometryDrawing Brush="{DynamicResource MainTextColor}" Geometry="F1 M512,512z M0,0z M464,448L48,448C21.49,448,0,426.51,0,400L0,112C0,85.49,21.49,64,48,64L464,64C490.51,64,512,85.49,512,112L512,400C512,426.51,490.51,448,464,448z M112,120C81.072,120 56,145.072 56,176 56,206.928 81.072,232 112,232 142.928,232 168,206.928 168,176 168,145.072 142.928,120 112,120z M64,384L448,384 448,272 360.485,184.485C355.799,179.799,348.201,179.799,343.514,184.485L208,320 152.485,264.485C147.799,259.799,140.201,259.799,135.514,264.485L64,336 64,384z" />
                                                </DrawingGroup>
                                            </DrawingImage.Drawing>
                                        </DrawingImage>
                                    </Image.Source>
                                </Image>
                                <Image
                                    Canvas.Left="20"
                                    Canvas.Top="20.5"
                                    Height="14"
                                    Opacity=".8">
                                    <Image.Source>
                                        <DrawingImage>
                                            <DrawingImage.Drawing>
                                                <DrawingGroup ClipGeometry="M0,0 V512 H512 V0 H0 Z">
                                                    <GeometryDrawing Brush="{DynamicResource MainTextColor}" Geometry="F1 M512,512z M0,0z M464,448L48,448C21.49,448,0,426.51,0,400L0,112C0,85.49,21.49,64,48,64L464,64C490.51,64,512,85.49,512,112L512,400C512,426.51,490.51,448,464,448z M112,120C81.072,120 56,145.072 56,176 56,206.928 81.072,232 112,232 142.928,232 168,206.928 168,176 168,145.072 142.928,120 112,120z M64,384L448,384 448,272 360.485,184.485C355.799,179.799,348.201,179.799,343.514,184.485L208,320 152.485,264.485C147.799,259.799,140.201,259.799,135.514,264.485L64,336 64,384z" />
                                                </DrawingGroup>
                                            </DrawingImage.Drawing>
                                        </DrawingImage>
                                    </Image.Source>
                                </Image>
                            </Canvas>

                            <TextBlock
                                Classes="txt"
                                Margin="0,0,5,0"
                                MaxWidth="170"
                                Text="{CompiledBinding Translation.ResizeImage.Value,
                                                       Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!--  Batch Resize  -->
                    <customControls:TextIconButton
                        Background="Transparent"
                        Classes="MenuItemHover"
                        CornerRadius="0,4,4,0"
                        Foreground="{DynamicResource MainTextColor}"
                        Height="35"
                        Icon="{StaticResource BatchResizeImage}"
                        IconHeight="22"
                        IconMargin="5,0,10,0"
                        IconWidth="22"
                        Padding="15,0"
                        Text="{CompiledBinding Translation.BatchResize.Value,
                                               Mode=OneWay}"
                        TextMargin="0,0,8,0"
                        TextMaxWidth="170"
                        ToolTip.Tip="{CompiledBinding Translation.BatchResize.Value,
                                                      Mode=OneWay}"
                        Width="185"
                        x:Name="BatchResizeButton" />
                </WrapPanel>

            </Border>

            <Border
                Background="{DynamicResource MenuBackgroundColor}"
                BorderBrush="{DynamicResource MenuBorderColor}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,5,0,0">
                <WrapPanel Orientation="Horizontal">
                    <!--  Image info window  -->
                    <customControls:TextIconButton
                        Background="Transparent"
                        BorderBrush="{DynamicResource MenuBorderColor}"
                        BorderThickness="0,0,1,0"
                        Classes="MenuItemHover"
                        CornerRadius="4,0,0,4"
                        Data="{StaticResource ImageInfoGeometry}"
                        Foreground="{DynamicResource MainTextColor}"
                        IconHeight="18"
                        IconMargin="5,0,10,0"
                        IconWidth="18"
                        Padding="15,10"
                        Text="{CompiledBinding Translation.ImageInfo.Value,
                                               Mode=OneWay}"
                        TextMargin="0,0,5,0"
                        TextMaxWidth="170"
                        ToolTip.Tip="{CompiledBinding Translation.ImageInfo.Value,
                                                      Mode=OneWay}"
                        Width="185"
                        x:Name="ImageInfoButton" />

                    <!--  Image effects window  -->
                    <customControls:TextIconButton
                        Background="Transparent"
                        Classes="MenuItemHover"
                        CornerRadius="0,4,4,0"
                        Foreground="{DynamicResource MainTextColor}"
                        Icon="{StaticResource SparklesImage}"
                        IconHeight="18"
                        IconMargin="5,0,10,0"
                        IconWidth="18"
                        Padding="15,10"
                        Text="{CompiledBinding Translation.Effects.Value,
                                               Mode=OneWay}"
                        TextMargin="0,0,8,0"
                        TextMaxWidth="170"
                        ToolTip.Tip="{CompiledBinding Translation.EffectsTooltip.Value,
                                                      Mode=OneWay}"
                        Width="185"
                        x:Name="ImageEffectsButton" />
                </WrapPanel>


            </Border>

            <TextBlock
                Classes="txt bold"
                FontSize="14"
                HorizontalAlignment="Center"
                Margin="0,15,0,20"
                Text="{CompiledBinding Translation.AdditionalFunctions.Value}" />

            <WrapPanel MaxWidth="375" Orientation="Horizontal">

                <!--  Crop  -->
                <customControls:TextIconButton
                    Background="{DynamicResource MenuButtonBackground}"
                    BorderBrush="{DynamicResource MenuBorderColor}"
                    BorderThickness="1"
                    Classes="MenuItemHover"
                    CornerRadius="4"
                    Foreground="{DynamicResource MainTextColor}"
                    Height="42"
                    Icon="{StaticResource CropImage}"
                    IconHeight="15"
                    IconMargin="15,0,10,0"
                    IconWidth="15"
                    Margin="6,0,4,8"
                    Text="{CompiledBinding Translation.Crop.Value,
                                           Mode=OneWay}"
                    TextMaxWidth="145"
                    ToolTip.Tip="{CompiledBinding Translation.Crop.Value,
                                                  Mode=OneWay}"
                    Width="175"
                    x:Name="CropButton" />

                <!--  Show docked gallery  -->
                <customControls:TextIconButton
                    Background="{DynamicResource MenuButtonBackground}"
                    BorderBrush="{DynamicResource MenuBorderColor}"
                    BorderThickness="1"
                    Classes="MenuItemHover"
                    CornerRadius="4"
                    Data="{StaticResource GalleryGeometry}"
                    Foreground="{DynamicResource MainTextColor}"
                    Height="42"
                    IconHeight="15"
                    IconMargin="15,0,10,0"
                    IconWidth="15"
                    Margin="6,0,4,8"
                    Text="{CompiledBinding DockedGalleryToggleHeader.Value,
                                           Mode=OneWay}"
                    TextMaxWidth="145"
                    ToolTip.Tip="{CompiledBinding DockedGalleryToggleHeader.Value,
                                                  Mode=OneWay}"
                    Width="175"
                    x:Name="ShowDockedGalleryButton" />

                <!--  Side by side  -->
                <customControls:TextToggleButton
                    Background="{DynamicResource MenuButtonBackground}"
                    BorderBrush="{DynamicResource MenuBorderColor}"
                    BorderThickness="1"
                    Classes="MenuItemHover"
                    CornerRadius="4"
                    Foreground="{DynamicResource MainTextColor}"
                    Height="42"
                    IsChecked="{Binding WindowSettings.IsSideBySide.Value, Mode=OneWay}"
                    Margin="6,0,4,8"
                    Text="{CompiledBinding Translation.SideBySide.Value,
                                           Mode=OneWay}"
                    TextMaxWidth="145"
                    ToolTip.Tip="{CompiledBinding Translation.SideBySide.Value,
                                                  Mode=OneWay}"
                    Width="175"
                    x:Name="SideBySideButton" />


            </WrapPanel>
        </StackPanel>
    </customControls:AutoScrollViewer>
</customControls:AnimatedPopUp>
