<customControls:AnimatedPopUp
    ClickingOutsideCloses="False"
    x:Class="PicView.Avalonia.Views.UC.PopUps.FavoriteDialog"
    x:DataType="viewModels:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Panel>
        <customControls:IconButton
            Background="{DynamicResource PopUpBackgroundColor}"
            BorderBrush="{DynamicResource PopUpMainBorderColor}"
            BorderThickness="1"
            Classes="hover"
            Click="CloseMenu"
            CornerRadius="50"
            Data="{StaticResource CloseGeometry}"
            Focusable="True"
            Foreground="{DynamicResource MainTextColor}"
            Height="50"
            HorizontalAlignment="Right"
            IconHeight="18"
            IconWidth="18"
            IsTabStop="True"
            Margin="0,-15,-10,0"
            VerticalAlignment="Top"
            Width="50"
            ZIndex="1"
            x:Name="CloseButton" />
        <StackPanel
            Background="Transparent"
            VerticalAlignment="Center"
            Width="425">

            <TextBlock
                Classes="txt bold"
                Margin="0,15"
                Text="{Binding Translation.AddFavorite.Value}"
                TextAlignment="Center" />

            <DockPanel LastChildFill="True">

                <customControls:IconButton
                    Background="{DynamicResource ToolWindowButtonBackground}"
                    BorderBrush="{DynamicResource ToolWindowButtonBorderColor}"
                    BorderThickness="1"
                    Classes="ToolButtonHover"
                    CornerRadius="6"
                    DockPanel.Dock="Right"
                    Icon="{StaticResource AddFolderImage}"
                    IconHeight="14"
                    IconWidth="14"
                    Margin="2,0,5,0"
                    Padding="8,0" />

                <customControls:FuncTextBox
                    Classes="TStyle"
                    DockPanel.Dock="Left"
                    Focusable="True"
                    FontFamily="/Assets/Fonts/Roboto-Regular.ttf#Roboto"
                    Foreground="{DynamicResource MainTextColor}"
                    IsReadOnly="False"
                    IsTabStop="True"
                    Margin="10,0"
                    Padding="8"
                    TextWrapping="Wrap"
                    x:Name="PathBox" />

            </DockPanel>

            <customControls:KeybindBox
                ActionName="Key:"
                Classes="TStyle"
                DockPanel.Dock="Right"
                Focusable="True"
                FontFamily="/Assets/Fonts/Roboto-Regular.ttf#Roboto"
                Foreground="{DynamicResource MainTextColor}"
                IsTabStop="True"
                Margin="10,5"
                Width="NaN"
                x:Name="KeyBox" />

            <StackPanel
                HorizontalAlignment="Right"
                Margin="0,20,10,20"
                Orientation="Horizontal"
                VerticalAlignment="Bottom">
                <Button
                    Classes="ToolWindowBorderStyle ToolButtonHover"
                    Focusable="True"
                    HotKey="Escape"
                    IsCancel="True"
                    IsTabStop="True"
                    Margin="0,0,10,0"
                    Padding="30,0"
                    Width="NaN"
                    x:Name="CancelButton">
                    <TextBlock
                        Classes="txt"
                        Foreground="{DynamicResource MainTextColor}"
                        Text="{CompiledBinding Translation.Cancel.Value}" />
                </Button>
                <Button
                    Background="{DynamicResource AccentColor}"
                    Classes="ToolWindowBorderStyle PrimaryBtnHover"
                    Focusable="True"
                    HotKey="Enter"
                    IsDefault="True"
                    IsTabStop="True"
                    Padding="30,0"
                    Width="NaN"
                    x:Name="SaveButton">
                    <TextBlock
                        Classes="txt"
                        Foreground="{StaticResource SecondaryTextColor}"
                        Text="{CompiledBinding Translation.Save.Value}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Panel>
</customControls:AnimatedPopUp>
