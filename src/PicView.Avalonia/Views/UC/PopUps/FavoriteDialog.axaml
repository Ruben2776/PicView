<customControls:AnimatedPopUp
    x:Class="PicView.Avalonia.Views.UC.PopUps.FavoriteDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    x:DataType="viewModels:MainWindowViewModel"
    ClickingOutsideCloses="False">

    <Panel>
        <customControls:IconButton
            x:Name="CloseButton"
            Width="50"
            Height="50"
            Margin="0,-15,-10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{DynamicResource PopUpBackgroundColor}"
            BorderBrush="{DynamicResource PopUpMainBorderColor}"
            BorderThickness="1"
            Classes="hover"
            Click="CloseMenu"
            CornerRadius="50"
            Data="{StaticResource CloseGeometry}"
            Focusable="True"
            Foreground="{DynamicResource MainTextColor}"
            IconHeight="18"
            IconWidth="18"
            IsTabStop="True"
            ZIndex="1" />
        <StackPanel
            Width="425"
            VerticalAlignment="Center"
            Background="Transparent">

            <TextBlock
                Margin="0,15"
                Classes="txt bold"
                Text="{Binding Translation.AddFavorite.Value}"
                TextAlignment="Center" />

            <DockPanel LastChildFill="True">

                <TextBlock
                    Margin="7,0,10,0"
                    Classes="txt"
                    Text="{Binding Translation.Folder.Value}"
                    TextAlignment="Center" />

                <customControls:IconButton
                    Margin="2,0,10,0"
                    Padding="8,0"
                    Background="{DynamicResource ToolWindowButtonBackground}"
                    BorderBrush="{DynamicResource ToolWindowButtonBorderColor}"
                    BorderThickness="1"
                    Classes="ToolButtonHover"
                    Command="{Binding Favorites.AddFromFolderCommand}"
                    CornerRadius="6"
                    DockPanel.Dock="Right"
                    FontFamily="/Assets/Fonts/Roboto-Regular.ttf#Roboto"
                    Icon="{StaticResource AddFolderImage}"
                    IconHeight="14"
                    IconWidth="14" />

                <customControls:FuncTextBox
                    x:Name="PathBox"
                    Margin="10,0"
                    Padding="8"
                    Classes="TStyle"
                    DockPanel.Dock="Left"
                    Focusable="True"
                    FontFamily="/Assets/Fonts/Roboto-Regular.ttf#Roboto"
                    Foreground="{DynamicResource MainTextColor}"
                    IsReadOnly="False"
                    IsTabStop="True"
                    TextWrapping="Wrap" />

            </DockPanel>

            <customControls:KeybindBox
                x:Name="KeyBox"
                Width="NaN"
                Margin="7,7,10,0"
                ActionName="{Binding Translation.Hotkey.Value}"
                Classes="TStyle"
                DockPanel.Dock="Right"
                Focusable="True"
                IsTabStop="True"
                MaxTags="1"
                Theme="{StaticResource Detached}" />

            <StackPanel
                Margin="0,20,10,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal">
                <Button
                    x:Name="CancelButton"
                    Width="NaN"
                    Margin="0,0,10,0"
                    Padding="30,0"
                    Classes="ToolWindowBorderStyle ToolButtonHover"
                    Click="CloseMenu"
                    Focusable="True"
                    HotKey="Escape"
                    IsCancel="True"
                    IsTabStop="True">
                    <TextBlock
                        Classes="txt"
                        Foreground="{DynamicResource MainTextColor}"
                        Text="{CompiledBinding Translation.Cancel.Value}" />
                </Button>
                <Button
                    x:Name="SaveButton"
                    Width="NaN"
                    Padding="30,0"
                    Background="{DynamicResource AccentColor}"
                    Classes="ToolWindowBorderStyle PrimaryBtnHover"
                    Focusable="True"
                    HotKey="Enter"
                    IsDefault="True"
                    IsTabStop="True">
                    <TextBlock
                        Classes="txt"
                        Foreground="{StaticResource SecondaryTextColor}"
                        Text="{CompiledBinding Translation.Save.Value}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Panel>
</customControls:AnimatedPopUp>
