<customControls:AnimatedPopUp
    Background="Transparent"
    ContextMenu="{StaticResource MainMenu}"
    ZIndex="99"
    x:Class="PicView.Avalonia.Views.UC.PopUps.FileSearchDialog"
    x:DataType="viewModels:CoreViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <customControls:AnimatedPopUp.Resources>
        <ContextMenu x:Key="MainMenu">
            <!--  Close  -->
            <customControls:StyledMenuItem
                Click="CloseMenu"
                Header="{CompiledBinding Translation.Close.Value,
                                         Mode=OneWay}"
                x:Name="CloseMenuItem">
                <MenuItem.Icon>
                    <Path
                        Data="{StaticResource CloseGeometry}"
                        Fill="{DynamicResource MainTextColor}"
                        Height="12"
                        Stretch="Fill"
                        Width="12" />
                </MenuItem.Icon>
            </customControls:StyledMenuItem>
        </ContextMenu>
    </customControls:AnimatedPopUp.Resources>

    <Panel>
        <customControls:IconButton
            Background="{DynamicResource PopUpBackgroundColor}"
            BorderBrush="{DynamicResource PopUpMainBorderColor}"
            BorderThickness="1"
            Classes="hover"
            Click="CloseMenu"
            CornerRadius="50"
            Data="{StaticResource CloseGeometry}"
            Height="50"
            HorizontalAlignment="Right"
            IconHeight="18"
            IconWidth="18"
            Margin="0,-15,-10,0"
            VerticalAlignment="Top"
            Width="50"
            ZIndex="1"
            x:Name="CloseButton" />
        <StackPanel
            Background="Transparent"
            VerticalAlignment="Center"
            Width="425">

            <TextBlock
                Classes="txt bold"
                Margin="0,15"
                Text="{Binding Translation.Search.Value}"
                TextAlignment="Center" />

            <Panel>
                <Image
                    Height="16"
                    HorizontalAlignment="Left"
                    Margin="20,0,0,5"
                    Source="{StaticResource SearchImage}"
                    Width="16"
                    ZIndex="1" />

                <customControls:FuncTextBox
                    BorderThickness="1"
                    CornerRadius="3"
                    Margin="0,0,0,5"
                    Padding="35,7,4,7"
                    PlaceholderText="{CompiledBinding Translation.Search.Value,
                                                      Mode=OneWay}"
                    VerticalAlignment="Center"
                    Width="400"
                    x:Name="SearchBox" />
            </Panel>

            <Border
                BorderBrush="{DynamicResource MenuBorderColor}"
                BorderThickness="0,1,1,1"
                CornerRadius="6"
                IsVisible="{Binding !!SharedNavigationService.FilteredFileInfos.Value.Count}">
                <customControls:AutoScrollViewer MaxHeight="550">
                    <Border
                        Background="{DynamicResource MenuBackgroundColor}"
                        BorderBrush="{DynamicResource MenuBorderColor}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ItemsControl
                            ItemsSource="{CompiledBinding SharedNavigationService.FilteredFileInfos.Value}"
                            KeyboardNavigation.TabNavigation="Cycle"
                            x:Name="SearchItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource MenuBorderColor}"
                                        BorderThickness="0,0,0,1"
                                        Classes="MenuItemHover"
                                        Command="{Binding #SearchBox.((viewModels:CoreViewModel)DataContext).SharedNavigationService.LoadFromStringCommand}"
                                        CommandParameter="{Binding File.FullName}"
                                        Focusable="True"
                                        IsTabStop="True"
                                        Padding="5,10">
                                        <customControls:HighlightableTextBlock
                                            Classes="txt"
                                            HighlightBrush="{DynamicResource AccentColor}"
                                            HighlightEnd="{Binding MatchEndIndex}"
                                            HighlightStart="{Binding MatchStartIndex}"
                                            IsHitTestVisible="False"
                                            Margin="2,0,0,0"
                                            Text="{Binding File.Name}"
                                            TextWrapping="Wrap" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </customControls:AutoScrollViewer>
            </Border>

        </StackPanel>
    </Panel>
</customControls:AnimatedPopUp>