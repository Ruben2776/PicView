<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type customControls:TextToggleButton}" TargetType="ToggleButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type customControls:TextToggleButton}">
                <Border
                    Name="border"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <StackPanel Orientation="Horizontal">
                        <Decorator
                            Margin="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <Canvas Width="20" Height="20">
                                <Image
                                    x:Name="TickMark"
                                    Width="18"
                                    Height="18"
                                    IsVisible="False"
                                    Source="{StaticResource SquareCheckImage}" />

                                <Path
                                    x:Name="CrossMark"
                                    Width="11"
                                    Height="11"
                                    Margin="2,3.9,5,0"
                                    Data="{StaticResource CrossMarkGeometry}"
                                    Fill="{TemplateBinding Foreground}"
                                    IsVisible="True"
                                    Stretch="Fill" />
                            </Canvas>
                        </Decorator>
                        <TextBlock
                            Name="text"
                            MaxWidth="{TemplateBinding TextMaxWidth}"
                            Margin="{TemplateBinding TextMargin}"
                            VerticalAlignment="Center"
                            FontFamily="/Assets/Fonts/Roboto-Medium.ttf#Roboto"
                            FontSize="12"
                            Foreground="{TemplateBinding Foreground}"
                            LineHeight="18"
                            Text="{TemplateBinding Text}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:checked">
            <Style Selector="^ /template/ Image#TickMark">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ /template/ Path#CrossMark">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <Style Selector="^:unchecked">
            <Style Selector="^ /template/ Image#TickMark">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ Path#CrossMark">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^.MenuItemHover:pointerover /template/ Border#border">
            <Style.Animations>
                <Animation IterationCount="1" Duration="{StaticResource ButtonHoverAnimationDuration}">
                    <KeyFrame>
                        <Setter Property="Background">
                            <SolidColorBrush Color="Transparent" />
                        </Setter>
                    </KeyFrame>
                    <KeyFrame Cue="1">
                        <Setter Property="Background">
                            <SolidColorBrush Color="{DynamicResource MenuItemHoverBackground}" />
                        </Setter>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
            <Setter Property="Background" Value="{DynamicResource MenuItemHoverBackground}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource ThemeDisabledOpacity}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>