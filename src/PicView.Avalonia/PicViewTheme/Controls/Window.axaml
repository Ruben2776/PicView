<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="Window" x:Key="{x:Type Window}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TransparencyBackgroundFallback" Value="#000" />
        <Setter Property="Foreground" Value="{StaticResource MainTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource WindowBorderColor}" />
        <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="-1" />
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
        <Setter Property="WindowDecorations" Value="Full" />
        <Setter Property="TransparencyLevelHint" Value="AcrylicBlur" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <VisualLayerManager>
                        <Panel>
                            <ExperimentalAcrylicBorder IsHitTestVisible="False" Name="PART_AcrylicBorder">
                                <ExperimentalAcrylicBorder.Material>
                                    <ExperimentalAcrylicMaterial
                                        BackgroundSource="Digger"
                                        MaterialOpacity="0.1"
                                        TintColor="Black"
                                        TintOpacity=".9" />
                                </ExperimentalAcrylicBorder.Material>
                            </ExperimentalAcrylicBorder>

                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                Name="PART_ContentPresenter"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Panel>
                    </VisualLayerManager>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!--  Set by ThemeManager.ApplyAcrylic when the blur is turned off. Tool windows get their background from it  -->
        <Style Selector="^.no-acrylic">
            <Setter Property="TransparencyLevelHint" Value="Transparent" />
        </Style>
        <Style Selector="^.no-acrylic /template/ ExperimentalAcrylicBorder#PART_AcrylicBorder">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>
</ResourceDictionary>