<ResourceDictionary
    x:ClassModifier="internal"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme TargetType="customControls:KeybindBox" x:Key="{x:Type customControls:KeybindBox}">
        <Setter Property="Foreground" Value="{DynamicResource MainTextColorFaded}" />
        <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderColor}" />
        <Setter Property="Height" Value="42" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontFamily" Value="/Assets/Fonts/Roboto-Regular.ttf#Roboto" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="customControls:KeybindBox">
                <DockPanel>
                    <TextBlock
                        Classes="txt"
                        DockPanel.Dock="Left"
                        Margin="0,0,5,0"
                        MinWidth="220"
                        Text="{TemplateBinding ActionName}" />
                    <customControls:TagBox
                        DockPanel.Dock="Right"
                        Height="40"
                        MaxTags="{TemplateBinding MaxTags}"
                        Name="PART_TagBox"
                        PlaceholderText="{TemplateBinding PlaceholderText}"
                        Tags="{TemplateBinding Tags}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>

    </ControlTheme>

    <ControlTheme TargetType="customControls:KeybindBox" x:Key="Detached">
        <Setter Property="Foreground" Value="{DynamicResource MainTextColorFaded}" />
        <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderColor}" />
        <Setter Property="Height" Value="42" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontFamily" Value="/Assets/Fonts/Roboto-Regular.ttf#Roboto" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="customControls:KeybindBox">
                <DockPanel>
                    <TextBlock
                        Classes="txt"
                        DockPanel.Dock="Left"
                        Margin="0,0,7,0"
                        Text="{TemplateBinding ActionName}" />
                    <customControls:TagBox
                        DockPanel.Dock="Right"
                        Height="40"
                        MaxTags="{TemplateBinding MaxTags}"
                        Name="PART_TagBox"
                        PlaceholderText="{TemplateBinding PlaceholderText}"
                        Tags="{TemplateBinding Tags}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>

    </ControlTheme>
</ResourceDictionary>