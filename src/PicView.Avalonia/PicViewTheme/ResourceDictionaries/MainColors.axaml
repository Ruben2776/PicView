<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">

    <ResourceDictionary.ThemeDictionaries>

        <!--  ==========================================  -->
        <!--  DARK THEME (Default)  -->
        <!--  ==========================================  -->
        <ResourceDictionary x:Key="Default">
            <!--  Global Text  -->
            <Color x:Key="MainTextColor">#E2E0E0</Color>
            <Color x:Key="MainTextColorFaded">#d6d4d4</Color>
            <Color x:Key="SecondaryTextColor">#fff</Color>

            <!--  Global Window  -->
            <Color x:Key="WindowTitleBackgroundColor">#FF2C2C2C</Color>
            <Color x:Key="WindowButtonBackgroundColor">#2B2B2B</Color>
            <Color x:Key="WindowBorderColor">#FF3A3A3A</Color>
            <Color x:Key="WindowLogoColor">#FF303030</Color>
            <Color x:Key="WindowMainBackgroundColor">#DF252525</Color>

            <!--  TOP TITLE BAR  -->
            <Color x:Key="TitleBarBackgroundColor">#FF303030</Color>
            <Color x:Key="TitleBarForeground">#EEDFDFDF</Color>
            <Color x:Key="TitleBarBorderColor">#FF3A3A3A</Color>
            <Color x:Key="TitleBarButtonBackground">#CC2b2b2b</Color>
            <Color x:Key="TitleBarButtonBorder">#FF3A3A3A</Color>
            <Color x:Key="TitleBarBackgroundHoverColor">#804E4E4E</Color>

            <Color x:Key="EditableTitlebarBackground">Transparent</Color>
            <Color x:Key="EditableTitlebarForeground">#EEF2F2F2</Color>

            <!--  BOTTOM TOOLBAR  -->
            <Color x:Key="BottomBarBackgroundColor">#292929</Color>
            <Color x:Key="BottomBarForegroundColor">#EEDFDFDF</Color>
            <Color x:Key="BottomBarBorderColor">#FF3A3A3A</Color>

            <Color x:Key="BottomBarButtonBackgroundColor">#CC303030</Color>
            <Color x:Key="BottomBarButtonBorderColor">#373535</Color>
            <Color x:Key="BottomBarNavBtnBackground">#FF252525</Color>
            <Color x:Key="BottomBarToolBtnBackground">#A7222222</Color>
            <Color x:Key="BottomBarButtonHoverBackground">#DB3D3D3D</Color>

            <!--  Hover bar  -->
            <Color x:Key="HoverBarBackgroundColor">#Ff333333</Color>
            <Color x:Key="HoverBarBorderColor">#3C3C3C</Color>

            <Color x:Key="HoverBarTrackColor">#525252</Color>
            <Color x:Key="HoverBarThumbColor">#d6d4d4</Color>

            <Color x:Key="HoverBarHoverColor">#4D4D4D</Color>

            <!--  MENUS & DROPDOWNS  -->
            <Color x:Key="MenuBackgroundColor">#F3292929</Color>
            <Color x:Key="MenuButtonBackground">#303030</Color>
            <Color x:Key="MenuBorderColor">#373535</Color>

            <Color x:Key="DisabledMenuBackgroundColor">#E3DFE7</Color>
            <Color x:Key="DisabledMenuForegroundColor">#A9A5AC</Color>

            <Color x:Key="ContextMenuBackgroundColor">#EE2b2b2b</Color>
            <Color x:Key="ContextMenuForegroundColor">#EDEBEB</Color>
            <Color x:Key="ContextMenuBorderColor">#424A57</Color>

            <Color x:Key="MenuItemHoverBackground">#454545</Color>

            <!--  Drop menu  -->
            <Color x:Key="DropMenuSurroundingBorderColor">#FF3B3B3B</Color>
            <Color x:Key="DropMenuBackgroundColor">#CC252525</Color>
            <Color x:Key="DropMenuBorderColor">#FF3A3A3A</Color>

            <Color x:Key="DropDownMenuBackgroundColor">#FF2A2A2A</Color>
            <Color x:Key="DropDownMenuButtonBackground">#FF323232</Color>
            <Color x:Key="DropDownMenuButtonForeground">#FFE2E2E2</Color>
            <Color x:Key="DropDownMenuButtonBorderColor">#FF424242</Color>

            <!--  TABS  -->
            <Color x:Key="BehindTabBackground">#FF353535</Color>

            <Color x:Key="TabItemSelectedBackground">#FF252525</Color>
            <Color x:Key="TabItemUnSelectedBackground">#FF252525</Color>
            <Color x:Key="TabItemBorderColor">#F42F2F2F</Color>
            <Color x:Key="TabItemHoverBackground">#D2353535</Color>

            <Color x:Key="FloatingTabSelectedBackground">#A23C3C3C</Color>
            <Color x:Key="FloatingTabSelectedBorder">#F4595959</Color>

            <!--  Scrollbar  -->
            <Color x:Key="ScrollbarBackgroundColor">#FF2C2C2C</Color>
            <Color x:Key="ScrollbarBorderColor">#FF5D5D5D</Color>

            <Color x:Key="ScrollbarThumbColor">#EE2E2E2E</Color>
            <Color x:Key="ScrollbarThumbBorderColor">#EE4A4A4A</Color>

            <Color x:Key="ScrollbarIconColor">#EEDFDFDF</Color>
            <Color x:Key="ScrollbarIconBorderColor">#EE747474</Color>

            <!--  Gallery  -->
            <Color x:Key="GalleryBackgroundColor">#CE212121</Color>
            <Color x:Key="GalleryBorderColor">#FF323232</Color>

            <Color x:Key="GalleryItemBackgroundColor">#CE212121</Color>
            <Color x:Key="GalleryItemBorderColor">#FF3A3A3A</Color>

            <!--  Image info window  -->
            <Color x:Key="ImageInfoSeparatorColor">#FF3A3A3A</Color>

            <!--  StartUpMenu  -->
            <ImageBrush
                x:Key="StartUpMenuBackground"
                DestinationRect="0,0,200,200"
                Opacity=".5"
                Source="/PicViewTheme/Resources/noisy-texture-200x200-o4-d31-c-161616-t0.png"
                Stretch="Fill"
                TileMode="FlipXY" />
            <Color x:Key="StartUpMenuForeground">#DDDDDD</Color>

            <!--  PopUp  -->
            <Color x:Key="PopUpOverlayColor">#A8000000</Color>
            <Color x:Key="PopUpBackgroundColor">#CC2b2b2b</Color>
            <Color x:Key="PopUpMainBorderColor">#FF3A3A3A</Color>

            <!--  Tool window styles  -->
            <Color x:Key="ToolWindowFooterBackground">#CC303030</Color>

            <Color x:Key="ToolWindowButtonBackground">#FF292929</Color>
            <Color x:Key="ToolWindowButtonBorderColor">#CC424242</Color>

            <Color x:Key="ToolWindowButtonHover">#4C4C4C</Color>
            <Color x:Key="ToolWindowButtonBorderHover">#CCA2A2A2</Color>

            <!--  TextBox  -->
            <Color x:Key="TextBoxBackgroundColor">#FF292929</Color>
            <Color x:Key="TextBoxBorderColor">#373535</Color>
            <Color x:Key="TextBoxHoverBorderColor">#777</Color>

            <Color x:Key="TextBoxDisabledBackgroundColor">#CC3E3E3E</Color>

            <!--  ComboBox  -->
            <Color x:Key="ComboBoxDropDownBackgroundColor">#282828</Color>
            <Color x:Key="ComboBoxDropDownBorderColor">#777</Color>

            <!--  Log panel background  -->
            <Color x:Key="LogPanelHeaderColor">#EB343434</Color>
            <Color x:Key="LogPanelBackgroundColor">#D72A2A2A</Color>
            <Color x:Key="LogPanelBorderColor">#8D565656</Color>


            <!--  EFFECTS & MISC  -->
            <Color x:Key="ErrorColor">#B51522</Color>
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

            <ImageBrush
                x:Key="NoisyTexture"
                DestinationRect="0,0,200,200"
                Opacity=".6"
                Source="/PicViewTheme/Resources/noisy-texture-200x200-o4-d31-c-161616-t0.png"
                Stretch="Fill"
                TileMode="FlipXY" />

            <Color x:Key="CropBackground">#A7000000</Color>

            <Color x:Key="SeparatorColor">#FF3A3A3A</Color>
        </ResourceDictionary>



        <!--  ==========================================  -->
        <!--  LIGHT THEME  -->
        <!--  ==========================================  -->
        <ResourceDictionary x:Key="Light">
            <!--  Global Text  -->
            <Color x:Key="MainTextColor">#424242</Color>
            <Color x:Key="MainTextColorFaded">#FFAAA9C2</Color>

            <!--  Global Window  -->
            <Color x:Key="WindowTitleBackgroundColor">Transparent</Color>
            <Color x:Key="WindowButtonBackgroundColor">#fff</Color>
            <Color x:Key="WindowBorderColor">#fff</Color>
            <Color x:Key="WindowLogoColor">#fff</Color>
            <ConicGradientBrush x:Key="WindowMainBackgroundColor" Center="50%,50%">
                <GradientStop Offset="0.0" Color="#fff" />
                <GradientStop Offset="0.5" Color="#FFF4F3FF" />
                <GradientStop Offset="1.0" Color="#fff" />
            </ConicGradientBrush>

            <!--  TOP TITLE BAR  -->
            <Color x:Key="TitleBarBackgroundColor">#fff</Color>
            <Color x:Key="TitleBarForeground">#EE51516C</Color>
            <Color x:Key="TitleBarBorderColor">Gainsboro</Color>
            <Color x:Key="TitleBarButtonBackground">#fff</Color>
            <Color x:Key="TitleBarButtonBorder">#fff</Color>
            <Color x:Key="TitleBarBackgroundHoverColor">#80ADA8E9</Color>

            <Color x:Key="EditableTitlebarBackground">Transparent</Color>
            <Color x:Key="EditableTitlebarForeground">#FF494949</Color>

            <!--  BOTTOM TOOLBAR  -->
            <Color x:Key="BottomBarBackgroundColor">#fff</Color>
            <Color x:Key="BottomBarForegroundColor">#EE393939</Color>
            <Color x:Key="BottomBarBorderColor">Gainsboro</Color>

            <Color x:Key="BottomBarButtonBackgroundColor">#FCFCFC</Color>
            <Color x:Key="BottomBarButtonBorderColor">#fff</Color>
            <Color x:Key="BottomBarNavBtnBackground">#fff</Color>
            <Color x:Key="BottomBarToolBtnBackground">#fff</Color>
            <Color x:Key="BottomBarButtonHoverBackground">#DB3D3D3D</Color>

            <!--  Hover bar  -->
            <Color x:Key="HoverBarBackgroundColor">#fff</Color>
            <Color x:Key="HoverBarBorderColor">#D9DAF7</Color>

            <ConicGradientBrush x:Key="HoverBarTrackColor" Center="50%,50%">
                <GradientStop Offset="0.0" Color="#D9DAF7" />
                <GradientStop Offset="0.5" Color="#D4D3DF" />
                <GradientStop Offset="1.0" Color="#D9DAF7" />
            </ConicGradientBrush>
            <Color x:Key="HoverBarThumbColor">#EE8D8AAB</Color>

            <Color x:Key="HoverBarHoverColor">#C7C3EB</Color>

            <!--  MENUS & DROPDOWNS  -->
            <Color x:Key="MenuBackgroundColor">#fff</Color>
            <Color x:Key="MenuButtonBackground">#fff</Color>
            <Color x:Key="MenuBorderColor">#FFDBDBDB</Color>

            <Color x:Key="DisabledMenuBackgroundColor">#E3DFE7</Color>
            <Color x:Key="DisabledMenuForegroundColor">#A9A5AC</Color>

            <Color x:Key="ContextMenuBackgroundColor">#F7F9FC</Color>
            <Color x:Key="ContextMenuForegroundColor">#1E2633</Color>
            <Color x:Key="ContextMenuBorderColor">#B5C0CE</Color>

            <Color x:Key="MenuItemHoverBackground">#D9DEF2</Color>

            <!--  Drop menu  -->
            <Color x:Key="DropMenuSurroundingBorderColor">#B5C0CE</Color>
            <Color x:Key="DropMenuBackgroundColor">#FEF9FBFF</Color>
            <Color x:Key="DropMenuBorderColor">#FFCCCCCC</Color>

            <Color x:Key="DropDownMenuBackgroundColor">#FEF9FBFF</Color>
            <Color x:Key="DropDownMenuButtonBackground">#fff</Color>
            <Color x:Key="DropDownMenuButtonForeground">#FF656565</Color>
            <Color x:Key="DropDownMenuButtonBorderColor">#F4EFF1F5</Color>

            <!--  TABS  -->
            <Color x:Key="BehindTabBackground">#fff</Color>

            <Color x:Key="TabItemSelectedBackground">#fff</Color>
            <Color x:Key="TabItemUnSelectedBackground">#F2F5F9</Color>
            <Color x:Key="TabItemBorderColor">#9ABCBCBC</Color>
            <Color x:Key="TabItemHoverBackground">#E1E7F0</Color>

            <Color x:Key="FloatingTabSelectedBackground">#A23C3C3C</Color>
            <Color x:Key="FloatingTabSelectedBorder">#F4595959</Color>

            <!--  Scrollbar  -->
            <Color x:Key="ScrollbarBackgroundColor">#fff</Color>
            <Color x:Key="ScrollbarBorderColor">#FFDDDDDD</Color>

            <Color x:Key="ScrollbarThumbColor">#fff</Color>
            <Color x:Key="ScrollbarThumbBorderColor">#B1BCE7</Color>

            <Color x:Key="ScrollbarIconColor">#EEF5F4FF</Color>
            <Color x:Key="ScrollbarIconBorderColor">#FFBBCCFF</Color>

            <!--  Gallery  -->
            <LinearGradientBrush x:Key="GalleryBackgroundColor" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Offset="0.0" Color="#fff" />
                <GradientStop Offset="0.5" Color="#D4D3DF" />
                <GradientStop Offset="1.0" Color="#fff" />
            </LinearGradientBrush>
            <Color x:Key="GalleryBorderColor">#FFCCCCCC</Color>

            <Color x:Key="GalleryItemBackgroundColor">#FFF</Color>
            <Color x:Key="GalleryItemBorderColor">#FFCCCCCC</Color>

            <!--  Image info window  -->
            <Color x:Key="ImageInfoSeparatorColor">#FF3A3A3A</Color>

            <!--  StartUpMenu  -->
            <ConicGradientBrush x:Key="StartUpMenuBackground" Center="50%,50%">
                <GradientStop Offset="0.0" Color="#ECECECFF" />
                <GradientStop Offset="0.5" Color="#C6CDF1" />
                <GradientStop Offset="1.0" Color="#ECECECFF" />
            </ConicGradientBrush>
            <Color x:Key="StartUpMenuForeground">#FF616161</Color>

            <!--  PopUp  -->
            <Color x:Key="PopUpOverlayColor">#86555555</Color>
            <Color x:Key="PopUpBackgroundColor">#EBFFFFFF</Color>
            <Color x:Key="PopUpMainBorderColor">#FF828282</Color>

            <!--  Tool window styles  -->
            <Color x:Key="ToolWindowFooterBackground">#CC303030</Color>

            <Color x:Key="ToolWindowButtonBackground">#FF292929</Color>
            <Color x:Key="ToolWindowButtonBorderColor">#CCD2D2D2</Color>

            <Color x:Key="ToolWindowButtonHover">#4C4C4C</Color>
            <Color x:Key="ToolWindowButtonBorderHover">#CCA2A2A2</Color>

            <!--  TextBox  -->
            <Color x:Key="TextBoxBackgroundColor">#CC2b2b2b</Color>
            <Color x:Key="TextBoxBorderColor">#373535</Color>
            <Color x:Key="TextBoxHoverBorderColor">#777</Color>

            <Color x:Key="TextBoxDisabledBackgroundColor">#CC3E3E3E</Color>

            <!--  ComboBox  -->
            <Color x:Key="ComboBoxDropDownBackgroundColor">#fff</Color>
            <Color x:Key="ComboBoxDropDownBorderColor">#CCBFBFBF</Color>

            <!--  Log panel background  -->
            <Color x:Key="LogPanelHeaderColor">#EB343434</Color>
            <Color x:Key="LogPanelBackgroundColor">#D72A2A2A</Color>
            <Color x:Key="LogPanelBorderColor">#8D565656</Color>

            <!--  EFFECTS & MISC  -->
            <Color x:Key="NoisyTexture">#17FFFFFF</Color>

            <Color x:Key="SeparatorColor">Gainsboro</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>