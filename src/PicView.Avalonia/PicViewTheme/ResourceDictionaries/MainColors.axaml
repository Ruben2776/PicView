<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">

    <ResourceDictionary.ThemeDictionaries>

        <!--  ==========================================  -->
        <!--  DARK THEME (Default)  -->
        <!--  ==========================================  -->
        <ResourceDictionary x:Key="Default">
            <!--  Global Text  -->
            <Color x:Key="MainTextColor">#E2E0E0</Color>
            <Color x:Key="MainTextColorFaded">#d6d4d4</Color>
            <Color x:Key="SecondaryTextColor">#ffffff</Color>

            <!--  Global Window  -->
            <Color x:Key="WindowBackgroundColor">#C4252525</Color>
            <Color x:Key="WindowBorderColor">#1A1A1A</Color>
            <Color x:Key="WindowLogoColor">#C4252525</Color>

            <!--  TOP TITLE BAR  -->
            <Color x:Key="TitleBarBackgroundColor">#FF303030</Color>
            <Color x:Key="TitleBarBorderColor">#FF3A3A3A</Color>
            <Color x:Key="TitleBarButtonBackground">#FF2B2B2B</Color>
            <Color x:Key="TitleBarButtonBorder">Transparent</Color>

            <Color x:Key="TitleBarForeground">#540F0F5F</Color>

            <Color x:Key="EditableTitlebarBackground">Transparent</Color>
            <Color x:Key="EditableTitlebarForeground">#540F0F4C</Color>

            <!--  BOTTOM TOOLBAR  -->
            <Color x:Key="BottomBarBackgroundColor">#292929</Color>
            <Color x:Key="BottomBarBorderColor">#FF3A3A3A</Color>

            <!--  Bottom Toolbar Buttons  -->
            <Color x:Key="BottomBarNavBtnBackground">#CC252525</Color>
            <!--  Prev/Next  -->
            <Color x:Key="BottomBarActionBtnBackground">#FF2e2e2e</Color>
            <!--  File/Settings  -->
            <Color x:Key="BottomBarToolBtnBackground">#A7222222</Color>
            <!--  Zoom/Rotate  -->
            <Color x:Key="BottomBarButtonHoverBackground">#FF4B4B4B</Color>

            <!--  MENUS & DROPDOWNS  -->
            <Color x:Key="MenuBackgroundColor">#292929</Color>
            <Color x:Key="MenuBorderColor">#FF3A3A3A</Color>
            <Color x:Key="MenuButtonBackground">#2F2F2F</Color>

            <Color x:Key="ContextMenuBackgroundColor">#EE2b2b2b</Color>
            <Color x:Key="ContextMenuTextColor">#EDEBEB</Color>
            <Color x:Key="MenuItemHoverBackground">#FF4B4B4B</Color>

            <!--  TABS  -->
            <Color x:Key="TabItemSelectedBackground">Transparent</Color>
            <Color x:Key="TabItemUnSelectedBackground">Transparent</Color>
            <Color x:Key="TabItemBorderColor">#D1D9E4</Color>
            <Color x:Key="TabItemHoverBackground">#E1E7F0</Color>

            <!--  StartUpMenu  -->
            <Color x:Key="StartUpMenuBackground">#EEF5FFFF</Color>

            <!--  EFFECTS & MISC  -->
            <Color x:Key="ErrorColor">#B51522</Color>
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

            <ImageBrush
                x:Key="NoisyTexture"
                DestinationRect="0,0,200,200"
                Opacity=".6"
                Source="/PicViewTheme/Resources/noisy-texture-200x200-o4-d31-c-161616-t0.png"
                Stretch="Fill"
                TileMode="FlipXY" />
        </ResourceDictionary>


        <!--  ==========================================  -->
        <!--  LIGHT THEME (Cool Slate / Blue Tint)  -->
        <!--  ==========================================  -->
        <ResourceDictionary x:Key="Light">
            <!--  Global Text  -->
            <Color x:Key="MainTextColor">#424242</Color>
            <Color x:Key="MainTextColorFaded">#768396</Color>

            <!--  Global Window  -->
            <Color x:Key="WindowBackgroundColor">#C4252525</Color>
            <Color x:Key="WindowBorderColor">Transparent</Color>
            <Color x:Key="WindowLogoColor">#fff</Color>

            <!--  TOP TITLE BAR  -->
            <LinearGradientBrush x:Key="TitleBarBackgroundColor" StartPoint="5%,50%" EndPoint="100%,50%">
                <!--  Left edge: White  -->
                <GradientStop Offset="0.3" Color="#FFFFFF" />

                <!--  Center: Slate/Blue-tint  -->
                <GradientStop Offset="0.5" Color="#EDF1F5" />

                <!--  Right edge: White  -->
                <GradientStop Offset="0.7" Color="#FFFFFF" />
            </LinearGradientBrush>
            <Color x:Key="TitleBarBorderColor">Gainsboro</Color>
            <Color x:Key="TitleBarButtonBackground">#fff</Color>
            <Color x:Key="TitleBarButtonBorder">Transparent</Color>

            <Color x:Key="TitleBarForeground">#EE51516C</Color>

            <Color x:Key="EditableTitlebarBackground">Transparent</Color>
            <Color x:Key="EditableTitlebarForeground">#EE25203C</Color>

            <!--  BOTTOM TOOLBAR  -->
            <Color x:Key="BottomBarBackgroundColor">#F2F5F9</Color>
            <Color x:Key="BottomBarBorderColor">#D1D9E4</Color>

            <!--  Bottom Toolbar Buttons  -->
            <Color x:Key="BottomBarNavBtnBackground">Transparent</Color>
            <Color x:Key="BottomBarActionBtnBackground">Transparent</Color>
            <Color x:Key="BottomBarToolBtnBackground">Transparent</Color>
            <Color x:Key="BottomBarButtonHoverBackground">#E1E7F0</Color>

            <!--  MENUS & DROPDOWNS  -->
            <Color x:Key="MenuBackgroundColor">#F7F9FC</Color>
            <Color x:Key="MenuBorderColor">#B5C0CE</Color>
            <Color x:Key="MenuButtonBackground">#FFFFFF</Color>

            <Color x:Key="ContextMenuBackgroundColor">#F7F9FC</Color>
            <Color x:Key="ContextMenuTextColor">#1E2633</Color>
            <Color x:Key="MenuItemHoverBackground">#E1E7F0</Color>

            <!--  TABS  -->
            <Color x:Key="TabItemSelectedBackground">#fff</Color>
            <Color x:Key="TabItemUnSelectedBackground">#F2F5F9</Color>
            <Color x:Key="TabItemBorderColor">#9ABCBCBC</Color>
            <Color x:Key="TabItemHoverBackground">#E1E7F0</Color>

            <!--  StartUpMenu  -->
            <Color x:Key="StartUpMenuBackground">#ECECECFF</Color>
            <Color x:Key="StartUpMenuForeground">#595959</Color>


        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>