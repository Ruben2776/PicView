<UserControl
    x:Class="PicView.Avalonia.CustomControls.CalendarContainer"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls">
    <StackPanel>
        <Calendar
            x:Name="PartCalendar"
            AllowTapRangeSelection="True"
            Background="{DynamicResource MenuBackgroundColor}"
            BorderBrush="{DynamicResource MenuBorderColor}"
            BorderThickness="1,1,1,0"
            CornerRadius="2,2,0,0"
            DisplayDateStart="1601/01/01" />
        <Border
            Margin="0,-2,0,0"
            Background="{DynamicResource MenuBackgroundColor}"
            BorderBrush="{DynamicResource MenuBorderColor}"
            BorderThickness="1"
            CornerRadius="0,0,4,4">
            <StackPanel Orientation="Horizontal">
                <customControls:IconButton
                    x:Name="CancelButton"
                    Width="136"
                    Height="30"
                    Background="Transparent"
                    Classes="MenuItemHover"
                    CornerRadius="0,0,0,4"
                    Data="{StaticResource CloseGeometry}"
                    Foreground="{DynamicResource MainTextColor}"
                    IconHeight="12"
                    IconWidth="12" />
                <customControls:IconButton
                    x:Name="AcceptButton"
                    Width="136"
                    Height="30"
                    Background="{DynamicResource AccentColor}"
                    Classes="PrimaryBtnHover"
                    CornerRadius="0,0,4,0"
                    Foreground="{DynamicResource MainTextColor}"
                    Icon="{StaticResource CheckmarkImage}"
                    IconHeight="14"
                    IconWidth="14" />
            </StackPanel>
        </Border>
        <Polygon
            x:Name="DownArrow"
            Margin="122,-4,0,0"
            Fill="{DynamicResource PopUpBackgroundColor}"
            Points="0,0 15,30, 30,0"
            Stroke="{DynamicResource PopUpMainBorderColor}"
            StrokeThickness="1"
            ZIndex="-1" />
    </StackPanel>
</UserControl>
