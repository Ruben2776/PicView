<customControls:MainWindow
    MaxHeight="{CompiledBinding WindowMaxHeight.Value}"
    MaxWidth="{CompiledBinding WindowMaxWidth.Value}"
    MinHeight="{CompiledBinding WindowMinHeight}"
    MinWidth="{CompiledBinding WindowMinWidth}"
    Title="{CompiledBinding WindowTabs.ActiveTab.Value.WindowTitle.Value,
                            FallbackValue=''}"
    x:Class="PicView.Avalonia.MacOS.Views.MacMainWindow"
    x:DataType="viewModels:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls;assembly=PicView.Avalonia"
    xmlns:main="clr-namespace:PicView.Avalonia.Views.Main;assembly=PicView.Avalonia"
    xmlns:uc="clr-namespace:PicView.Avalonia.Views.UC;assembly=PicView.Avalonia"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:views="clr-namespace:PicView.Avalonia.MacOS.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:keybindings="using:PicView.Core.Keybindings">
    <NativeMenu.Menu>
        <NativeMenu>
            <!--  File  -->
            <NativeMenuItem Header="{Binding Translation.File.Value}">
                <NativeMenu>

                    <!--  Open  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Open}" Header="{Binding Translation.Open.Value}" />

                    <!--  Open with  -->
                    <NativeMenuItem
                        Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.OpenWith}"
                        Header="{Binding Translation.OpenWith.Value, Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />

                    <!--  Save  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Save}"
                        Header="{CompiledBinding Translation.Save.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                    Converter={x:Static ObjectConverters.IsNotNull},
                                                    FallbackValue=False,
                                                    Mode=OneWay}" />

                    <!--  Save as  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SaveAs}"
                        Header="{CompiledBinding Translation.SaveAs.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                    Converter={x:Static ObjectConverters.IsNotNull},
                                                    FallbackValue=False,
                                                    Mode=OneWay}" />

                    <!--  Print  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Print}"
                        Header="{CompiledBinding Translation.Print.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                    Converter={x:Static ObjectConverters.IsNotNull},
                                                    FallbackValue=False,
                                                    Mode=OneWay}" />

                    <!--  Save as PDF  -->
                    <NativeMenuItem
                        Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SaveAsPDF}"
                        Header="{Binding Translation.SaveAsPdf.Value}"
                        IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.Image.Value,
                                                    Converter={x:Static ObjectConverters.IsNotNull},
                                                    FallbackValue=False,
                                                    Mode=OneWay}" />

                    <!--  Locate on disk  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.OpenInExplorer}"
                        Header="{CompiledBinding Translation.ShowInFolder.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                    Converter={x:Static ObjectConverters.IsNotNull},
                                                    FallbackValue=False,
                                                    Mode=OneWay}" />

                    <NativeMenuItemSeparator />

                    <!--  Delete file  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.DeleteFile}"
                        Header="{CompiledBinding Translation.DeleteFile.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                    Converter={x:Static ObjectConverters.IsNotNull},
                                                    FallbackValue=False,
                                                    Mode=OneWay}" />

                    <NativeMenuItemSeparator />

                    <!--  Reload  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Reload}"
                        Header="{CompiledBinding Translation.Reload.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                    Converter={x:Static ObjectConverters.IsNotNull},
                                                    FallbackValue=False,
                                                    Mode=OneWay}" />

                    <NativeMenuItemSeparator />
                    <!--  New window  -->
                    <NativeMenuItem Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.NewWindow}" Header="{CompiledBinding Translation.NewWindow.Value, Mode=OneWay}" />


                    <!--  New Tab  -->
                    <NativeMenuItem Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.NewTab}" Header="{Binding Translation.NewTab.Value}" />

                    <!--  Close other tabs  -->
                    <!-- <NativeMenuItem Header="Close other tabs (missing translation)" /> -->

                    <NativeMenuItemSeparator />

                    <!--  Rename  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Rename}"
                        Header="{CompiledBinding Translation.RenameFile.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{CompiledBinding WindowTabs.ActiveTab.Value.FileInfo.Value,
                                                    Converter={x:Static ObjectConverters.IsNotNull},
                                                    FallbackValue=False,
                                                    Mode=OneWay}" />

                    <NativeMenuItemSeparator />

                    <!--  File properties  -->
                    <NativeMenuItem
                        Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ShowFileProperties}"
                        Header="{Binding Translation.FileProperties.Value}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />


                </NativeMenu>
            </NativeMenuItem>

            <!--  Edit  -->
            <NativeMenuItem Header="{Binding Translation.Edit.Value}">
                <NativeMenu>
                    <NativeMenuItem
                        Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.CopyImage}"
                        Header="{Binding Translation.CopyImage.Value}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />
                    <NativeMenuItem
                        Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.CopyFile}"
                        Header="{Binding Translation.CopyFile.Value}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />
                    <NativeMenuItem
                        Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.CopyBase64}"
                        Header="{Binding Translation.CopyImage.Value}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Paste}" Header="{Binding Translation.Paste.Value}" />

                    <NativeMenuItemSeparator />

                    <!--  Crop image  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Crop}" Header="{Binding Translation.Crop.Value}" />

                </NativeMenu>
            </NativeMenuItem>

            <!--  View  -->
            <NativeMenuItem Header="{Binding Translation.View.Value}">
                <NativeMenu>
                    <!--  Fullscreen  -->
                    <NativeMenuItem Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ToggleFullscreen}" Header="{CompiledBinding Translation.Fullscreen.Value, Mode=OneWay}" />

                    <!--  Maximize  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Maximize}" Header="{Binding Translation.Maximize.Value}" />

                    <!--  Restore  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Restore}" Header="{Binding Translation.RestoreDown.Value}" />

                    <NativeMenuItemSeparator />

                    <!--  Change background  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ChangeBackground}" Header="{Binding Translation.ChangeBackground.Value}" />

                    <NativeMenuItemSeparator />

                    <!--  Toggle side-by-side  -->
                    <NativeMenuItem
                        Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SideBySide}"
                        Header="{Binding Translation.SideBySide.Value}"
                        ToggleType="CheckBox" />

                    <NativeMenuItemSeparator />

                    <!--  Toggle UI  -->
                    <NativeMenuItem
                        Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ToggleInterface}"
                        Header="{CompiledBinding Translation.IsShowingUI.Value,
                                                 Mode=OneWay}"
                        ToggleType="CheckBox" />

                    <!--  Toggle bottom bar  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ToggleBottomToolbar}" Header="{CompiledBinding Translation.IsShowingBottomToolbar.Value, Mode=OneWay}" />

                    <!--  Toggle gallery  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ToggleGallery}" Header="{CompiledBinding Translation.ShowImageGallery.Value, Mode=OneWay}" />

                </NativeMenu>
            </NativeMenuItem>

            <!--  Image  -->
            <NativeMenuItem Header="{Binding Translation.Image.Value}">
                <NativeMenu>

                    <!--  Flip image  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Flip}" Header="{Binding WindowTabs.ActiveTab.Value.Orientation.FlipLabel.Value}" />

                    <!--  Rotate left  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.RotateLeft}" Header="{Binding Translation.RotateLeft.Value}" />

                    <!--  Rotate right  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.RotateRight}" Header="{Binding Translation.RotateRight.Value}" />

                    <!--  Rotate 0  -->
                    <NativeMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Rotate0}"
                        Header="0°"
                        IsChecked="{Binding WindowTabs.ActiveTab.Value.Orientation.IsRotated0.Value, Mode=OneWay}"
                        ToggleType="Radio" />

                    <!--  Rotate 90  -->
                    <NativeMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Rotate90}"
                        Header="90°"
                        IsChecked="{Binding WindowTabs.ActiveTab.Value.Orientation.IsRotated90.Value, Mode=OneWay}"
                        ToggleType="Radio" />

                    <!--  Rotate 180  -->
                    <NativeMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Rotate180}"
                        Header="180°"
                        IsChecked="{Binding WindowTabs.ActiveTab.Value.Orientation.IsRotated180.Value, Mode=OneWay}"
                        ToggleType="Radio" />

                    <!--  Rotate 270  -->
                    <NativeMenuItem
                        Command="{Binding RunActionCommand}"
                        CommandParameter="{x:Static keybindings:Actions.Rotate270}"
                        Header="270°"
                        IsChecked="{Binding WindowTabs.ActiveTab.Value.Orientation.IsRotated270.Value, Mode=OneWay}"
                        ToggleType="Radio" />

                    <NativeMenuItemSeparator />

                    <!--  Zoom in  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ZoomIn}" Header="{Binding Translation.ZoomIn.Value}" />

                    <!--  Zoom out  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ZoomOut}" Header="{Binding Translation.ZoomOut.Value}" />

                    <!--  Reset Zoom  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ResetZoom}" Header="{Binding Translation.ResetZoom.Value}" />

                    <NativeMenuItemSeparator />

                    <!--  Crop image  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Crop}" Header="{Binding Translation.Crop.Value}" />

                    <NativeMenuItemSeparator />

                    <!--  Set as wallpaper  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SetAsWallpaper}" Header="{Binding Translation.SetAsWallpaper.Value}" />

                    <NativeMenuItemSeparator />

                    <!--  Optimize image  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.OptimizeImage}" Header="{Binding Translation.OptimizeImage.Value}" />

                    <NativeMenuItemSeparator />

                    <!--  Show Effects window  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.EffectsWindow}" Header="{Binding Translation.Effects.Value}" />

                    <!--  Show Resize window  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.BatchResizeWindow}" Header="{Binding Translation.Resize.Value}" />

                    <!--  Show Image info  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ImageInfoWindow}" Header="{Binding Translation.ImageInfo.Value}" />

                </NativeMenu>
            </NativeMenuItem>

            <!--  Tool windows  -->
            <NativeMenuItem Header="{Binding Translation.ToolWindows.Value}">
                <NativeMenu>

                    <!--  Show Image info  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ImageInfoWindow}" Header="{Binding Translation.ImageInfo.Value}" />

                    <!--  Show Effects window  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.EffectsWindow}" Header="{Binding Translation.Effects.Value}" />

                    <!--  Show Batch Resize window  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.BatchResizeWindow}" Header="{Binding Translation.BatchResize.Value}" />

                    <!--  Show Single Resize window  -->
                    <NativeMenuItem Command="{Binding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ResizeWindow}" Header="{Binding Translation.ResizeImage.Value}" />

                </NativeMenu>
            </NativeMenuItem>

            <!--  Navigation  -->
            <NativeMenuItem Header="{CompiledBinding Translation.Navigation.Value, Mode=OneWay}">
                <NativeMenu>

                    <!--  Sort files by  -->
                    <NativeMenuItem Header="{CompiledBinding Translation.SortFilesBy.Value, Mode=OneWay}">
                        <NativeMenu>

                            <!--  Sort files by name  -->
                            <NativeMenuItem
                                Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SortFilesByName}"
                                Header="{CompiledBinding Translation.FileName.Value,
                                                         Mode=OneWay}"
                                IsChecked="{Binding WindowTabs.IsSortedByName.Value}"
                                ToggleType="Radio" />

                            <!--  Sort files by size  -->
                            <NativeMenuItem
                                Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SortFilesBySize}"
                                Header="{CompiledBinding Translation.FileSize.Value,
                                                         Mode=OneWay}"
                                IsChecked="{Binding WindowTabs.IsSortedByFileSize.Value}"
                                ToggleType="Radio" />

                            <!--  Sort files by extension  -->
                            <NativeMenuItem
                                Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SortFilesByExtension}"
                                Header="{CompiledBinding Translation.FileExtension.Value,
                                                         Mode=OneWay}"
                                IsChecked="{Binding WindowTabs.IsSortedByExtension.Value}"
                                ToggleType="Radio" />

                            <!--  Sort files by creation time  -->
                            <NativeMenuItem
                                Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SortFilesByCreationTime}"
                                Header="{CompiledBinding Translation.Created.Value,
                                                         Mode=OneWay}"
                                IsChecked="{Binding WindowTabs.IsSortedByCreationTime.Value}"
                                ToggleType="Radio" />

                            <!--  Sort files by last access time  -->
                            <NativeMenuItem
                                Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SortFilesByLastAccessTime}"
                                Header="{CompiledBinding Translation.LastAccessTime.Value,
                                                         Mode=OneWay}"
                                IsChecked="{Binding WindowTabs.IsSortedByLastAccessTime.Value}"
                                ToggleType="Radio" />

                            <!--  Sort files by last write time  -->
                            <NativeMenuItem
                                Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SortFilesByLastAccessTime}"
                                Header="{CompiledBinding Translation.Modified.Value,
                                                         Mode=OneWay}"
                                IsChecked="{Binding WindowTabs.IsSortedByLastWriteTime.Value}"
                                ToggleType="Radio" />

                            <!--  Sort files randomly  -->
                            <NativeMenuItem
                                Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SortFilesRandomly}"
                                Header="{CompiledBinding Translation.Random.Value,
                                                         Mode=OneWay}"
                                IsChecked="{Binding WindowTabs.IsSortedByRandomization.Value}"
                                ToggleType="Radio" />

                            <NativeMenuItemSeparator />

                            <!--  Sort files ascending  -->
                            <NativeMenuItem
                                Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SortFilesAscending}"
                                Header="{CompiledBinding Translation.Ascending.Value,
                                                         Mode=OneWay}"
                                IsChecked="{CompiledBinding WindowTabs.IsAscending.Value}"
                                ToggleType="Radio" />

                            <!--  Sort files descending  -->
                            <NativeMenuItem
                                Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SortFilesDescending}"
                                Header="{CompiledBinding Translation.Descending.Value,
                                                         Mode=OneWay}"
                                IsChecked="{CompiledBinding !WindowTabs.IsAscending.Value}"
                                ToggleType="Radio" />
                        </NativeMenu>
                    </NativeMenuItem>

                    <NativeMenuItemSeparator />

                    <!--  Slideshow  -->
                    <NativeMenuItem Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Slideshow}" Header="{CompiledBinding Translation.Slideshow.Value, Mode=OneWay}" />

                    <NativeMenuItemSeparator />

                    <!--  First image  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.First}"
                        Header="{CompiledBinding Translation.FirstImage.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateBackwards.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />

                    <!--  Last image  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.Last}"
                        Header="{CompiledBinding Translation.LastImage.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateForwards, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />

                    <NativeMenuItemSeparator />

                    <!--  Skip 10  -->
                    <NativeMenuItem
                        Command="{CompiledBinding WindowTabs.Next10}"
                        Header="{CompiledBinding Translation.AdvanceBy10Images.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateForwards.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />

                    <!--  Skip 100  -->
                    <NativeMenuItem
                        Command="{CompiledBinding WindowTabs.Next100}"
                        Header="{CompiledBinding Translation.AdvanceBy100Images.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateForwards.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />

                    <!--  Go back 10  -->
                    <NativeMenuItem
                        Command="{CompiledBinding WindowTabs.Prev10}"
                        Header="{CompiledBinding Translation.GoBackBy10Images.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateBackwards.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />

                    <!--  Go back 100  -->
                    <NativeMenuItem
                        Command="{CompiledBinding WindowTabs.Prev100}"
                        Header="{CompiledBinding Translation.GoBackBy100Images.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.CanNavigateBackwards.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />

                    <NativeMenuItemSeparator />

                    <!--  Next folder  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.NextFolder}"
                        Header="{CompiledBinding Translation.NextFolder.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />

                    <!--  Previous folder  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.PrevFolder}"
                        Header="{CompiledBinding Translation.PrevFolder.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />

                    <NativeMenuItemSeparator />

                    <!--  Next archive  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.NextArchive}"
                        Header="{CompiledBinding Translation.NextArchive.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />

                    <!--  Previous archive  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.PrevArchive}"
                        Header="{CompiledBinding Translation.PrevArchive.Value,
                                                 Mode=OneWay}"
                        IsEnabled="{Binding WindowTabs.ActiveTab.Value.FileInfo.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, Mode=OneWay}" />

                </NativeMenu>
            </NativeMenuItem>

            <!--  Settings  -->
            <NativeMenuItem Header="{CompiledBinding Translation.Settings.Value, Mode=OneWay}">
                <NativeMenu>

                    <!--  Change background  -->
                    <NativeMenuItem Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ChangeBackground}" Header="{CompiledBinding Translation.ChangeBackground.Value, Mode=OneWay}" />

                    <NativeMenuItemSeparator />

                    <!--  Toggle looping  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ToggleLooping}"
                        Header="{CompiledBinding Translation.IsLooping.Value,
                                                 Mode=OneWay}"
                        IsChecked="{CompiledBinding GlobalSettings.IsLooping.Value}"
                        ToggleType="CheckBox" />

                    <!--  Toggle stretch  -->
                    <!--  <NativeMenuItem  -->
                    <!--  Command="{CompiledBinding StretchCommand}"  -->
                    <!--  Header="{CompiledBinding Translation.Stretch.Value,  -->
                    <!--  Mode=OneWay}"  -->
                    <!--  IsChecked="{CompiledBinding GlobalSettings.IsStretched.Value}"  -->
                    <!--  ToggleType="CheckBox" />  -->

                    <!--  Toggle scroll  -->
                    <!--  <NativeMenuItem  -->
                    <!--  Command="{CompiledBinding ToggleScrollCommand}"  -->
                    <!--  Header="{CompiledBinding Translation.ToggleScroll.Value,  -->
                    <!--  Mode=OneWay}"  -->
                    <!--  IsChecked="{CompiledBinding GlobalSettings.IsScrollingEnabled.Value}"  -->
                    <!--  ToggleType="CheckBox" />  -->

                    <NativeMenuItemSeparator />

                    <!--  Change topmost  -->
                    <!--  <NativeMenuItem  -->
                    <!--  Command="{CompiledBinding SetTopMostCommand}"  -->
                    <!--  Header="{CompiledBinding Translation.StayTopMost.Value,  -->
                    <!--  Mode=OneWay}"  -->
                    <!--  IsChecked="{CompiledBinding GlobalSettings.IsTopMost.Value}"  -->
                    <!--  ToggleType="CheckBox" />  -->

                    <NativeMenuItemSeparator />

                    <!--  Toggle subdirectories  -->
                    <NativeMenuItem
                        Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.ToggleSubdirectories}"
                        Header="{CompiledBinding Translation.SearchSubdirectory.Value,
                                                 Mode=OneWay}"
                        IsChecked="{CompiledBinding GlobalSettings.IsIncludingSubdirectories.Value}"
                        ToggleType="CheckBox" />

                    <NativeMenuItemSeparator />

                    <!--  Show keybindings  -->
                    <NativeMenuItem Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.KeybindingsWindow}" Header="{CompiledBinding Translation.ApplicationShortcuts.Value, Mode=OneWay}" />

                    <NativeMenuItemSeparator />

                    <!--  Show settings window  -->
                    <NativeMenuItem Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.SettingsWindow}" Header="{CompiledBinding Translation.ShowAllSettingsWindow.Value, Mode=OneWay}" />
                </NativeMenu>
            </NativeMenuItem>

            <!--  Help  -->
            <NativeMenuItem Header="{CompiledBinding Translation.Help.Value, Mode=OneWay}">
                <NativeMenu>

                    <!--  Show about window  -->
                    <NativeMenuItem Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.AboutWindow}" Header="{CompiledBinding Translation.About.Value, Mode=OneWay}" />

                    <!--  Check for updates  -->
                    <NativeMenuItem Command="{CompiledBinding RunActionCommand}" CommandParameter="{x:Static keybindings:Actions.CheckForUpdates}" Header="{CompiledBinding Translation.CheckForUpdates.Value, Mode=OneWay}" />
                </NativeMenu>
            </NativeMenuItem>

        </NativeMenu>
    </NativeMenu.Menu>
    <DockPanel LastChildFill="True">
        <views:MacOSTitlebar DockPanel.Dock="Top" x:Name="Titlebar" />
        <uc:BottomBar DockPanel.Dock="Bottom" x:Name="BottomBar" />
        <main:MainView x:Name="MainView" />
    </DockPanel>
</customControls:MainWindow>