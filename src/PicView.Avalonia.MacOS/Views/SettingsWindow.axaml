<Window
    CanMinimize="True"
    Height="785"
    MinWidth="600"
    Title="SettingsWindow"
    Width="985"
    x:Class="PicView.Avalonia.MacOS.Views.SettingsWindow"
    x:DataType="viewModels:CoreViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:buttons="clr-namespace:PicView.Avalonia.Views.UC.Buttons;assembly=PicView.Avalonia"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls;assembly=PicView.Avalonia"
    xmlns:main="clr-namespace:PicView.Avalonia.Views.Main;assembly=PicView.Avalonia"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        BorderBrush="{DynamicResource WindowBorderColor}"
        BorderThickness="1"
        CornerRadius="8"
        PointerPressed="MoveWindow"
        x:Name="MainBorder">
        <DockPanel>
            <DockPanel Background="{DynamicResource TitleBarBackgroundColor}" DockPanel.Dock="Top">

                <!--  Rectangle to reserve space for traffic lights buttons  -->
                <Rectangle DockPanel.Dock="Left" Width="70" />

                <customControls:IconButton
                    Background="{DynamicResource ToolWindowButtonBackground}"
                    Classes="WindowToolButtonHover"
                    Command="{CompiledBinding SettingsViewModel.GoHomeCommand}"
                    CornerRadius="4"
                    DockPanel.Dock="Left"
                    Foreground="{DynamicResource MainTextColor}"
                    HorizontalAlignment="Left"
                    Icon="{StaticResource HomeImage}"
                    IconHeight="12"
                    IconWidth="12"
                    Width="35"
                    ZIndex="1"
                    x:Name="HomeButton" />

                <customControls:IconButton
                    Background="{DynamicResource ToolWindowButtonBackground}"
                    Classes="WindowToolButtonHover"
                    Command="{CompiledBinding SettingsViewModel.GoBackCommand}"
                    Data="{StaticResource ArrowLeftGeometry}"
                    DockPanel.Dock="Left"
                    Foreground="{DynamicResource MainTextColor}"
                    Height="{StaticResource TopBorderHeight}"
                    HorizontalAlignment="Left"
                    IconHeight="12"
                    IconWidth="12"
                    Width="35"
                    ZIndex="1"
                    x:Name="GoBackButton" />

                <customControls:IconButton
                    Background="{DynamicResource ToolWindowButtonBackground}"
                    Classes="WindowToolButtonHover"
                    Command="{CompiledBinding SettingsViewModel.GoForwardCommand}"
                    Data="{StaticResource ArrowRightGeometry}"
                    DockPanel.Dock="Left"
                    Foreground="{DynamicResource MainTextColor}"
                    HorizontalAlignment="Left"
                    IconHeight="12"
                    IconWidth="12"
                    Width="35"
                    ZIndex="1"
                    x:Name="GoForwardButton" />

                <buttons:SettingsMenuButton
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    ZIndex="1"
                    x:Name="SettingsButton" />

                <TextBlock
                    Background="{DynamicResource WindowTitleBackgroundColor}"
                    Classes="txt"
                    Foreground="{DynamicResource MainTextColor}"
                    Height="{StaticResource TopBorderHeight}"
                    LineHeight="{StaticResource TopBorderHeight}"
                    Text="{CompiledBinding Translation.Settings.Value,
                                           Mode=OneWay}"
                    TextAlignment="Center"
                    x:Name="TitleText" />
            </DockPanel>

            <main:SettingsView Background="{DynamicResource WindowMainBackgroundColor}" x:Name="SettingsView" />
        </DockPanel>
    </Border>
</Window>