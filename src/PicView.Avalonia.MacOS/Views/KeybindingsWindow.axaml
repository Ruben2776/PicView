<Window
    x:Class="PicView.Avalonia.MacOS.Views.KeybindingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:main="clr-namespace:PicView.Avalonia.Views.Main;assembly=PicView.Avalonia"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    Title="Loading..."
    MinHeight="200"
    x:DataType="viewModels:CoreViewModel"
    CanResize="True"
    ExtendClientAreaTitleBarHeightHint="-1"
    ExtendClientAreaToDecorationsHint="True"
    SizeToContent="Width">

    <Border
        BorderBrush="{DynamicResource WindowBorderColor}"
        BorderThickness="1"
        CornerRadius="8"
        PointerPressed="MoveWindow">
        <Panel>

            <Panel
                x:Name="WindowBorder"
                Height="{StaticResource TopBorderHeight}"
                VerticalAlignment="Top"
                Background="{DynamicResource TitleBarBackgroundColor}">

                <TextBlock
                    Background="{DynamicResource TitleBarBackgroundColor}"
                    Classes="txt"
                    Foreground="{DynamicResource MainTextColor}"
                    Text="{CompiledBinding Translation.ApplicationShortcuts.Value,
                                           Mode=OneWay}"
                    TextAlignment="Center" />
            </Panel>

            <Border
                Margin="0,28,0,0"
                Background="{DynamicResource WindowMainBackgroundColor}"
                Focusable="True">
                <main:KeybindingsView x:Name="XKeybindingsView" Padding="0,2,0,10" />
            </Border>
        </Panel>
    </Border>
</Window>