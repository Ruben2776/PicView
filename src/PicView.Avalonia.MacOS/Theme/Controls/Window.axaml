<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme TargetType="Window" x:Key="{x:Type Window}">
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        <Setter Property="TransparencyBackgroundFallback" Value="{StaticResource SecondaryBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource MainTextColor}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border IsHitTestVisible="False" Name="PART_TransparencyFallback" />
                    <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
                    <Panel Background="Transparent" Margin="{TemplateBinding WindowDecorationMargin}" />
                    <Panel>
                        <ExperimentalAcrylicBorder IsHitTestVisible="False" Name="PART_AcrylicBorder">
                            <ExperimentalAcrylicBorder.Material>
                                <ExperimentalAcrylicMaterial
                                    BackgroundSource="Digger"
                                    MaterialOpacity="0.1"
                                    TintColor="Black"
                                    TintOpacity=".9" />
                            </ExperimentalAcrylicBorder.Material>
                        </ExperimentalAcrylicBorder>

                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                Name="PART_ContentPresenter"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!--  Set by ThemeManager.ApplyAcrylic when the blur is turned off. Tool windows get their background from it  -->
        <Style Selector="^.no-acrylic">
            <Setter Property="TransparencyLevelHint" Value="Transparent" />
        </Style>
        <Style Selector="^.no-acrylic /template/ ExperimentalAcrylicBorder#PART_AcrylicBorder">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>
</ResourceDictionary>