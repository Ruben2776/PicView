<Window
    x:Class="PicView.Avalonia.Win32.Views.EffectsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls;assembly=PicView.Avalonia"
    xmlns:main="clr-namespace:PicView.Avalonia.Views.Main;assembly=PicView.Avalonia"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    x:DataType="viewModels:CoreViewModel"
    BorderThickness="1"
    CanResize="False"
    SizeToContent="WidthAndHeight">

    <Border
        x:Name="ParentBorder"
        BorderBrush="{DynamicResource WindowBorderColor}"
        BorderThickness="1"
        PointerPressed="MoveWindow">
        <StackPanel>

            <DockPanel
                x:Name="TitleBarPanel"
                Height="28"
                Background="{DynamicResource WindowTitleBackgroundColor}"
                LastChildFill="True">

                <Border
                    x:Name="IconBorder"
                    Background="{DynamicResource WindowLogoColor}"
                    BorderBrush="{DynamicResource TitleBarButtonBorder}"
                    BorderThickness="0,0,1,0"
                    DockPanel.Dock="Left">
                    <Image
                        Width="20"
                        Height="25"
                        Margin="7,1,7,1"
                        Source="{StaticResource LogoImage}" />
                </Border>

                <customControls:IconButton
                    x:Name="CloseButton"
                    Width="30"
                    Background="{DynamicResource WindowButtonBackgroundColor}"
                    BorderThickness="0"
                    Classes="hover"
                    Click="Close"
                    ClickMode="Release"
                    Data="{StaticResource CloseGeometry}"
                    DockPanel.Dock="Right"
                    Foreground="{DynamicResource MainTextColor}"
                    IconHeight="10"
                    IconWidth="10"
                    IsRepeatEnabled="False"
                    WindowDecorationProperties.ElementRole="CloseButton" />

                <customControls:IconButton
                    x:Name="MinimizeButton"
                    Width="30"
                    Background="{DynamicResource WindowButtonBackgroundColor}"
                    BorderBrush="{DynamicResource TitleBarButtonBorder}"
                    BorderThickness="1,0,1,0"
                    Classes="hover"
                    Click="Minimize"
                    Data="{StaticResource MinimizeGeometry}"
                    DockPanel.Dock="Right"
                    Foreground="{DynamicResource MainTextColor}"
                    IconHeight="12"
                    IconWidth="12"
                    IsRepeatEnabled="False" />

                <customControls:IconButton
                    Width="30"
                    BorderBrush="{DynamicResource TitleBarButtonBorder}"
                    BorderThickness="1,0,0,0"
                    Classes="noBorderHover"
                    ClickMode="Press"
                    DockPanel.Dock="Right"
                    Foreground="{DynamicResource MainTextColor}"
                    Icon="{StaticResource GeneralSettingsImage}"
                    IconHeight="16"
                    IconWidth="16">
                    <customControls:IconButton.Flyout>
                        <MenuFlyout FlyoutPresenterClasses="noCornerRadius" Placement="Bottom">
                            <MenuItem Command="{Binding MainWindows.ActiveWindow.Value.SaveCommand}" Header="{Binding Translation.Save.Value, Mode=OneWay}">
                                <MenuItem.Icon>
                                    <Path
                                        Width="12"
                                        Height="12"
                                        Data="{StaticResource SaveGeometry}"
                                        Fill="{DynamicResource MainTextColor}"
                                        Stretch="Fill" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding MainWindows.ActiveWindow.Value.SaveAsCommand}" Header="{Binding Translation.SaveAs.Value, Mode=OneWay}">
                                <MenuItem.Icon>
                                    <Path
                                        Width="12"
                                        Height="12"
                                        Data="{StaticResource SaveGeometry}"
                                        Fill="{DynamicResource MainTextColor}"
                                        Stretch="Fill" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding MainWindows.ActiveWindow.Value.CopyImageCommand}" Header="{Binding Translation.CopyImage.Value, Mode=OneWay}">
                                <MenuItem.Icon>
                                    <Path
                                        Width="12"
                                        Height="12"
                                        Data="{StaticResource CopyGeometry}"
                                        Fill="{DynamicResource MainTextColor}"
                                        Stretch="Fill" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem
                                Command="{Binding MainWindows.ActiveWindow.Value.SetAsWallpaperFilledCommand}"
                                Header="{Binding Translation.SetAsWallpaper.Value, Mode=OneWay}"
                                IsVisible="{Binding GlobalSettings.ShowSetAsWallpaper.Value}">
                                <MenuItem.Icon>
                                    <Path
                                        Width="13"
                                        Height="10.40"
                                        Data="{StaticResource PanoramaGeometry}"
                                        Fill="{DynamicResource MainTextColor}"
                                        Stretch="Fill" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator IsVisible="{Binding GlobalSettings.ShowSetAsWallpaper.Value}" />
                            <MenuItem x:Name="ClearEffectsItem" Header="{Binding Translation.ClearEffects.Value, Mode=OneWay}">
                                <MenuItem.Icon>
                                    <Image
                                        Width="12"
                                        Height="12"
                                        Source="{StaticResource ClearImage}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </customControls:IconButton.Flyout>
                </customControls:IconButton>

                <TextBlock
                    x:Name="TitleText"
                    Height="28"
                    Padding="30,0,0,0"
                    Classes="txt"
                    Foreground="{DynamicResource MainTextColor}"
                    LineHeight="28"
                    Text="{Binding Translation.Effects.Value, Mode=OneWay}"
                    TextAlignment="Center" />
            </DockPanel>

            <Rectangle
                x:Name="BorderRectangle"
                Height="1"
                Fill="{DynamicResource WindowBorderColor}" />

            <main:EffectsView
                x:Name="EffectsView"
                Background="{DynamicResource WindowMainBackgroundColor}"
                Focusable="True" />
        </StackPanel>
    </Border>
</Window>