<Window
    BorderThickness="1"
    CanResize="False"
    SizeToContent="WidthAndHeight"
    x:Class="PicView.Avalonia.Win32.Views.EffectsWindow"
    x:DataType="viewModels:CoreViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls;assembly=PicView.Avalonia"
    xmlns:keybindings="using:PicView.Core.Keybindings"
    xmlns:main="clr-namespace:PicView.Avalonia.Views.Main;assembly=PicView.Avalonia"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Background="Transparent" PointerPressed="MoveWindow">

        <DockPanel
            Background="{DynamicResource WindowTitleBackgroundColor}"
            Height="{StaticResource TopBorderHeight}"
            LastChildFill="True"
            x:Name="TitleBarPanel">

            <Border
                Background="{DynamicResource WindowLogoColor}"
                BorderBrush="{DynamicResource TitleBarButtonBorder}"
                BorderThickness="0,0,1,0"
                DockPanel.Dock="Left"
                x:Name="IconBorder">
                <Image
                    Height="25"
                    Margin="7,1,7,1"
                    Source="{StaticResource LogoImage}"
                    Width="20" />
            </Border>

            <customControls:IconButton
                Background="{DynamicResource WindowButtonBackgroundColor}"
                BorderThickness="0"
                Classes="hover"
                Click="Close"
                ClickMode="Release"
                Data="{StaticResource CloseGeometry}"
                DockPanel.Dock="Right"
                Foreground="{DynamicResource MainTextColor}"
                IconHeight="10"
                IconWidth="10"
                IsRepeatEnabled="False"
                Width="30"
                WindowDecorationProperties.ElementRole="CloseButton"
                x:Name="CloseButton" />

            <customControls:IconButton
                Background="{DynamicResource WindowButtonBackgroundColor}"
                BorderBrush="{DynamicResource TitleBarButtonBorder}"
                BorderThickness="1,0,1,0"
                Classes="hover"
                Click="Minimize"
                Data="{StaticResource MinimizeGeometry}"
                DockPanel.Dock="Right"
                Foreground="{DynamicResource MainTextColor}"
                IconHeight="12"
                IconWidth="12"
                IsRepeatEnabled="False"
                Width="30"
                x:Name="MinimizeButton" />

            <customControls:IconButton
                Background="{DynamicResource TitleBarBackgroundColor}"
                BorderBrush="{DynamicResource TitleBarButtonBorder}"
                BorderThickness="1,0,0,0"
                Classes="hover"
                ClickMode="Press"
                DockPanel.Dock="Right"
                Foreground="{DynamicResource MainTextColor}"
                Icon="{StaticResource GeneralSettingsImage}"
                IconHeight="16"
                IconWidth="16"
                Width="30">
                <customControls:IconButton.Flyout>
                    <MenuFlyout FlyoutPresenterClasses="noCornerRadius" Placement="Bottom">
                        <customControls:StyledMenuItem
                            Command="{Binding MainWindows.ActiveWindow.Value.RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.Save}"
                            Header="{Binding Translation.Save.Value, Mode=OneWay}">
                            <MenuItem.Icon>
                                <Path
                                    Data="{StaticResource SaveGeometry}"
                                    Fill="{DynamicResource MainTextColor}"
                                    Height="12"
                                    Stretch="Fill"
                                    Width="12" />
                            </MenuItem.Icon>
                        </customControls:StyledMenuItem>
                        <customControls:StyledMenuItem
                            Command="{Binding MainWindows.ActiveWindow.Value.RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SaveAs}"
                            Header="{Binding Translation.SaveAs.Value, Mode=OneWay}">
                            <MenuItem.Icon>
                                <Path
                                    Data="{StaticResource SaveGeometry}"
                                    Fill="{DynamicResource MainTextColor}"
                                    Height="12"
                                    Stretch="Fill"
                                    Width="12" />
                            </MenuItem.Icon>
                        </customControls:StyledMenuItem>
                        <customControls:StyledMenuItem
                            Command="{Binding MainWindows.ActiveWindow.Value.RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.CopyImage}"
                            Header="{Binding Translation.CopyImage.Value, Mode=OneWay}">
                            <MenuItem.Icon>
                                <Path
                                    Data="{StaticResource CopyGeometry}"
                                    Fill="{DynamicResource MainTextColor}"
                                    Height="12"
                                    Stretch="Fill"
                                    Width="12" />
                            </MenuItem.Icon>
                        </customControls:StyledMenuItem>
                        <Separator />
                        <customControls:StyledMenuItem
                            Command="{Binding MainWindows.ActiveWindow.Value.RunActionCommand}"
                            CommandParameter="{x:Static keybindings:Actions.SetAsWallpaperFilled}"
                            Header="{Binding Translation.SetAsWallpaper.Value, Mode=OneWay}">
                            <MenuItem.Icon>
                                <Image Classes="WallpaperImage" />
                            </MenuItem.Icon>
                        </customControls:StyledMenuItem>
                        <Separator />
                        <customControls:StyledMenuItem Header="{Binding Translation.ClearEffects.Value, Mode=OneWay}" x:Name="ClearEffectsItem">
                            <MenuItem.Icon>
                                <Image
                                    Height="12"
                                    Source="{StaticResource ClearImage}"
                                    Width="12" />
                            </MenuItem.Icon>
                        </customControls:StyledMenuItem>
                    </MenuFlyout>
                </customControls:IconButton.Flyout>
            </customControls:IconButton>

            <TextBlock
                Background="{DynamicResource TitleBarBackgroundColor}"
                Classes="txt"
                Foreground="{DynamicResource MainTextColor}"
                Height="28"
                LineHeight="28"
                Padding="30,0,0,0"
                Text="{Binding Translation.Effects.Value, Mode=OneWay}"
                TextAlignment="Center"
                x:Name="TitleText" />
        </DockPanel>

        <Rectangle
            Fill="{DynamicResource WindowBorderColor}"
            Height="1"
            x:Name="BorderRectangle" />

        <main:EffectsView
            Background="{DynamicResource WindowMainBackgroundColor}"
            Focusable="True"
            x:Name="EffectsView" />
    </StackPanel>
</Window>