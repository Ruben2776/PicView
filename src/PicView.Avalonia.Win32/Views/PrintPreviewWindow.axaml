<Window
    Height="835"
    MinHeight="700"
    MinWidth="660"
    Width="975"
    x:Class="PicView.Avalonia.Win32.Views.PrintPreviewWindow"
    x:DataType="viewModels:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls;assembly=PicView.Avalonia"
    xmlns:main="clr-namespace:PicView.Avalonia.Views.Main;assembly=PicView.Avalonia"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>

        <DockPanel
            DockPanel.Dock="Top"
            Height="{StaticResource TopBorderHeight}"
            LastChildFill="True"
            PointerPressed="MoveWindow">

            <Border
                Background="{DynamicResource WindowLogoColor}"
                BorderBrush="{DynamicResource TitleBarButtonBorder}"
                BorderThickness="0,0,1,0"
                DockPanel.Dock="Left"
                x:Name="IconBorder">
                <Image
                    Height="25"
                    Margin="7,1,7,1"
                    Source="{StaticResource LogoImage}"
                    Width="20" />
            </Border>

            <customControls:IconButton
                Background="{DynamicResource WindowButtonBackgroundColor}"
                BorderThickness="0"
                Classes="hover"
                Click="Close"
                ClickMode="Release"
                Data="{StaticResource CloseGeometry}"
                DockPanel.Dock="Right"
                Foreground="{DynamicResource MainTextColor}"
                IconHeight="10"
                IconWidth="10"
                IsRepeatEnabled="False"
                Width="30"
                WindowDecorationProperties.ElementRole="CloseButton"
                x:Name="CloseButton" />

            <customControls:IconButton
                Background="{DynamicResource WindowButtonBackgroundColor}"
                BorderBrush="{DynamicResource TitleBarButtonBorder}"
                BorderThickness="1,0,1,0"
                Classes="hover"
                Click="Minimize"
                Data="{StaticResource MinimizeGeometry}"
                DockPanel.Dock="Right"
                Foreground="{DynamicResource MainTextColor}"
                IconHeight="12"
                IconWidth="12"
                IsRepeatEnabled="False"
                Width="30"
                x:Name="MinimizeButton" />

            <TextBlock
                Background="{DynamicResource WindowButtonBackgroundColor}"
                Classes="txt"
                Foreground="{DynamicResource MainTextColor}"
                Height="28"
                LineHeight="28"
                Padding="30,0,0,0"
                Text="{CompiledBinding Translation.Print.Value,
                                       Mode=OneWay}"
                TextAlignment="Center"
                x:Name="TitleText" />
        </DockPanel>

        <Rectangle
            DockPanel.Dock="Top"
            Fill="{DynamicResource TitleBarButtonBorder}"
            Height="1"
            x:Name="BorderRectangle" />

        <main:PrintPreviewView
            Background="{DynamicResource WindowMainBackgroundColor}"
            DockPanel.Dock="Bottom"
            Focusable="True"
            x:Name="PrintPreviewView" />
    </DockPanel>
</Window>