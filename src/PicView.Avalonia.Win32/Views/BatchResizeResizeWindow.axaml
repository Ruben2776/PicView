<Window
    x:Class="PicView.Avalonia.Win32.Views.BatchResizeWindow"
    x:DataType="viewModels:CoreViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls;assembly=PicView.Avalonia"
    xmlns:main="clr-namespace:PicView.Avalonia.Views.Main;assembly=PicView.Avalonia"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel
        Background="Transparent"
        LastChildFill="True"
        PointerPressed="MoveWindow"
        x:Name="ParentPanel">

        <DockPanel
            DockPanel.Dock="Top"
            Height="{StaticResource TopBorderHeight}"
            LastChildFill="True">

            <Border
                Background="{DynamicResource WindowLogoColor}"
                BorderBrush="{DynamicResource TitleBarButtonBorder}"
                BorderThickness="0,0,1,0"
                DockPanel.Dock="Left"
                x:Name="IconBorder">
                <Image
                    Height="25"
                    Margin="7,1,7,1"
                    Source="{StaticResource LogoImage}"
                    Width="20" />
            </Border>

            <customControls:IconButton
                Background="{DynamicResource WindowButtonBackgroundColor}"
                BorderThickness="0"
                Classes="hover"
                Click="Close"
                ClickMode="Release"
                Data="{StaticResource CloseGeometry}"
                DockPanel.Dock="Right"
                Foreground="{DynamicResource MainTextColor}"
                IconHeight="10"
                IconWidth="10"
                IsRepeatEnabled="False"
                Width="30"
                WindowDecorationProperties.ElementRole="CloseButton"
                x:Name="CloseButton" />

            <customControls:IconButton
                Background="{DynamicResource WindowButtonBackgroundColor}"
                BorderBrush="{DynamicResource TitleBarButtonBorder}"
                BorderThickness="1,0,1,0"
                Classes="hover"
                Click="Minimize"
                Data="{StaticResource MinimizeGeometry}"
                DockPanel.Dock="Right"
                Foreground="{DynamicResource MainTextColor}"
                IconHeight="12"
                IconWidth="12"
                IsRepeatEnabled="False"
                Width="30"
                x:Name="MinimizeButton" />

            <TextBlock
                Background="{DynamicResource TitleBarBackgroundColor}"
                Classes="txt"
                Foreground="{DynamicResource MainTextColor}"
                Height="{StaticResource TopBorderHeight}"
                LineHeight="{StaticResource TopBorderHeight}"
                Padding="2,0,2,0"
                Text="{CompiledBinding Translation.BatchResize.Value,
                                       Mode=OneWay}"
                TextAlignment="Center"
                x:Name="TitleText" />
        </DockPanel>

        <Rectangle
            DockPanel.Dock="Top"
            Fill="{DynamicResource TitleBarButtonBorder}"
            Height="1"
            x:Name="BorderRectangle" />


        <main:BatchResizeView
            Background="{DynamicResource WindowMainBackgroundColor}"
            Focusable="True"
            x:Name="ResizeView" />
    </DockPanel>
</Window>