    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>arm64;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.0" />
